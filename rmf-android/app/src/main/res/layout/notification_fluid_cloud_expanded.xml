<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fluid_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <!-- 顶部状态栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/fluid_expanded_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="ColorOS 流体云 · 深度专注中"
            android:textColor="@color/fluid_notif_tag_text"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_fluid_tag" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="心流防打扰"
            android:textColor="#10B981"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 核心专注任务标题 -->
    <TextView
        android:id="@+id/fluid_expanded_task_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="流体云实时胶囊测试"
        android:textColor="@color/fluid_notif_title"
        android:textSize="17sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- 巨幅动态 Chronometer 倒计时 -->
    <Chronometer
        android:id="@+id/fluid_expanded_chronometer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="@color/fluid_notif_chronometer"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="保持专注，外界信息已挂起"
        android:textColor="@color/fluid_notif_muted"
        android:textSize="11.5sp" />

    <!-- 底部双快捷交互按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/fluid_btn_pause"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="⏸️ 暂停专注"
            android:textColor="@color/fluid_notif_btn_secondary_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_fluid_btn_secondary" />

        <TextView
            android:id="@+id/fluid_btn_stop"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="⏹️ 结束专注"
            android:textColor="@color/fluid_notif_btn_danger_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_fluid_btn_danger" />
    </LinearLayout>

</LinearLayout>
