<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fluid_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_fluid_card"
    android:padding="14dp">

    <!-- 顶部状态栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/fluid_expanded_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="🎯 深度心流专注"
            android:textColor="@color/fluid_notif_tag_text"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:background="@drawable/bg_fluid_tag" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/fluid_expanded_state_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ 心流进行中"
            android:textColor="#10B981"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 核心专注任务标题 -->
    <TextView
        android:id="@+id/fluid_expanded_task_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="深度架构设计与核心研发"
        android:textColor="@color/fluid_notif_title"
        android:textSize="16.5sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- 巨幅动态 Chronometer 倒计时仪表盘 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@drawable/bg_fluid_timer_pill">

        <Chronometer
            android:id="@+id/fluid_expanded_chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/fluid_notif_chronometer"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fluid_expanded_subtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="保持专注 · 外界干扰已静默"
            android:textColor="@color/fluid_notif_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 底部双快捷交互按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/fluid_btn_pause"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="⏸️ 暂停专注"
            android:textColor="@color/fluid_notif_btn_secondary_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_fluid_btn_secondary" />

        <TextView
            android:id="@+id/fluid_btn_stop"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="⏹️ 结束专注"
            android:textColor="@color/fluid_notif_btn_danger_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_fluid_btn_danger" />
    </LinearLayout>

</LinearLayout>
