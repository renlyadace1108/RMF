<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fluid_course_capsule_root"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@android:color/transparent"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <!-- 课程信息区 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/fluid_course_capsule_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎓 高等数学"
            android:textColor="@color/fluid_notif_title"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/fluid_course_capsule_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 教学楼 302 | 10分钟后上课"
            android:textColor="@color/fluid_notif_sub"
            android:textSize="11.5sp"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 动态倒计时 -->
    <Chronometer
        android:id="@+id/fluid_course_capsule_chronometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/fluid_notif_chronometer"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginEnd="10dp" />

    <!-- 快捷确认/进入专注胶囊按钮 -->
    <TextView
        android:id="@+id/fluid_course_capsule_btn"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="进入专注"
        android:textColor="@color/fluid_notif_btn_primary_text"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/bg_fluid_btn_primary" />

</LinearLayout>
