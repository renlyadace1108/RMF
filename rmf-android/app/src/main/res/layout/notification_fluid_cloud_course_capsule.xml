<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fluid_course_capsule_root"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_fluid_card"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- 课程信息区 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/fluid_course_capsule_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="课程提醒"
            android:textColor="@color/fluid_notif_title"
            android:textSize="14.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/fluid_course_capsule_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="即将开课"
            android:textColor="@color/fluid_notif_sub"
            android:textSize="11.5sp"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 动态倒计时仪表盘 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:layout_marginEnd="8dp"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:background="@drawable/bg_fluid_timer_pill">

        <Chronometer
            android:id="@+id/fluid_course_capsule_chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/fluid_notif_chronometer"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 快捷确认/进入专注胶囊按钮 -->
    <TextView
        android:id="@+id/fluid_course_capsule_btn"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="进入专注"
        android:textColor="@color/fluid_notif_btn_primary_text"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/bg_fluid_btn_primary" />

</LinearLayout>
