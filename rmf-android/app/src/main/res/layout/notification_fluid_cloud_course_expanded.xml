<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fluid_course_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1E2024"
    android:padding="16dp">

    <!-- 顶部状态栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_logo"
            android:contentDescription="RMF Logo" />

        <TextView
            android:id="@+id/fluid_course_expanded_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="ColorOS 流体云 · 上课提醒"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fluid_course_expanded_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="即将上课"
            android:textColor="#10B981"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 中间课程信息与倒计时 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/fluid_course_expanded_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎓 高等数学 (AI微积分)"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/fluid_course_expanded_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="📍 地点: 一教 302 | 教师: 李教授"
            android:textColor="#38BDF8"
            android:textSize="12sp" />

        <Chronometer
            android:id="@+id/fluid_course_expanded_chronometer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#00F0FF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fluid_course_expanded_time_range"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="上课时段: 08:00 - 09:40"
            android:textColor="#94A3B8"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 底部操作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/fluid_course_btn_focus"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="🎯 一键开启听课专注"
            android:textColor="#00F0FF"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:background="#2C2E33" />

        <TextView
            android:id="@+id/fluid_course_btn_view"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="📖 查看课表详情"
            android:textColor="#F1F5F9"
            android:textSize="12.5sp"
            android:background="#2C2E33" />
    </LinearLayout>

</LinearLayout>
