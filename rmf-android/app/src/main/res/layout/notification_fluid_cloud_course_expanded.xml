<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fluid_course_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <!-- 顶部状态栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="ColorOS 流体云 · 上课提醒"
            android:textColor="@color/fluid_notif_tag_text"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_fluid_tag" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="准时到席"
            android:textColor="#10B981"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 核心课程标题 -->
    <TextView
        android:id="@+id/fluid_course_expanded_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="🎓 高等数学(AI) 示范课"
        android:textColor="@color/fluid_notif_title"
        android:textSize="17sp"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- 教师与地点信息 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/fluid_course_expanded_detail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📍 地点: 理科楼 A302  👤 教师: 张教授"
            android:textColor="@color/fluid_notif_sub"
            android:textSize="12.5sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/fluid_course_expanded_time_range"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="时长: 45分钟"
            android:textColor="@color/fluid_notif_muted"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- 动态 Chronometer 倒计时展示 -->
    <Chronometer
        android:id="@+id/fluid_course_expanded_chronometer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/fluid_notif_chronometer"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="即将开课，点击一键进入听课专注心流"
        android:textColor="@color/fluid_notif_muted"
        android:textSize="11.5sp" />

    <!-- 底部双快捷交互按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/fluid_course_btn_focus"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:gravity="center"
            android:text="🎯 一键开启听课专注"
            android:textColor="@color/fluid_notif_btn_primary_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_fluid_btn_primary" />

        <TextView
            android:id="@+id/fluid_course_btn_view"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:text="📖 查看课表详情"
            android:textColor="@color/fluid_notif_btn_secondary_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/bg_fluid_btn_secondary" />
    </LinearLayout>

</LinearLayout>
