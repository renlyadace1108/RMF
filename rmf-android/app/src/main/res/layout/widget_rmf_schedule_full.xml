<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_sched_full_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_card"
    android:padding="12dp">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📅 今日日程攻坚看板"
            android:textColor="#38BDF8"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_sched_full_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="10-16 星期五"
            android:textColor="#94A3B8"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_sched_full_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0/0 项"
            android:textColor="#34D399"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginEnd="6dp" />

        <!-- ➕ 快捷新建 -->
        <TextView
            android:id="@+id/widget_sched_full_add_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_button"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="➕"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginEnd="5dp" />

        <!-- 🔄 刷新 -->
        <TextView
            android:id="@+id/widget_sched_full_refresh_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_button"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="🔄"
            android:textColor="#94A3B8"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 任务项容器 (满幅支持多达 8 项排期) -->
    <LinearLayout
        android:id="@+id/widget_sched_full_list_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 任务 1 -->
        <LinearLayout
            android:id="@+id/widget_sched_full_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_widget_subcard"
            android:padding="6dp"
            android:layout_marginBottom="3dp">

            <TextView
                android:id="@+id/widget_sched_full_icon_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭕"
                android:textSize="11sp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/widget_sched_full_time_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09:00"
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/widget_sched_full_title_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="暂无待办日程"
                android:textColor="#F1F5F9"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- 任务 2 -->
        <LinearLayout
            android:id="@+id/widget_sched_full_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_widget_subcard"
            android:padding="6dp"
            android:layout_marginBottom="3dp">

            <TextView
                android:id="@+id/widget_sched_full_icon_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭕"
                android:textSize="11sp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/widget_sched_full_time_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#38BDF8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/widget_sched_full_title_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#F1F5F9"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- 任务 3 -->
