<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fluid_capsule_root"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#18191C"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <!-- 应用图标 -->
    <ImageView
        android:id="@+id/fluid_capsule_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_logo"
        android:contentDescription="RMF Logo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp">

        <TextView
            android:id="@+id/fluid_capsule_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎯 深度专注中"
            android:textColor="#F1F5F9"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <TextView
            android:id="@+id/fluid_capsule_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ColorOS 流体云实时监控"
            android:textColor="#94A3B8"
            android:textSize="10.5sp"
            android:maxLines="1" />
    </LinearLayout>

    <!-- 动态倒计时 -->
    <Chronometer
        android:id="@+id/fluid_capsule_chronometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#00F0FF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginEnd="12dp" />

    <!-- 快捷操作按钮 -->
    <TextView
        android:id="@+id/fluid_capsule_action_btn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:text="暂停"
        android:textColor="#00F0FF"
        android:textSize="12sp"
        android:background="#222C2E33" />

</LinearLayout>
