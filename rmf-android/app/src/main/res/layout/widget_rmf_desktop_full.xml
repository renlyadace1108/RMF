<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_full_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_card"
    android:padding="12dp">

    <!-- 顶部标题行、日期与快捷动作按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ RMF 全景中枢"
            android:textColor="#38BDF8"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_full_date_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="10-16 星期五"
            android:textColor="#94A3B8"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_full_overview_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="今日日程"
            android:textColor="#34D399"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:layout_marginEnd="6dp" />

        <!-- 快捷发起专注 -->
        <TextView
            android:id="@+id/widget_full_quick_focus_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_button"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="⏱️"
            android:textSize="12sp"
            android:layout_marginEnd="5dp" />

        <!-- 快捷新建日程 -->
        <TextView
            android:id="@+id/widget_full_quick_add_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_button"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="➕"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginEnd="5dp" />

        <!-- 刷新按钮 -->
        <TextView
            android:id="@+id/widget_full_refresh_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_widget_button"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="🔄"
            android:textColor="#94A3B8"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 0. 双列卡片：倒数日与北极星战略目标 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <!-- 倒数日卡片 -->
        <LinearLayout
            android:id="@+id/widget_full_countdown_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_widget_subcard"
            android:padding="8dp"
            android:layout_marginEnd="4dp">

            <TextView
                android:id="@+id/widget_full_countdown_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="⏳ 考研/重要里程碑"
                android:textColor="#F59E0B"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_full_countdown_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="还剩 -- 天"
                android:textColor="#FBBF24"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 北极星目标卡片 -->
        <LinearLayout
            android:id="@+id/widget_full_north_star_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_widget_subcard"
            android:padding="8dp"
            android:layout_marginStart="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⭐ 北极星目标"
                    android:textColor="#F59E0B"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_full_north_star_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#38BDF8"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_full_north_star_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="置顶目标加载中..."
                android:textColor="#F1F5F9"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 1. 今日课程透视 -->
    <LinearLayout
        android:id="@+id/widget_full_courses_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_widget_subcard"
        android:padding="8dp"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📚 今日课表透视"
            android:textColor="#67E8F9"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_full_courses_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="今日无课 / 自主攻坚日"
            android:textColor="#E2E8F0"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- 2. 今日重点日程清单 (满幅纵深展开) -->
    <LinearLayout
        android:id="@+id/widget_full_tasks_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_widget_subcard"
        android:padding="8dp"
        android:layout_marginBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📋 今日攻坚日程"
                android:textColor="#94A3B8"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_full_tasks_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/0 项"
                android:textColor="#38BDF8"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- 任务 1 -->
        <LinearLayout
            android:id="@+id/widget_full_task_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="3dp">

            <TextView
                android:id="@+id/widget_full_task_icon_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭕"
                android:textSize="10.5sp"
                android:layout_marginEnd="5dp" />

            <TextView
                android:id="@+id/widget_full_task_time_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09:00"
                android:textColor="#38BDF8"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/widget_full_task_title_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="暂无待办日程"
                android:textColor="#F1F5F9"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- 任务 2 -->
        <LinearLayout
            android:id="@+id/widget_full_task_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="3dp">

            <TextView
                android:id="@+id/widget_full_task_icon_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭕"
                android:textSize="10.5sp"
                android:layout_marginEnd="5dp" />

            <TextView
                android:id="@+id/widget_full_task_time_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#38BDF8"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/widget_full_task_title_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#E2E8F0"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- 任务 3 -->
        <LinearLayout
            android:id="@+id/widget_full_task_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="3dp">

            <TextView
                android:id="@+id/widget_full_task_icon_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭕"
                android:textSize="10.5sp"
                android:layout_marginEnd="5dp" />

            <TextView
                android:id="@+id/widget_full_task_time_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#38BDF8"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/widget_full_task_title_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#CBD5E1"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- 任务 4 -->
        <LinearLayout
            android:id="@+id/widget_full_task_row_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="3dp">

            <TextView
                android:id="@+id/widget_full_task_icon_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭕"
                android:textSize="10.5sp"
                android:layout_marginEnd="5dp" />

            <TextView
                android:id="@+id/widget_full_task_time_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#38BDF8"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/widget_full_task_title_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#94A3B8"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- 任务 5 -->
        <LinearLayout
            android:id="@+id/widget_full_task_row_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_full_task_icon_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭕"
                android:textSize="10.5sp"
                android:layout_marginEnd="5dp" />

            <TextView
                android:id="@+id/widget_full_task_time_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#38BDF8"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/widget_full_task_title_5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text=""
                android:textColor="#94A3B8"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 3. 底部快捷操作条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_full_bottom_focus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_button"
            android:gravity="center"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="⏱️ 深度专注"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/widget_full_bottom_capture"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_button"
            android:gravity="center"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="➕ 闪念速记"
            android:textColor="#34D399"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/widget_full_bottom_calendar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_button"
            android:gravity="center"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="📅 全局日程"
            android:textColor="#F59E0B"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
