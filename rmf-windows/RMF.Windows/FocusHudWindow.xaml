<Window x:Class="RMF.Windows.FocusHudWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RMF 专注胶囊"
        Width="460"
        SizeToContent="Height"
        MaxHeight="500"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <Style x:Key="HudButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <!-- 外部阴影容器 -->
        <Border Background="#1C1D21" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="18" Padding="12,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.55"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 胶囊主栏 -->
                    <RowDefinition Height="*"/>    <!-- 展开详情面板 (DoD/打断) -->
                </Grid.RowDefinitions>

                <!-- Row 0: 核心胶囊横条 (支持拖拽移动) -->
                <Grid x:Name="CapsuleBar" Grid.Row="0" MouseLeftButtonDown="OnCapsuleBarMouseDown" Background="Transparent" Cursor="SizeAll">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- 状态呼吸圆点 -->
                        <ColumnDefinition Width="*"/>    <!-- 任务标题与计时 -->
                        <ColumnDefinition Width="Auto"/> <!-- 操作按钮区 -->
                    </Grid.ColumnDefinitions>

                    <!-- 状态指示点 -->
                    <Ellipse x:Name="StatusDot" Grid.Column="0" Width="10" Height="10" Fill="#10B981" Margin="2,0,10,0" VerticalAlignment="Center"/>

                    <!-- 任务标题与时间 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TaskTitleText" Text="专注任务" FontSize="13" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="TimerText" Text="25:00" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" FontFamily="Consolas, Segoe UI"/>
                            <TextBlock x:Name="ModeBadgeText" Text="深度专注" FontSize="10" Foreground="#94A3B8" Background="#26334D" Padding="4,1" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 控制按钮组 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 暂停/继续 -->
                        <Button x:Name="PlayPauseButton" Style="{StaticResource HudButton}" ToolTip="暂停/恢复计时" Click="OnPlayPauseClicked">
                            <TextBlock x:Name="PlayPauseIcon" Text="⏸" FontSize="13" Foreground="#F1F5F9"/>
                        </Button>

                        <!-- 一键打断埋点 -->
                        <Button Style="{StaticResource HudButton}" ToolTip="记录打断 (外部/插单/走神)" Click="OnToggleInterruptionPanelClicked">
                            <TextBlock Text="⚡" FontSize="13" Foreground="#F59E0B"/>
                        </Button>

                        <!-- DoD 清单展开 -->
                        <Button Style="{StaticResource HudButton}" ToolTip="查看与勾选 DoD 验收标准" Click="OnToggleDodPanelClicked">
                            <TextBlock Text="📋" FontSize="13" Foreground="#60A5FA"/>
                        </Button>

                        <!-- 番茄钟 / 秒表 双轨切换 -->
                        <Button x:Name="TimerModeButton" Style="{StaticResource HudButton}" ToolTip="切换计时模式 (番茄钟 25m / 正向秒表)" Click="OnToggleTimerModeClicked">
                            <TextBlock x:Name="TimerModeIcon" Text="⏱" FontSize="13" Foreground="#A78BFA"/>
                        </Button>

                        <!-- 鼠标穿透锁定 -->
                        <Button x:Name="LockPassThroughButton" Style="{StaticResource HudButton}" ToolTip="鼠标穿透锁定 (Ctrl+Shift+L 解锁)" Click="OnTogglePassThroughClicked">
                            <TextBlock x:Name="LockIcon" Text="🔓" FontSize="13" Foreground="#CBD5E1"/>
                        </Button>

                        <!-- 标为完成 -->
                        <Button Style="{StaticResource HudButton}" ToolTip="完成任务并反哺学时与目标" Click="OnFinishTaskClicked">
                            <TextBlock Text="✔" FontSize="13" Foreground="#10B981"/>
                        </Button>

                        <!-- 关闭/退出 HUD -->
                        <Button Style="{StaticResource HudButton}" ToolTip="退出专注模式" Click="OnCloseHudClicked">
                            <TextBlock Text="✕" FontSize="12" Foreground="#94A3B8"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Row 1: 展开区 (DoD 清单面板 & 打断快速记录面板) -->
                <Grid Grid.Row="1" Margin="0,8,0,0">
                    <!-- 1. DoD 清单面板 -->
                    <Border x:Name="DodPanel" Background="#141518" CornerRadius="10" Padding="10" Visibility="Collapsed" BorderBrush="#2D3748" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="DoD 验收标准原位质检" FontSize="11" FontWeight="Bold" Foreground="#94A3B8"/>
                                <TextBlock x:Name="DodProgressText" Text="0/0 (0%)" FontSize="11" Foreground="#38BDF8" Margin="8,0,0,0"/>
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" MaxHeight="160">
                                <StackPanel x:Name="DodItemsList"/>
                            </ScrollViewer>

                            <!-- 快速添加 DoD 项 -->
                            <Grid Grid.Row="2" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="NewDodInput" Background="#1E2024" Foreground="#F1F5F9" BorderBrush="#3B82F6" BorderThickness="1" Padding="6,4" FontSize="11" KeyDown="OnNewDodInputKeyDown"/>
                                <Button Grid.Column="1" Style="{StaticResource HudButton}" Content="添加" Margin="4,0,0,0" Padding="8,4" FontSize="11" Click="OnAddDodItemClicked"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 2. 打断秒记面板 -->
                    <Border x:Name="InterruptionPanel" Background="#18181B" CornerRadius="10" Padding="10" Visibility="Collapsed" BorderBrush="#F59E0B" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="⚡ 一键打断埋点" FontSize="12" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,6"/>
                            <TextBlock Text="记录打断将暂停专注计时，并沉淀真实损耗数据：" FontSize="10.5" Foreground="#94A3B8" Margin="0,0,0,8"/>

                            <UniformGrid Columns="3" Margin="0,0,0,8">
                                <Button Content="👥 外部协作" Background="#27272A" Foreground="#E2E8F0" Padding="6,8" Margin="2" Click="OnLogInterruptionTypeClicked" Tag="EXTERNAL"/>
                                <Button Content="🚨 紧急插单" Background="#27272A" Foreground="#E2E8F0" Padding="6,8" Margin="2" Click="OnLogInterruptionTypeClicked" Tag="URGENT_INSERT"/>
                                <Button Content="💭 内部走神" Background="#27272A" Foreground="#E2E8F0" Padding="6,8" Margin="2" Click="OnLogInterruptionTypeClicked" Tag="DISTRACTION"/>
                            </UniformGrid>

                            <TextBox x:Name="InterruptionNoteInput" Background="#27272A" Foreground="#F1F5F9" BorderThickness="1" BorderBrush="#3F3F46" Padding="6,4" FontSize="11" Margin="0,0,0,6"/>
                            <Button Content="提交打断记录" Background="#D97706" Foreground="White" Padding="8,4" FontWeight="SemiBold" FontSize="11" Click="OnConfirmInterruptionClicked"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
