                            <TextBlock Text="📋 验收标准 (DoD)：" FontSize="11" FontWeight="Bold" Foreground="#C084FC" Margin="0,0,0,4" />
                            <TextBlock x:Name="QuickDetailDodText" Text="完成相关代码编写与自测" FontSize="12" Foreground="#E9D5FF" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Description / Notes (if any) -->
                    <Border x:Name="QuickDetailDescBorder" Background="{DynamicResource ControlBackground}" CornerRadius="6" Padding="10,8" Margin="0,0,0,12" Visibility="Collapsed">
                        <TextBlock x:Name="QuickDetailDescText" Text="详细描述内容..." FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                    </Border>

                    <!-- Actual Time & Status Metrics -->
                    <Grid Background="{DynamicResource ControlBackground}" Margin="0,0,0,4">
                        <Border CornerRadius="6" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="当前状态" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock x:Name="QuickDetailStatusText" Text="待进行" FontSize="12" FontWeight="SemiBold" Foreground="#8AB4F8" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="实际耗时" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock x:Name="QuickDetailActualText" Text="0 分钟" FontSize="12" FontWeight="SemiBold" Foreground="#34D399" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="打断损耗" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock x:Name="QuickDetailInterruptText" Text="0 分钟" FontSize="12" FontWeight="SemiBold" Foreground="#F87171" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Button x:Name="QuickDetailGoToFitnessBtn" Content="🏋️ 直达健身模块查看与打卡" Background="#581C87" Foreground="#E9D5FF" BorderBrush="#A855F7" BorderThickness="1" Padding="10,6" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Margin="0,10,0,0" ToolTip="直接跳转至健身页面进行动作与组数记录" Visibility="Collapsed" Click="OnQuickDetailGoToFitnessClicked" />

                    <Button Content="🎯 开启专注" Background="#1E3A8A" Foreground="#93C5FD" BorderBrush="#3B82F6" BorderThickness="1" Padding="10,6" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Margin="0,10,0,0" ToolTip="进入常驻桌面置顶悬浮胶囊专注模式" Click="OnQuickDetailStartFocusHudClicked" />

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="QuickDetailTentativeConfirmBtn" Content="👻 转为正式日程" Background="#065F46" Foreground="#34D399" BorderThickness="0" Padding="8,5" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,6,0" Visibility="Collapsed" Click="OnQuickDetailConfirmTentativeClicked" />
                        <Button x:Name="QuickDetailLockToggleBtn" Content="🔒 锁定日程" Background="{DynamicResource ControlBackground}" Foreground="{DynamicResource TextPrimary}" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Padding="8,5" FontSize="11" Cursor="Hand" Click="OnQuickDetailToggleLockClicked" />
