                                        </StackPanel>
                                    </Button>
                                    <Button Tag="#4B5563" Click="OnRgbPresetSwatchClicked" Style="{StaticResource GoogleOutlineBtnStyle}" Margin="0,0,6,6" Padding="6,3" ToolTip="石墨灰 (#4B5563)">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="12" Height="12" CornerRadius="6" Background="#4B5563" Margin="0,0,4,0" />
                                            <TextBlock Text="石墨灰" FontSize="10.5" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Footer -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="取消" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="16,6" FontSize="12" Margin="0,0,10,0" Click="OnCloseRgbColorPickerClicked" />
                            <Button Content="应用此主题色" Style="{StaticResource GoogleActionBtnStyle}" Padding="20,6" FontSize="12" FontWeight="SemiBold" Click="OnApplyRgbColorPickerClicked" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
