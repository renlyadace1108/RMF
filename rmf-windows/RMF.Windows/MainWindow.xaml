                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="RgbModalPreviewTime" Text="17:15 - 19:45" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0" />
