                            <TextBox x:Name="StudyTopicCustomUnitInput" Text="题" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,6" FontSize="12" ToolTip="例如：题、词、章、套、次" TextChanged="OnStudyTopicCustomUnitChanged" />
