        <!-- ================= MODAL 11: 标签管理弹窗 (TAG MANAGEMENT MODAL) ================= -->
        <Grid x:Name="TagManagementModal" Visibility="Collapsed" Background="#88000000" Grid.RowSpan="2" Panel.ZIndex="1150">
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Width="480" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- 0: Header -->
                        <RowDefinition Height="Auto" />
                        <!-- 1: Body (Add Tag Card + Tags List) -->
                        <RowDefinition Height="*" />
                        <!-- 2: Footer -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="🏷️ 日程分类标签管理" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="自定义与维护标签库。日程创建时只能在此库中选取，保持标签规范统一。" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource GoogleModalCloseBtnStyle}" VerticalAlignment="Center" ToolTip="关闭 (Esc)" Click="OnCloseTagManagementClicked" />
                    </Grid>

                    <!-- Row 1: Content -->
                    <ScrollViewer Grid.Row="1" MaxHeight="440" VerticalScrollBarVisibility="Hidden" Padding="0,0,6,0">
                        <StackPanel>
                            <!-- Card A: 新增标签 -->
                            <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="➕ 添加新分类标签" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="NewTagNameInput" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="10,6" FontSize="12" VerticalAlignment="Center" ToolTip="输入新标签名称，如 读书、复习、健身..." />
                                        <Button Grid.Column="2" Content="+ 添加标签" Style="{StaticResource GoogleActionBtnStyle}" Padding="14,6" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Click="OnAddNewTagClicked" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="选择颜色: " FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox x:Name="NewTagColorCombo" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" Padding="6,2" FontSize="11" SelectedIndex="0">
                                            <ComboBoxItem Content="🔵 默认蓝 (#1A73E8)" Tag="#1A73E8" />
                                            <ComboBoxItem Content="🟢 翡翠绿 (#059669)" Tag="#059669" />
                                            <ComboBoxItem Content="🟣 薰衣紫 (#7C3AED)" Tag="#7C3AED" />
                                            <ComboBoxItem Content="🟠 琥珀橙 (#D97706)" Tag="#D97706" />
                                            <ComboBoxItem Content="🔴 玫瑰红 (#DC2626)" Tag="#DC2626" />
                                            <ComboBoxItem Content="🩵 青碧色 (#0891B2)" Tag="#0891B2" />
                                            <ComboBoxItem Content="🌸 樱花粉 (#EC4899)" Tag="#EC4899" />
                                            <ComboBoxItem Content="🔘 炭石灰 (#4B5563)" Tag="#4B5563" />
                                        </ComboBox>
                                        <Button Content="🎨 RGB 调色盘" Style="{StaticResource GoogleTopBtnStyle}" Padding="8,3" FontSize="11" Margin="8,0,0,0" ToolTip="打开 RGB 调色盘实时自选颜色" Click="OnOpenNewTagRgbPickerClicked" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Card B: 现有标签列表 -->
                            <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="📋 已有标签库" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TagCountSummaryText" Grid.Column="1" Text="共 6 个标签" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                    </Grid>
                                    <StackPanel x:Name="TagItemsListPanel" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Row 2: Footer -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="完成" Style="{StaticResource GoogleActionBtnStyle}" Padding="22,6" FontSize="12" FontWeight="SemiBold" Click="OnCloseTagManagementClicked" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= MODAL 12: RGB 自定义调色盘弹窗 (RGB COLOR PICKER MODAL) ================= -->
        <Grid x:Name="RgbColorPickerModal" Visibility="Collapsed" Background="#88000000" Grid.RowSpan="2" Panel.ZIndex="1200">
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Width="470" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,20">
