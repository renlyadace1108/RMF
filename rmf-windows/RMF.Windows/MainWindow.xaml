        <!-- ================= MODAL: COURSE EDIT / CREATE (WAKEUP STYLE) ================= -->
        <Grid x:Name="CourseModal" Visibility="Collapsed" Background="#66000000" Grid.RowSpan="2" Panel.ZIndex="1000">
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="CourseModalTitleText" Text="🎓 课程详情与编辑" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource GoogleModalCloseBtnStyle}" HorizontalAlignment="Right" Click="OnCloseCourseModalClicked" ToolTip="关闭 (Esc)" />
                    </Grid>

                    <!-- Course Name -->
                    <TextBlock Text="课程名称：" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                    <TextBox x:Name="CourseNameInput" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,6" FontSize="13" Margin="0,0,0,10" />

                    <!-- Teacher & Location -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="教室 / 上课地点：" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                            <TextBox x:Name="CourseLocationInput" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,6" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="任课教师：" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                            <TextBox x:Name="CourseTeacherInput" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,6" FontSize="12" />
                        </StackPanel>
                    </Grid>

                    <!-- Day of Week & Section Span -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="上课星期：" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                            <ComboBox x:Name="CourseDayCombo" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" Padding="8,6" FontSize="12">
                                <ComboBoxItem Content="周一" Tag="1" IsSelected="True" />
                                <ComboBoxItem Content="周二" Tag="2" />
                                <ComboBoxItem Content="周三" Tag="3" />
                                <ComboBoxItem Content="周四" Tag="4" />
                                <ComboBoxItem Content="周五" Tag="5" />
                                <ComboBoxItem Content="周六" Tag="6" />
                                <ComboBoxItem Content="周日" Tag="7" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="起始节次：" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                            <ComboBox x:Name="CourseStartSectionCombo" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" Padding="8,6" FontSize="12">
                                <ComboBoxItem Content="第 1 节" Tag="1" IsSelected="True" />
                                <ComboBoxItem Content="第 2 节" Tag="2" />
                                <ComboBoxItem Content="第 3 节" Tag="3" />
                                <ComboBoxItem Content="第 4 节" Tag="4" />
                                <ComboBoxItem Content="第 5 节" Tag="5" />
                                <ComboBoxItem Content="第 6 节" Tag="6" />
                                <ComboBoxItem Content="第 7 节" Tag="7" />
                                <ComboBoxItem Content="第 8 节" Tag="8" />
                                <ComboBoxItem Content="第 9 节" Tag="9" />
                                <ComboBoxItem Content="第 10 节" Tag="10" />
                                <ComboBoxItem Content="第 11 节" Tag="11" />
                                <ComboBoxItem Content="第 12 节" Tag="12" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="连堂节数：" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                            <ComboBox x:Name="CourseSpanSectionCombo" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" Padding="8,6" FontSize="12">
                                <ComboBoxItem Content="1 节" Tag="1" />
                                <ComboBoxItem Content="2 节连堂" Tag="2" IsSelected="True" />
                                <ComboBoxItem Content="3 节连堂" Tag="3" />
                                <ComboBoxItem Content="4 节连堂" Tag="4" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Custom Exact Time Controls for Regular Course -->
                    <StackPanel Margin="0,0,0,10">
                        <CheckBox x:Name="CourseCustomTimeCheck" Content="⏱️ 自定义具体起止时间" Foreground="{DynamicResource TextPrimary}" FontSize="11" Margin="0,0,0,6" Checked="OnCourseCustomTimeCheckChanged" Unchecked="OnCourseCustomTimeCheckChanged" />
                        <Grid x:Name="CourseCustomTimePanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="开始时间 (HH:mm)：" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2" />
                                <TextBox x:Name="CourseCustomStartTimeInput" Text="15:30" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,5" FontSize="11" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="结束时间 (HH:mm)：" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2" />
                                <TextBox x:Name="CourseCustomEndTimeInput" Text="17:15" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,5" FontSize="11" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Weeks Range & Week Type -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="起始周：" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                            <ComboBox x:Name="CourseStartWeekCombo" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" Padding="8,6" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="结束周：" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                            <ComboBox x:Name="CourseEndWeekCombo" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" Padding="8,6" FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="单双周循环：" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                            <ComboBox x:Name="CourseWeekTypeCombo" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" Padding="8,6" FontSize="12">
                                <ComboBoxItem Content="每周上课" Tag="ALL" IsSelected="True" />
                                <ComboBoxItem Content="仅单周" Tag="ODD" />
                                <ComboBoxItem Content="仅双周" Tag="EVEN" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Color Picker -->
                    <TextBlock Text="卡片配色：" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
                    <WrapPanel x:Name="CourseColorPickerPanel" Orientation="Horizontal" Margin="0,0,0,12">
                        <!-- Dynamic color palette buttons generated in CS -->
                    </WrapPanel>

                    <!-- Notes -->
                    <TextBlock Text="备注 / 考勤或学分说明：" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                    <TextBox x:Name="CourseNotesInput" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,6" FontSize="12" Height="48" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <!-- Buttons -->
                    <Grid>
                        <Button x:Name="CourseDeleteBtn" Content="🗑️ 删除课程" Background="Transparent" Foreground="#EF4444" BorderThickness="0" Padding="8,4" FontSize="12" Cursor="Hand" HorizontalAlignment="Left" Click="OnDeleteCourseClicked" />
                        <Button x:Name="CourseQuickAdjustBtn" Content="🔀 调/改此天时间" Background="Transparent" Foreground="#F59E0B" BorderThickness="0" Padding="8,4" FontSize="12" Cursor="Hand" HorizontalAlignment="Left" Margin="96,0,0,0" Click="OnCourseQuickAdjustClicked" Visibility="Collapsed" ToolTip="针对特定周次或某天更改上课时间，不拘泥于固定节次，不影响其他周" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="取消" Background="Transparent" Foreground="{DynamicResource TextSecondary}" BorderThickness="0" Padding="14,6" FontSize="12" Cursor="Hand" Margin="0,0,8,0" Click="OnCloseCourseModalClicked" />
                            <Button Content="保存课程" Style="{StaticResource GoogleActionBtnStyle}" Padding="18,6" FontSize="12" FontWeight="SemiBold" Click="OnSaveCourseClicked" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= MODAL: TIMETABLE SETTINGS (WAKEUP STYLE: SEMESTER, TIMING, CLASS LENGTH) ================= -->
        <Grid x:Name="TimetableSettingsModal" Visibility="Collapsed" Background="#66000000" Grid.RowSpan="2" Panel.ZIndex="1000">
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Width="560" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="⚙ 课表与作息时间设置" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="自定义学期周数、第一周第一天、课堂时长与每节课作息时间表" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource GoogleModalCloseBtnStyle}" HorizontalAlignment="Right" Click="OnCloseTimetableSettingsClicked" ToolTip="关闭 (Esc)" />
                    </Grid>

                    <!-- Tab Switcher -->
                    <Border Grid.Row="1" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="8,6" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="TimetableTabSemesterBtn" Content="📅 学期与周数" Style="{StaticResource GoogleTopBtnStyle}" Background="#1A73E8" Foreground="#FFFFFF" Padding="12,5" FontSize="12" FontWeight="SemiBold" Click="OnTimetableTabSemesterClicked" Margin="0,0,8,0" />
                            <Button x:Name="TimetableTabTimingBtn" Content="⏰ 作息时间与课堂长度" Style="{StaticResource GoogleTopBtnStyle}" Background="Transparent" Foreground="{DynamicResource TextSecondary}" Padding="12,5" FontSize="12" FontWeight="Normal" Click="OnTimetableTabTimingClicked" />
                        </StackPanel>
                    </Border>

                    <!-- Content Panels -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden" MaxHeight="430">
                        <StackPanel>
                            <!-- Tab 1: 学期与周数自定义 -->
                            <StackPanel x:Name="TimetableTabSemesterPanel" Visibility="Visible">
                                <!-- Semester Name -->
                                <TextBlock Text="学期名称：" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                <TextBox x:Name="TimetableSemesterNameInput" Text="2026年秋季学期" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,6" FontSize="13" Margin="0,0,0,12" />

                                <!-- Start Date (First Monday of Semester) -->
                                <TextBlock Text="学期第 1 周周一日期 (第一天，用于精准计算当前周)：" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TimetableStartDateInput" Text="2026-09-07" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,6" FontSize="12" ToolTip="格式：YYYY-MM-DD" VerticalContentAlignment="Center" />
                                    <DatePicker Grid.Column="2" x:Name="TimetableStartDatePicker" Width="130" SelectedDateChanged="OnTimetableStartDatePickerChanged" />
                                </Grid>
                                <TextBlock Text="💡 提示：无论选择当周哪一天，系统均会自动校准为当周周一作为学期基准首日" FontSize="10" Foreground="#8AB4F8" Margin="0,0,0,12" />

                                <!-- Total Weeks & Total Sections -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="每学期总周数 (自由设定 1~35 周)：" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                        <TextBox x:Name="TimetableTotalWeeksInput" Text="20" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,6" FontSize="12" ToolTip="输入学期总周数 (如 18、20、24 等)" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="每天总节数：" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                        <ComboBox x:Name="TimetableTotalSectionsCombo" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" Padding="8,6" FontSize="12">
                                            <ComboBoxItem Content="8 节 (上下午各4节)" Tag="8" />
                                            <ComboBoxItem Content="10 节 (含晚自习2节)" Tag="10" />
                                            <ComboBoxItem Content="12 节 (标准大学作息)" Tag="12" IsSelected="True" />
                                            <ComboBoxItem Content="14 节 (含晚自习4节)" Tag="14" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <!-- Weekend Checkbox -->
                                <CheckBox x:Name="TimetableShowWeekendCheck" Content="显示周末 (周六与周日)" IsChecked="True" Foreground="{DynamicResource TextPrimary}" FontSize="12" Margin="0,0,0,14" />

                                <!-- Quick Demo Schedule Seed Button -->
                                <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="💡 示范课表" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" />
                                            <TextBlock Text="快速载入经典高校示范课表体验 WakeUp 效果" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="+ 载入示范课表" Background="#0284C7" Foreground="#FFFFFF" BorderThickness="0" Padding="10,4" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Click="OnLoadDemoCoursesClicked" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Tab 2: 课程时间、课堂长度与各节次作息时间自定义 -->
                            <StackPanel x:Name="TimetableTabTimingPanel" Visibility="Collapsed">
                                <!-- Quick Template Generator -->
                                <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="⚡ 课堂长度与作息规则一键生成" FontSize="11.5" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,8" />
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="课堂长度 (分钟)：" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2" />
                                                <TextBox x:Name="TimetableClassDurationInput" Text="45" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="6,4" FontSize="11" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="课间休息 (分钟)：" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2" />
                                                <TextBox x:Name="TimetableBreakDurationInput" Text="10" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="6,4" FontSize="11" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="上午首节开始：" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2" />
                                                <TextBox x:Name="TimetableMorningStartTimeInput" Text="08:00" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="6,4" FontSize="11" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="下午首节 (第5节)：" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2" />
                                                <TextBox x:Name="TimetableAfternoonStartTimeInput" Text="14:00" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="6,4" FontSize="11" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="晚自习首节 (第9节)：" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2" />
                                                <TextBox x:Name="TimetableEveningStartTimeInput" Text="18:30" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="6,4" FontSize="11" />
                                            </StackPanel>
                                            <Button Grid.Column="4" Content="⚡ 生成全部节次" Style="{StaticResource GoogleActionBtnStyle}" Padding="10,4" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Bottom" Click="OnAutoGenerateScheduleTimesClicked" ToolTip="根据以上时长与节点自动重算所有节次起止时间" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Individual Section Timing List -->
                                <TextBlock Text="📝 各节次起止时间详情 (支持单节任意手动微调)：" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
                                <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                                    <ScrollViewer VerticalScrollBarVisibility="Hidden" MaxHeight="210">
                                        <StackPanel x:Name="TimetableSectionsListPanel">
                                            <!-- Dynamically generated rows for each section's start & end time -->
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Buttons -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="取消" Background="Transparent" Foreground="{DynamicResource TextSecondary}" BorderThickness="0" Padding="14,6" FontSize="12" Cursor="Hand" Margin="0,0,8,0" Click="OnCloseTimetableSettingsClicked" />
                        <Button Content="保存设置" Style="{StaticResource GoogleActionBtnStyle}" Padding="18,6" FontSize="12" FontWeight="SemiBold" Click="OnSaveTimetableSettingsClicked" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= MODAL: COURSE ADJUSTMENTS / EXCEPTIONS (调课、停课与临时补课) ================= -->
        <Grid x:Name="CourseAdjustmentModal" Visibility="Collapsed" Background="#66000000" Grid.RowSpan="2" Panel.ZIndex="1001">
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Width="580" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="🔀 调课、停课与临时补课管理" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="针对指定周次配置停课标记、换时间调课或额外临时加课" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource GoogleModalCloseBtnStyle}" HorizontalAlignment="Right" Click="OnCloseAdjustmentModalClicked" ToolTip="关闭 (Esc)" />
                    </Grid>

                    <!-- Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" MaxHeight="450">
                        <StackPanel>
                            <!-- Card 1: 添加新的调停课规则 -->
                            <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="➕ 添加调停课规则" FontSize="12.5" FontWeight="SemiBold" Foreground="#8AB4F8" Margin="0,0,0,10" />

                                    <!-- Type & Target Week -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="调整类型：" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                            <ComboBox x:Name="AdjTypeCombo" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" Padding="8,6" FontSize="12" SelectionChanged="OnAdjTypeChanged">
                                                <ComboBoxItem Content="⏸️ 停课 (本周暂停上课)" Tag="SUSPEND" />
                                                <ComboBoxItem Content="🔀 调课 (改期/更改时间教室)" Tag="RESCHEDULE" />
                                                <ComboBoxItem Content="➕ 临时补课/加课" Tag="MAKEUP" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="生效周数：" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                            <ComboBox x:Name="AdjWeekCombo" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" Padding="8,6" FontSize="12" SelectionChanged="OnAdjWeekOrDayChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Target Specific Day Preview Banner -->
                                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📅 目标对应公历日期：" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                                <TextBlock x:Name="AdjTargetDateText" Text="2026年09月07日 (第1周 周一)" FontSize="11.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="6,0,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="特定天生效" FontSize="10" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <!-- Course Selection -->
                                    <TextBlock x:Name="AdjCourseSelectLabel" Text="选择关联课程：" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                    <ComboBox x:Name="AdjCourseCombo" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" Padding="8,6" FontSize="12" Margin="0,0,0,10" SelectionChanged="OnAdjCourseChanged" />
                                    <TextBox x:Name="AdjCustomCourseNameInput" Text="" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,6" FontSize="12" Margin="0,0,0,10" Visibility="Collapsed" ToolTip="临时加课的课程名称" />

                                    <!-- Reschedule / Makeup Target Slot Panel -->
                                    <StackPanel x:Name="AdjNewTimePanel" Visibility="Collapsed" Margin="0,0,0,10">
                                        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,10">
                                            <StackPanel>
                                                <TextBlock Text="🎯 调整后的目标上课时间与地点：" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,8" />

                                                <!-- Target Day Selection -->
                                                <StackPanel Margin="0,0,0,8">
                                                    <TextBlock Text="目标星期：" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2" />
                                                    <ComboBox x:Name="AdjNewDayCombo" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" Padding="6,4" FontSize="11" SelectionChanged="OnAdjWeekOrDayChanged">
                                                        <ComboBoxItem Content="周一" Tag="1" IsSelected="True" />
                                                        <ComboBoxItem Content="周二" Tag="2" />
                                                        <ComboBoxItem Content="周三" Tag="3" />
                                                        <ComboBoxItem Content="周四" Tag="4" />
                                                        <ComboBoxItem Content="周五" Tag="5" />
                                                        <ComboBoxItem Content="周六" Tag="6" />
                                                        <ComboBoxItem Content="周日" Tag="7" />
                                                    </ComboBox>
                                                </StackPanel>

                                                <!-- Time Mode Selector: Custom Free Time vs Fixed Standard Sections -->
                                                <TextBlock Text="时间模式选择：" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,0,4,4" />
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <RadioButton x:Name="AdjModeCustomTimeRadio" Content="⏱️ 自由指定具体时间 (如 15:30 - 17:15)" GroupName="AdjTimeModeGroup" IsChecked="True" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11" Checked="OnAdjTimeModeChanged" Margin="0,0,14,0" />
                                                    <RadioButton x:Name="AdjModeStandardSectionRadio" Content="🔔 按学校固定节次" GroupName="AdjTimeModeGroup" Foreground="{DynamicResource TextSecondary}" FontSize="11" Checked="OnAdjTimeModeChanged" />
                                                </StackPanel>

                                                <!-- Mode 1: Custom Free Start & End Time -->
                                                <StackPanel x:Name="AdjCustomTimeInputsPanel" Margin="0,0,0,8">
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                             <ColumnDefinition Width="*" />
                                                             <ColumnDefinition Width="8" />
                                                             <ColumnDefinition Width="*" />
                                                             <ColumnDefinition Width="8" />
                                                             <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock Text="开始时间 (HH:mm)：" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2" />
                                                            <TextBox x:Name="AdjCustomStartTimeInput" Text="15:30" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="6,4" FontSize="11" TextChanged="OnAdjCustomTimeInputChanged" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="结束时间 (HH:mm)：" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2" />
                                                            <TextBox x:Name="AdjCustomEndTimeInput" Text="17:15" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="6,4" FontSize="11" TextChanged="OnAdjCustomTimeInputChanged" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                                                            <TextBlock x:Name="AdjCustomDurationTip" Text="时长: 105分钟" FontSize="10.5" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,0,0,5" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <!-- Quick Presets -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="常用时段: " FontSize="10" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                        <Button Content="08:30-10:00" Style="{StaticResource GoogleTopBtnStyle}" Padding="6,2" FontSize="10" Foreground="{DynamicResource TextSecondary}" Click="OnAdjQuickPresetTimeClicked" Tag="08:30|10:00" Margin="0,0,4,0" />
                                                        <Button Content="10:15-11:45" Style="{StaticResource GoogleTopBtnStyle}" Padding="6,2" FontSize="10" Foreground="{DynamicResource TextSecondary}" Click="OnAdjQuickPresetTimeClicked" Tag="10:15|11:45" Margin="0,0,4,0" />
                                                        <Button Content="14:00-15:35" Style="{StaticResource GoogleTopBtnStyle}" Padding="6,2" FontSize="10" Foreground="{DynamicResource TextSecondary}" Click="OnAdjQuickPresetTimeClicked" Tag="14:00|15:35" Margin="0,0,4,0" />
                                                        <Button Content="15:30-17:15" Style="{StaticResource GoogleTopBtnStyle}" Padding="6,2" FontSize="10" Foreground="{DynamicResource TextSecondary}" Click="OnAdjQuickPresetTimeClicked" Tag="15:30|17:15" Margin="0,0,4,0" />
                                                        <Button Content="19:00-21:00" Style="{StaticResource GoogleTopBtnStyle}" Padding="6,2" FontSize="10" Foreground="{DynamicResource TextSecondary}" Click="OnAdjQuickPresetTimeClicked" Tag="19:00|21:00" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Mode 2: Standard Fixed Sections -->
                                                <Grid x:Name="AdjStandardSectionInputsPanel" Margin="0,0,0,8" Visibility="Collapsed">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="起始节次：" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2" />
                                                        <ComboBox x:Name="AdjNewStartSectionCombo" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" Padding="6,4" FontSize="11" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="连堂节数：" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2" />
                                                        <ComboBox x:Name="AdjNewSpanCombo" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" Padding="6,4" FontSize="11">
                                                            <ComboBoxItem Content="1 节" Tag="1" />
                                                            <ComboBoxItem Content="2 节连堂" Tag="2" IsSelected="True" />
                                                            <ComboBoxItem Content="3 节连堂" Tag="3" />
                                                            <ComboBoxItem Content="4 节连堂" Tag="4" />
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- New Classroom / Location -->
                                                <TextBlock Text="新教室 / 地点 (留空则沿用原教室)：" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2" />
                                                <TextBox x:Name="AdjNewLocationInput" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="6,4" FontSize="11" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Reason / Notes -->
                                    <TextBlock Text="调整原因 / 说明 (如 国庆调休、教师出差、考前答疑)：" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                                    <TextBox x:Name="AdjReasonInput" Text="国庆放假调休" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,6" FontSize="12" Margin="0,0,0,12" />

                                    <Button Content="+ 保存并应用调停课规则" Style="{StaticResource GoogleActionBtnStyle}" Padding="16,6" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Click="OnSaveAdjustmentClicked" />
                                </StackPanel>
                            </Border>

                            <!-- Card 2: 已配置的调停课清单 -->
                            <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <StackPanel>
                                    <TextBlock Text="📋 已生效的调停课清单" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                                    <StackPanel x:Name="AdjustmentRecordsListPanel" />
                                    <TextBlock x:Name="AdjustmentRecordsEmptyText" Text="暂无任何调停课记录" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="4,4,0,4" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="关闭" Style="{StaticResource GoogleActionBtnStyle}" Padding="20,6" FontSize="12" FontWeight="SemiBold" Click="OnCloseAdjustmentModalClicked" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= MODAL 10: 首次启动新手引导向导 (ONBOARDING MODAL) ================= -->
        <Grid x:Name="OnboardingModal" Visibility="Collapsed" Background="#88000000" Grid.RowSpan="2" Panel.ZIndex="1200">
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Width="680" MinHeight="520" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header -->
                        <RowDefinition Height="Auto" />
                        <!-- Body Content (Step Carousel) -->
                        <RowDefinition Height="*" />
                        <!-- Footer Navigation -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                                <Image Source="app_logo_256.png" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="🌟 欢迎使用 RMF · 新手导览" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock x:Name="OnboardingStepIndicatorText" Text="步骤 1 / 4 · 欢迎启程" FontSize="11" Foreground="{DynamicResource AccentBlue}" FontWeight="Medium" Margin="0,1,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <Button Style="{StaticResource GoogleModalCloseBtnStyle}" ToolTip="跳过并关闭向导" Click="OnOnboardingSkipClicked" Grid.Column="1" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Body Content -->
                    <Grid Grid.Row="1" Margin="0,4,0,16">
                        <!-- Step 1: 欢迎致辞与系统理念 -->
                        <StackPanel x:Name="OnboardingStepPanel1" Visibility="Visible">
                            <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20,18" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="构建专属于你的高能四维时空节律" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentBlue}" Margin="0,0,0,6" />
                                    <TextBlock Text="RMF (Resonance Moment Flow) 融合 OKR 目标体系、精力认知限额与极简专注 HUD，拒绝碎片化低效记录，帮你在复杂的学习与工作中建立清晰确定的节奏感。" FontSize="12" Foreground="{DynamicResource TextSecondary}" LineHeight="18" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="✨ 核心三大系统支柱：" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,12">
                                    <StackPanel>
                                        <TextBlock Text="🎯 目标与排期闭环" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
                                        <TextBlock Text="OKR 愿景牵引待办敏捷池，在日/周/月视界中分配时间槽并落地执行。" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" LineHeight="15" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,12">
                                    <StackPanel>
                                        <TextBlock Text="🎯 事项负荷管理" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
                                        <TextBlock Text="自动区分深度工作与浅层事务，深度精力上限监控，远离疲劳耗竭。" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" LineHeight="15" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="4" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,12">
                                    <StackPanel>
                                        <TextBlock Text="🎓 高校智能课表" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" />
                                        <TextBlock Text="学期作息节次无缝联动，调停补课规则引擎，自动避让放假与出差。" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" LineHeight="15" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- Step 2: 四维排期与待办敏捷池 -->
                        <StackPanel x:Name="OnboardingStepPanel2" Visibility="Collapsed">
                            <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="📅 四维时空排期 &amp; 待办敏捷池" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBlue}" Margin="0,0,0,4" />
                                    <TextBlock Text="随时记录碎片待办，告别遗忘；需要执行时直接拖入时间线，秒级排期。" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" LineHeight="16" />
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="0,0,0,6">
                                <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="📥" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="左侧待办敏捷池 (Backlog)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock Text="未定时间的任务一键存入敏捷池，可随时拖入周/日历网格指定时间块。" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="⚡" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="全局闪念极速捕获 (Ctrl + Shift + Space)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock Text="无论正在写代码、浏览网页或阅读，按下快捷键即可瞬间捕捉灵感记录。" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="📋" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="DoD (Definition of Done) 交付验收标准" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock Text="在日程卡片中定义明确的产出衡量条件，确保每一次专注都有扎实结果。" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Step 3: 自学攻关、艾宾浩斯与高校课表 -->
                        <StackPanel x:Name="OnboardingStepPanel3" Visibility="Collapsed">
                            <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20,16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="📚 自学攻坚 &amp; 艾宾浩斯复习链 &amp; 高校课表" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBlue}" Margin="0,0,0,4" />
                                    <TextBlock Text="让知识沉淀为持久记忆，让学业生活有条不紊。" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" LineHeight="16" />
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="0,0,0,6">
                                <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="主题攻坚档案与学时打卡" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock Text="设定考研、考证、专业技能目标学时，+1h / +2h 极速打卡并自动更新进度。" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🔄" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="艾宾浩斯遗忘曲线复习链" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock Text="系统自动依据 1天、2天、4天、7天、15天 间隔生成复习提醒，告别前学后忘。" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" />
