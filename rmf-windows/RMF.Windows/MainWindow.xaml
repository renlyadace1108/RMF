                            <Button x:Name="OnboardingPrevBtn" Content="‹ 上一步" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="12,5" FontSize="11.5" Margin="0,0,6,0" Visibility="Collapsed" Click="OnOnboardingPrevClicked" />
                            <Button x:Name="OnboardingNextBtn" Content="下一步 ›" Style="{StaticResource GoogleActionBtnStyle}" Padding="18,5" FontSize="11.5" FontWeight="SemiBold" Click="OnOnboardingNextClicked" />
