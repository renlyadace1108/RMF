                                <ComboBoxItem Content="⏱️ 学习时长 (小时)" Tag="HOURS" IsSelected="True" />
                                <ComboBoxItem Content="📑 学习节数 (节/讲)" Tag="LESSONS" />
                                <ComboBoxItem Content="📖 书本页数 (页)" Tag="PAGES" />
