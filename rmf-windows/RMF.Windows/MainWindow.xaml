                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🎯" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="专注" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="🔄 刷新数据" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="12,6" FontSize="12" Click="OnRefreshFocusPageClicked" Margin="0,0,8,0" ToolTip="刷新专注监控与事件池" />
                            <Button Content="🚀 呼出专注胶囊" Style="{StaticResource GoogleActionBtnStyle}" Padding="16,6" FontSize="12" FontWeight="SemiBold" Click="OnFocusPageLaunchHudClicked" ToolTip="呼出悬浮 Mini HUD 置顶胶囊 (快捷键: Ctrl + Shift + F)" />
                        </StackPanel>
                    </Grid>

                    <!-- 1. Executive KPI Cards (4 Cards) -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Today Focus Duration -->
                        <Border Grid.Column="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="今日累计专注" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock x:Name="FocusKpiTodayDurationText" Text="0 分钟" FontSize="22" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,2" />
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Completed Sessions -->
                        <Border Grid.Column="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="今日专注轮次" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock x:Name="FocusKpiCompletedRoundsText" Text="0 轮" FontSize="22" FontWeight="Bold" Foreground="#8AB4F8" Margin="0,4,0,2" />
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Active Bound Task -->
                        <Border Grid.Column="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="当前绑定日程" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock x:Name="FocusKpiActiveTaskText" Text="未绑定 / 就绪" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" TextTrimming="CharacterEllipsis" Margin="0,8,0,2" />
                                <TextBlock x:Name="FocusKpiActiveStatusText" Text="⚪ 待命" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Interruption Loss -->
                        <Border Grid.Column="3" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="今日打断" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock x:Name="FocusKpiInterruptionText" Text="0 次 / 0 分钟" FontSize="22" FontWeight="Bold" Foreground="#F59E0B" Margin="0,4,0,2" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 2. Main Content Layout (Left 65% + Right 35%) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" MinWidth="440" />
                            <ColumnDefinition Width="2*" MinWidth="340" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Active Capsule Controller + Schedule Binding Pool -->
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">

                            <!-- Live Capsule Monitor Card -->
                            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
