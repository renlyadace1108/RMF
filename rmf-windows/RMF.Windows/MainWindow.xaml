<Window x:Class="RMF.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Renly Management Platform" 
        Icon="app.ico"
        Height="840" Width="1320"
        MinHeight="680" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource GoogleSurface}"
        Foreground="{DynamicResource GoogleTextPrimary}"
        FontFamily="Microsoft YaHei UI, Segoe UI Emoji, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 全局彻底消除软件内所有滚动条视觉元素，保留滚轮与触控板平滑滚动响应 -->
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="0" />
            <Setter Property="Height" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MaxWidth" Value="0" />
            <Setter Property="MaxHeight" Value="0" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Width="0" Height="0" Visibility="Collapsed" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollViewer}">
            <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <!-- Google Calendar Dark Theme Colors -->
        <SolidColorBrush x:Key="GoogleSurface" Color="#202124" />
        <SolidColorBrush x:Key="GoogleSurfaceVariant" Color="#303134" />
        <SolidColorBrush x:Key="GoogleBorder" Color="#3C4043" />
        <SolidColorBrush x:Key="GoogleBorderSubtle" Color="#2A2B2D" />
        <SolidColorBrush x:Key="GoogleText" Color="#E8EAED" />
        <SolidColorBrush x:Key="GoogleTextSecondary" Color="#9AA0A6" />
        <SolidColorBrush x:Key="GoogleBlue" Color="#1A73E8" />
        <SolidColorBrush x:Key="GoogleBlueHover" Color="#185ABC" />
        <SolidColorBrush x:Key="GoogleBlueLight" Color="#8AB4F8" />
        <SolidColorBrush x:Key="GoogleRed" Color="#EA4335" />
        <SolidColorBrush x:Key="GoogleGreen" Color="#0B8043" />
        <SolidColorBrush x:Key="GoogleYellow" Color="#F4511E" />
        <SolidColorBrush x:Key="GooglePurple" Color="#8E24AA" />

        <!-- Backward compatible aliases -->
        <SolidColorBrush x:Key="SidebarBackground" Color="#202124" />
        <SolidColorBrush x:Key="CardBackground" Color="#202124" />
        <SolidColorBrush x:Key="CardHoverBackground" Color="#303134" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#3C4043" />
        <SolidColorBrush x:Key="ControlBackground" Color="#303134" />
        <SolidColorBrush x:Key="InputBackground" Color="#18191B" />
        <SolidColorBrush x:Key="TextPrimary" Color="#E8EAED" />
        <SolidColorBrush x:Key="TextSecondary" Color="#9AA0A6" />
        <SolidColorBrush x:Key="TextMuted" Color="#71717A" />
        <SolidColorBrush x:Key="AccentBlue" Color="#1A73E8" />
        <SolidColorBrush x:Key="AccentPurple" Color="#8E24AA" />
        <SolidColorBrush x:Key="AccentGreen" Color="#0B8043" />
        <SolidColorBrush x:Key="AccentRed" Color="#EA4335" />

        <!-- Google Calendar Top Button Style -->
        <Style x:Key="GoogleTopBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Google Modal Close Button Style (彻底根除 ✕ 图标裁剪截断问题，矢量自适应) -->
        <Style x:Key="GoogleModalCloseBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="15" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                            <Path Data="M 9.5,9.5 L 20.5,20.5 M 20.5,9.5 L 9.5,20.5"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ControlBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Google Action Button Style -->
        <Style x:Key="GoogleActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource GoogleBlue}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Google Outline Button Style -->
        <Style x:Key="GoogleOutlineBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Google Create Pill Button Style -->
        <Style x:Key="GoogleCreateBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="22" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Right Rail Icon Button Style -->
        <Style x:Key="RightRailBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="22" Width="40" Height="40">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Left Nav Rail Tab Button Style (Supports Hover Expand) -->
        <Style x:Key="PrimaryNavRailBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="0">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBackground}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootMainGrid" Background="{DynamicResource GoogleSurface}">
        <Grid.RowDefinitions>
            <!-- Google Calendar Top Navigation Header Bar -->
            <RowDefinition Height="64" />
            <!-- Main Content Area: Left Drawer + Main Calendar Canvas + Right Companion Drawer + Rail -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= 1. TOP APP BAR ================= -->
        <Border Grid.Row="0" x:Name="TopAppBarBorder" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="12,0,14,0">
            <DockPanel LastChildFill="True">
                <!-- Top Right: 闪念捕获 + 专注胶囊 + 视图选择器 -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⚡ 闪念" Style="{StaticResource GoogleTopBtnStyle}" Background="{DynamicResource ControlBackground}" Foreground="{DynamicResource AccentBlue}" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Padding="8,4" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0" ToolTip="全局闪念极速捕获 (快捷键: Ctrl + Shift + Space)" Click="OnTopQuickCaptureClicked" />
                    <Button Content="🚀 专注胶囊" Style="{StaticResource GoogleTopBtnStyle}" Background="{DynamicResource ControlBackground}" Foreground="{DynamicResource AccentBlue}" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Padding="8,4" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0" ToolTip="呼出 Mini Focus HUD 桌面置顶胶囊 (快捷键: Ctrl + Shift + F)" Click="OnTopFocusHudClicked" />
                    <Button Content="🪟 桌面挂件" Style="{StaticResource GoogleTopBtnStyle}" Background="{DynamicResource ControlBackground}" Foreground="{DynamicResource TextPrimary}" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Padding="8,4" FontSize="11" FontWeight="SemiBold" Margin="0,0,10,0" ToolTip="打开常驻桌面透明小组件 (今日北极星/课表/待办)" Click="OnTopDesktopWidgetClicked" />
                    <Border x:Name="ViewSelectorBorder" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="2" Margin="0,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ViewDayBtn" Content="日" Style="{StaticResource GoogleTopBtnStyle}" Foreground="{DynamicResource TextPrimary}" Padding="8,3" FontSize="12" FontWeight="Normal" Click="OnViewDayClicked" ToolTip="日视图 (快捷键: D)" />
                            <Button x:Name="ViewWeekBtn" Content="周" Style="{StaticResource GoogleTopBtnStyle}" Background="{DynamicResource GoogleBlue}" Foreground="#FFFFFF" Padding="8,3" FontSize="12" FontWeight="SemiBold" Click="OnViewWeekClicked" ToolTip="周视图 (快捷键: W)" />
                            <Button x:Name="ViewMonthBtn" Content="月" Style="{StaticResource GoogleTopBtnStyle}" Foreground="{DynamicResource TextPrimary}" Padding="8,3" FontSize="12" FontWeight="Normal" Click="OnViewMonthClicked" ToolTip="月视图 (快捷键: M)" />
                            <Button x:Name="ViewYearBtn" Content="年" Style="{StaticResource GoogleTopBtnStyle}" Foreground="{DynamicResource TextPrimary}" Padding="8,3" FontSize="12" FontWeight="Normal" Click="OnViewYearClicked" ToolTip="年视图 (快捷键: Y)" />
                            <Button x:Name="ViewCustomBtn" Content="自定义" Style="{StaticResource GoogleTopBtnStyle}" Foreground="{DynamicResource TextPrimary}" Padding="8,3" FontSize="12" FontWeight="Normal" Click="OnViewCustomClicked" ToolTip="自定义排期视图 (快捷键: X)" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Left: Logo, Today, Chevrons, Date Title -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Brand App Logo -->
                    <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,10,0" ToolTip="Renly Management Platform">
                        <Image Source="app_logo_256.png" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <Button x:Name="TopTodayBtn" Content="今天" Style="{StaticResource GoogleOutlineBtnStyle}" Foreground="{DynamicResource TextPrimary}" Padding="10,4" FontSize="12" FontWeight="Medium" Margin="0,0,8,0" Click="OnCalTodayClicked" ToolTip="跳转到今天 (快捷键: T)" />
                    <Button x:Name="TopPrevBtn" Content="‹" Style="{StaticResource GoogleTopBtnStyle}" Foreground="{DynamicResource TextPrimary}" Width="28" Height="28" Padding="0" FontSize="18" FontWeight="Bold" ToolTip="前一个时段 (快捷键: J 或 P)" Click="OnCalPrevClicked" Margin="0,0,2,0" />
                    <Button x:Name="TopNextBtn" Content="›" Style="{StaticResource GoogleTopBtnStyle}" Foreground="{DynamicResource TextPrimary}" Width="28" Height="28" Padding="0" FontSize="18" FontWeight="Bold" ToolTip="后一个时段 (快捷键: K 或 N)" Click="OnCalNextClicked" Margin="0,0,10,0" />
                    <Border Background="Transparent" CornerRadius="4" Padding="4,2" Cursor="Hand" MouseLeftButtonUp="OnTopDateHeaderClicked" ToolTip="点击快速跳转指定日期 (快捷键: G)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TopDateHeaderTitle" Text="2026年10月" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            <TextBlock x:Name="TopDateHeaderArrow" Text=" ▾" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="2,2,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Center: Google Search Pill with Floating Dropdown (Takes remaining space, centered) -->
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0" MinWidth="0">
                    <Border x:Name="SearchBoxBorder" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" MaxWidth="240" Width="180" Height="32" Padding="8,0" VerticalAlignment="Center">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox x:Name="SearchEventsInput" Grid.Column="1" Background="Transparent" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" FontSize="11" VerticalAlignment="Center" TextChanged="OnSearchEventsTextChanged" ToolTip="搜索日程、DoD 或标签 (快捷键: /)" />
                            <Button Grid.Column="2" x:Name="ClearSearchBtn" Content="✕" Background="Transparent" Foreground="{DynamicResource TextSecondary}" BorderThickness="0" FontSize="10" Cursor="Hand" Visibility="Collapsed" Click="OnClearSearchClicked" ToolTip="清空搜索" />
                        </Grid>
                    </Border>

                    <!-- Search Results Floating Popup Dropdown -->
                    <Popup x:Name="SearchResultsPopup" PlacementTarget="{Binding ElementName=SearchEventsInput}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="6" HorizontalOffset="-20">
                        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Width="320" MaxHeight="320" Padding="8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="Black" />
                            </Border.Effect>
                            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                                <StackPanel>
                                    <TextBlock Text="🔍 搜索匹配结果" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="4,2,4,6" FontWeight="SemiBold" />
                                    <StackPanel x:Name="SearchResultsListPanel" />
                                    <TextBlock x:Name="SearchResultsEmptyText" Text="未找到匹配的日程" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="4,4,4,4" Visibility="Collapsed" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ================= 2. MAIN BODY (LEFT NAV RAIL + WORKSPACES) ================= -->
        <Grid Grid.Row="1" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <!-- Column 0: Left Primary Expandable Nav Rail -->
                <ColumnDefinition Width="Auto" />
                <!-- Column 1: Workspace Area -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= PRIMARY EXPANDABLE LEFT NAV RAIL ================= -->
            <Border Grid.Column="0" x:Name="PrimaryNavRail"
                    Width="58"
                    Background="{DynamicResource SidebarBackground}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="0,0,1,0"
                    HorizontalAlignment="Left"
                    MouseEnter="OnNavRailMouseEnter"
                    MouseLeave="OnNavRailMouseLeave"
                    ClipToBounds="True"
                    Panel.ZIndex="100">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="6,12,6,0">
                        <!-- Overview Nav Btn -->
                        <Button x:Name="NavOverviewBtn" Style="{StaticResource PrimaryNavRailBtnStyle}" Background="#1A73E8" Foreground="#FFFFFF" Click="OnNavOverviewClicked" ToolTip="日程">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📅" FontSize="18" Width="46" TextAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock x:Name="NavOverviewLabel" Text="日程" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- Focus Nav Btn -->
                        <Button x:Name="NavFocusBtn" Style="{StaticResource PrimaryNavRailBtnStyle}" Click="OnNavFocusClicked" ToolTip="专注">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🎯" FontSize="18" Width="46" TextAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock x:Name="NavFocusLabel" Text="专注" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- Summary Nav Btn -->
                        <Button x:Name="NavSummaryBtn" Style="{StaticResource PrimaryNavRailBtnStyle}" Click="OnNavSummaryClicked" ToolTip="统计">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📊" FontSize="18" Width="46" TextAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock x:Name="NavSummaryLabel" Text="统计" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- Study Nav Btn -->
                        <Button x:Name="NavStudyBtn" Style="{StaticResource PrimaryNavRailBtnStyle}" Click="OnNavStudyClicked" ToolTip="学习">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📚" FontSize="18" Width="46" TextAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock x:Name="NavStudyLabel" Text="学习" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- Fitness Nav Btn -->
                        <Button x:Name="NavFitnessBtn" Style="{StaticResource PrimaryNavRailBtnStyle}" Click="OnNavFitnessClicked" ToolTip="健身">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🏋️" FontSize="18" Width="46" TextAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock x:Name="NavFitnessLabel" Text="健身" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- Timetable Nav Btn -->
                        <Button x:Name="NavTimetableBtn" Style="{StaticResource PrimaryNavRailBtnStyle}" Click="OnNavTimetableClicked" ToolTip="课程表">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🎓" FontSize="18" Width="46" TextAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock x:Name="NavTimetableLabel" Text="课程表" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- Daily Report Nav Btn -->
                        <Button x:Name="NavDailyReportBtn" Style="{StaticResource PrimaryNavRailBtnStyle}" Click="OnNavDailyReportClicked" ToolTip="日报">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🏆" FontSize="18" Width="46" TextAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock x:Name="NavDailyReportLabel" Text="日报" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- Tutorial Nav Btn -->
                        <Button x:Name="NavTutorialBtn" Style="{StaticResource PrimaryNavRailBtnStyle}" Click="OnNavTutorialClicked" ToolTip="教程">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📖" FontSize="18" Width="46" TextAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock x:Name="NavTutorialLabel" Text="教程" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- Settings Nav Btn -->
                        <Button x:Name="NavSettingsBtn" Style="{StaticResource PrimaryNavRailBtnStyle}" Click="OnNavSettingsClicked" ToolTip="设置">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚙️" FontSize="18" Width="46" TextAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock x:Name="NavSettingsLabel" Text="设置" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Bottom Pin / Expand Button -->
                    <Border Grid.Row="1" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="6,8">
                        <Button x:Name="NavPinBtn" Style="{StaticResource PrimaryNavRailBtnStyle}" Click="OnNavPinClicked" ToolTip="固定/取消固定侧边栏">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="NavPinIcon" Text="📌" FontSize="16" Width="46" TextAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock x:Name="NavPinLabel" Text="固定侧边栏" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </Border>

            <!-- ================= WORKSPACES (PAGES) CONTAINER ================= -->
            <Grid Grid.Column="1">
                <!-- 1. OVERVIEW PAGE (CALENDAR WORKSPACE) -->
                <Grid x:Name="OverviewPageContainer" Visibility="Visible" ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <!-- Column 0: Left Google Drawer (Collapsible) -->
                        <ColumnDefinition Width="290" x:Name="LeftSidebarColumn" />
                        <!-- Column 1: Main Google Calendar Canvas (Week / Day / Month / Agenda) -->
                        <ColumnDefinition Width="*" />
                        <!-- Column 2: Collapsed drawer placeholder for code-behind compatibility -->
                        <ColumnDefinition Width="0" x:Name="RightDrawerColumn" />
                        <ColumnDefinition Width="0" x:Name="RightRailColumn" />
                    </Grid.ColumnDefinitions>

            <!-- ================= LEFT DRAWER ================= -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0" Padding="12,14,10,14">
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
                    <StackPanel>
                        <!-- Top Action Buttons: "+ 创建日程" and "+ 待办" -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="GoogleCreateBtn" Style="{StaticResource GoogleCreateBtnStyle}" HorizontalAlignment="Left" Click="OnGoogleCreateClicked">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="➕" FontSize="14" Foreground="#8AB4F8" FontWeight="Bold" Margin="0,0,8,0" />
                                    <TextBlock Text="创建" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,6,0" />
                                    <TextBlock Text="▾" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Content="+ 待办" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="10,6" FontSize="12" FontWeight="Medium" Click="OnAddBacklogClicked" ToolTip="直接创建未排期任务存入敏捷池" />
                        </Grid>

                        <!-- Interactive Mini Month Calendar (Date Picker) -->
                        <Border Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="4,0,4,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="MiniCalMonthTitle" Text="2026年10月" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="‹" Style="{StaticResource GoogleTopBtnStyle}" Width="26" Height="26" Padding="0" FontSize="16" FontWeight="Bold" Click="OnMiniCalPrevClicked" Margin="0,0,2,0" />
                                    <Button Grid.Column="2" Content="›" Style="{StaticResource GoogleTopBtnStyle}" Width="26" Height="26" Padding="0" FontSize="16" FontWeight="Bold" Click="OnMiniCalNextClicked" />
                                </Grid>

                                <UniformGrid Columns="7" Margin="0,0,0,4">
                                    <TextBlock Text="一" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
                                    <TextBlock Text="二" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
                                    <TextBlock Text="三" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
                                    <TextBlock Text="四" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
                                    <TextBlock Text="五" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
                                    <TextBlock Text="六" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
                                    <TextBlock Text="日" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
                                </UniformGrid>

                                <UniformGrid x:Name="MiniCalGrid" Columns="7" Rows="6" />
                            </StackPanel>
                        </Border>

                        <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,14" />

                        <!-- ================= MODULE 2.1: 待办任务 (BACKLOG DRAWER) ================= -->
                        <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📥" FontSize="13" Margin="0,0,6,0" />
                                        <TextBlock Text="待办" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                        <Border x:Name="BacklogCountBadge" Background="{DynamicResource CardBackground}" CornerRadius="10" Padding="6,1" Margin="6,0,0,0">
                                            <TextBlock x:Name="BacklogCountText" Text="0" FontSize="10" Foreground="#8AB4F8" FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="+" Style="{StaticResource GoogleTopBtnStyle}" Width="26" Height="26" Padding="0" FontSize="16" HorizontalAlignment="Right" ToolTip="添加待办任务" Click="OnAddBacklogClicked" />
                                </Grid>

                                <StackPanel x:Name="BacklogItemsPanel" />
                                <TextBlock x:Name="BacklogEmptyText" Text="暂无待办任务" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="4,4,0,4" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <!-- ================= MODULE 2.2: 目标 (GOAL TREE) ================= -->
                        <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🎯" FontSize="13" Margin="0,0,6,0" />
                                        <TextBlock Text="目标" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="+ 目标" Background="Transparent" Foreground="#8AB4F8" BorderThickness="0" Padding="0" FontSize="11" HorizontalAlignment="Right" Cursor="Hand" Click="OnAddGoalClicked" ToolTip="新增目标" />
                                </Grid>

                                <StackPanel x:Name="GoalTreePanel" />
                            </StackPanel>
                        </Border>

                        <!-- 分类标签 Section -->
                        <Expander Header="🏷️ 分类标签" Foreground="{DynamicResource TextSecondary}" FontSize="12" IsExpanded="False" Margin="0,0,0,12">
                            <StackPanel Margin="0,6,0,0">
                                <Button Content="⚙️ 管理标签..." Style="{StaticResource GoogleTopBtnStyle}" HorizontalAlignment="Left" Foreground="{DynamicResource AccentBlue}" FontSize="11" Padding="4,2" Margin="0,0,0,6" Click="OnOpenTagManagementClicked" ToolTip="打开分类标签管理界面" />
                                <StackPanel x:Name="MyCalendarsCategoryListPanel" />
                                <TextBlock x:Name="MyCalendarsEmptyText" Text="暂无分类标签" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="4,0,0,4" Visibility="Collapsed" />
                            </StackPanel>
                        </Expander>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ================= CENTER: GOOGLE CALENDAR MAIN MULTI-VIEW CANVAS ================= -->
            <Grid Grid.Column="1" Background="{DynamicResource GoogleSurface}">
                <!-- 1. 周视图 (WEEK VIEW - 7 COLUMNS) [DEFAULT] -->
                <Grid x:Name="WeekViewContainer" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <!-- Week Header (Days of week + date circle) -->
                        <RowDefinition Height="64" />
                        <!-- All-Day Events Slot Row -->
                        <RowDefinition Height="Auto" />
                        <!-- 24-Hour Scrollable Time Grid Canvas -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Week Header Row -->
                    <Border Grid.Row="0" Background="{DynamicResource GoogleSurface}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="GMT+8" FontSize="10" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                            <UniformGrid Grid.Column="1" x:Name="WeekHeaderGrid" Columns="7" />
                        </Grid>
                    </Border>

                    <!-- All-Day Row (if any) -->
                    <Border Grid.Row="1" x:Name="WeekAllDayBorder" Background="{DynamicResource GoogleSurface}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="全天" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <UniformGrid Grid.Column="1" x:Name="WeekAllDayGrid" Columns="7" />
                        </Grid>
                    </Border>

                    <!-- 24-Hour Scrollable Week Grid -->
                    <ScrollViewer Grid.Row="2" x:Name="WeekScrollViewer" VerticalScrollBarVisibility="Hidden">
                        <Grid x:Name="WeekGridTrack">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: 24 Hour Labels -->
                            <StackPanel Grid.Column="0" x:Name="WeekHourLabelsPanel" />

                            <!-- Right: 7-Column Grid Lines + Clickable Slots + Events Canvas -->
                            <Grid Grid.Column="1">
                                <UniformGrid x:Name="WeekSlotsGrid" Columns="7" />

                                <!-- Absolute Canvas for Events & Red Indicator Line & Drag-to-Select Selection Box -->
                                <Canvas x:Name="WeekEventsCanvas" ClipToBounds="True" Background="Transparent"
                                        MouseLeftButtonDown="OnCanvasMouseLeftButtonDown"
                                        MouseMove="OnCanvasMouseMove"
                                        MouseLeftButtonUp="OnCanvasMouseLeftButtonUp"
                                        DragOver="OnWeekCanvasDragOver"
                                        Drop="OnWeekCanvasDrop"
                                        AllowDrop="True" />
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- 2. 天视图 (DAY VIEW - 1 COLUMN) -->
                <Grid x:Name="DayViewContainer" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Day Header (Row 0) -->
                    <Border Grid.Row="0" Background="{DynamicResource GoogleSurface}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="GMT+8" FontSize="10" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Border x:Name="DayHeaderDateBadge" Background="#1A73E8" Width="40" Height="40" CornerRadius="20" Margin="0,0,12,0">
                                    <TextBlock x:Name="DayHeaderDateNumText" Text="2" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="DayHeaderWeekdayText" Text="星期五" FontSize="15" FontWeight="SemiBold" Foreground="#8AB4F8" />
                                    <TextBlock x:Name="DayHeaderFullDateText" Text="2026年10月2日" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Day All-Day Row (Row 1) -->
                    <Border Grid.Row="1" x:Name="DayAllDayBorder" Background="{DynamicResource GoogleSurface}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="全天" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" x:Name="DayAllDayStackPanel" Margin="4,4,16,4" />
                        </Grid>
                    </Border>

                    <!-- 24-Hour Day Grid (Row 2) -->
                    <ScrollViewer Grid.Row="2" x:Name="DayScrollViewer" VerticalScrollBarVisibility="Hidden">
                        <Grid x:Name="DayGridTrack">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" x:Name="DayHourLabelsPanel" />
                            <Grid Grid.Column="1">
                                <StackPanel x:Name="DayHourSlotsPanel" />
                                <Canvas x:Name="DayEventsCanvas" ClipToBounds="True" Background="Transparent"
                                        MouseLeftButtonDown="OnCanvasMouseLeftButtonDown"
                                        MouseMove="OnCanvasMouseMove"
                                        MouseLeftButtonUp="OnCanvasMouseLeftButtonUp"
                                        DragOver="OnDayCanvasDragOver"
                                        Drop="OnDayCanvasDrop"
                                        AllowDrop="True" />
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- 3. 月视图 (MONTH VIEW) -->
                <Grid x:Name="MonthViewContainer" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource GoogleSurface}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                        <UniformGrid Columns="7">
                            <TextBlock Text="周一" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="周二" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="周三" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="周四" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="周五" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="周六" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="周日" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </UniformGrid>
                    </Border>

                    <UniformGrid Grid.Row="1" x:Name="MonthCellsGrid" Columns="7" Rows="6" />
                </Grid>

                <!-- 4. 日程清单视图 (AGENDA VIEW) -->
                <Grid x:Name="AgendaViewContainer" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden" Padding="24">
                        <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                            <TextBlock Text="📋 日程安排与议程清单" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16" />
                            
                            <Border x:Name="AgendaEmptyState" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="36" Margin="0,10,0,0" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📅" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                    <TextBlock Text="当前周期内暂无排期日程" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                    <TextBlock Text="点击左上角「+ 创建」或点击网格时段快速添加" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,0,16,0" />
                                    <Button Content="+ 立即创建日程" Background="#1A73E8" Foreground="#FFFFFF" BorderThickness="0" Padding="18,8" FontWeight="SemiBold" FontSize="13" Cursor="Hand" HorizontalAlignment="Center" Click="OnGoogleCreateClicked" />
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="AgendaListPanel" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 5. 年视图 (YEAR VIEW - 12 MONTHS OVERVIEW) -->
                <Grid x:Name="YearViewContainer" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Year Header & Metrics -->
                    <Border Grid.Row="0" Background="{DynamicResource GoogleSurface}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="YearViewTitleText" Text="2026 年度日程概览" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,16,0" />
                                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,10,0">
                                    <TextBlock x:Name="YearTotalEventsText" Text="全年共 0 个日程" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold" />
                                </Border>
                                <Border Background="#14532D" CornerRadius="4" Padding="8,4">
                                    <TextBlock x:Name="YearDeepWorkHoursText" Text="深度工作: 0.0 小时" FontSize="12" Foreground="#4ADE80" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="1" Content="📅 跳转到本月" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="12,5" FontSize="12" Click="OnYearJumpCurrentMonthClicked" />
                        </Grid>
                    </Border>

                    <!-- 12 Months Grid (4 Columns x 3 Rows) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Padding="16">
                        <UniformGrid x:Name="YearMonthsGrid" Columns="4" Rows="3" HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                    </ScrollViewer>
                </Grid>

                <!-- 6. 真正意义上的自由自定义排期视图 (TRULY CUSTOM RANGE CALENDAR VIEW) -->
                <Grid x:Name="CustomViewContainer" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Full Custom Range Controls Toolbar -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Custom Header Row (With Sync Horizontal Scroll) -->
                        <RowDefinition Height="64" />
                        <!-- Row 2: Custom All-Day Row (With Sync Horizontal Scroll) -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 3: Main Timeline View / Multi-Day Agenda View -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Toolbar - 自由日期范围挑选与天数输入 -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Top Line: 自定义日期范围选择器 + 天数微调 + 应用按钮 -->
                            <WrapPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="📅 起始:" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <DatePicker x:Name="CustomStartDatePicker" Width="165" Height="28" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" VerticalContentAlignment="Center" FontSize="12" SelectedDateChanged="OnCustomDateRangePickerChanged" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="至  结束:" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <DatePicker x:Name="CustomEndDatePicker" Width="165" Height="28" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" VerticalContentAlignment="Center" FontSize="12" SelectedDateChanged="OnCustomDateRangePickerChanged" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="跨度:" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <Button Content="-" Style="{StaticResource GoogleTopBtnStyle}" Width="24" Height="28" Padding="0" Click="OnCustomDaysDecrementClicked" ToolTip="减少 1 天" />
                                    <TextBox x:Name="CustomDaysInput" Text="4" Width="40" Height="28" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource AccentBlue}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" TextAlignment="Center" VerticalContentAlignment="Center" FontSize="12" FontWeight="SemiBold" KeyDown="OnCustomDaysInputKeyDown" Margin="3,0" />
                                    <Button Content="+" Style="{StaticResource GoogleTopBtnStyle}" Width="24" Height="28" Padding="0" Click="OnCustomDaysIncrementClicked" ToolTip="增加 1 天" />
                                    <TextBlock Text="天" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                </StackPanel>

                                <Button Content="✓ 应用范围" Style="{StaticResource GoogleActionBtnStyle}" Padding="10,4" FontSize="12" FontWeight="SemiBold" Click="OnApplyCustomDateRangeClicked" Margin="0,0,14,0" />

                                <!-- View Mode Toggle: 时间轴网格 vs 多日清单 -->
                                <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="2" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="CustomModeTimelineBtn" Content="📊 时间网格" Style="{StaticResource GoogleTopBtnStyle}" Background="#1A73E8" Foreground="#FFFFFF" Padding="8,3" FontSize="11" FontWeight="SemiBold" Click="OnCustomModeTimelineClicked" />
                                        <Button x:Name="CustomModeAgendaBtn" Content="📋 多日清单" Style="{StaticResource GoogleTopBtnStyle}" Foreground="{DynamicResource TextPrimary}" Padding="8,3" FontSize="11" FontWeight="Normal" Click="OnCustomModeAgendaClicked" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <!-- Bottom Line: 快速预设标签与状态提示 -->
                            <Grid Grid.Row="1" ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="快捷预设：" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <Button Content="3天" Style="{StaticResource GoogleTopBtnStyle}" Padding="6,2" FontSize="11" Margin="0,0,4,0" Click="OnCustomPreset3Days" />
                                    <Button Content="4天" Style="{StaticResource GoogleTopBtnStyle}" Padding="6,2" FontSize="11" Margin="0,0,4,0" Click="OnCustomPreset4Days" />
                                    <Button Content="5天(工作日)" Style="{StaticResource GoogleTopBtnStyle}" Padding="6,2" FontSize="11" Margin="0,0,4,0" Click="OnCustomPreset5Days" />
                                    <Button Content="7天(整周)" Style="{StaticResource GoogleTopBtnStyle}" Padding="6,2" FontSize="11" Margin="0,0,4,0" Click="OnCustomPreset7Days" />
                                    <Button Content="10天" Style="{StaticResource GoogleTopBtnStyle}" Padding="6,2" FontSize="11" Margin="0,0,4,0" Click="OnCustomPreset10Days" />
                                    <Button Content="14天(两周)" Style="{StaticResource GoogleTopBtnStyle}" Padding="6,2" FontSize="11" Margin="0,0,4,0" Click="OnCustomPreset14Days" />
                                    <Button Content="30天(月度)" Style="{StaticResource GoogleTopBtnStyle}" Padding="6,2" FontSize="11" Margin="0,0,4,0" Click="OnCustomPreset30Days" />
                                    <Button Content="本月剩余" Style="{StaticResource GoogleTopBtnStyle}" Padding="6,2" FontSize="11" Click="OnCustomPresetRestOfMonth" />
                                </WrapPanel>

                                <TextBlock Grid.Column="1" x:Name="CustomRangeNoticeText" Text="" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Row 1: Custom Header Row (With Sync Horizontal Scroll) -->
