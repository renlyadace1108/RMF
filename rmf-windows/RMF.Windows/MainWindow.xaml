                    <Button Content="✓ 完成" Style="{StaticResource GoogleTopBtnStyle}" Foreground="#10B981" Padding="6,4" FontSize="11" Margin="0,0,6,0" ToolTip="直接标记完成并反哺" Click="OnUpcomingEventCompleteClicked" />
