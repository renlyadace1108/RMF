<Window x:Class="RMF.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:RMF.Windows"
        mc:Ignorable="d"
        Title="RMF (Renly Manage Platform) - 个人多端中枢" 
        Height="780" Width="1200"
        MinHeight="600" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#18181B"
        Foreground="#F4F4F5">

    <Window.Resources>
        <!-- Custom Color Palette -->
        <SolidColorBrush x:Key="SidebarBackground" Color="#121215" />
        <SolidColorBrush x:Key="CardBackground" Color="#202024" />
        <SolidColorBrush x:Key="CardHoverBackground" Color="#27272C" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#323238" />
        <SolidColorBrush x:Key="TextPrimary" Color="#FAFAFA" />
        <SolidColorBrush x:Key="TextSecondary" Color="#A1A1AA" />
        <SolidColorBrush x:Key="TextMuted" Color="#71717A" />
        <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6" />
        <SolidColorBrush x:Key="AccentPurple" Color="#8B5CF6" />
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981" />
        <SolidColorBrush x:Key="AccentRed" Color="#EF4444" />

        <!-- Navigation Button Style -->
        <Style x:Key="NavTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#A1A1AA" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#27272A" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Nav Style -->
        <Style x:Key="ActiveNavTabButtonStyle" TargetType="Button" BasedOn="{StaticResource NavTabButtonStyle}">
            <Setter Property="Background" Value="#27272A" />
            <Setter Property="Foreground" Value="#38BDF8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT SIDEBAR ================= -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Sidebar Top Action -->
                <StackPanel Grid.Row="0" Margin="0,4,0,16">
                    <Button Content="+ 新建日程" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" Padding="14,10" FontWeight="SemiBold" FontSize="13" Cursor="Hand" HorizontalAlignment="Stretch" Click="OnNewScheduleHeaderClicked" />
                </StackPanel>

                <!-- Nav Menu -->
                <StackPanel Grid.Row="1">
                    <Button Name="NavScheduleBtn" Style="{StaticResource ActiveNavTabButtonStyle}" Margin="0,0,0,4" Click="OnNavScheduleClicked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📅" FontSize="15" Margin="0,0,10,0" />
                            <TextBlock Text="Google 日历" />
                        </StackPanel>
                    </Button>

                    <Button Name="NavFocusBtn" Style="{StaticResource NavTabButtonStyle}" Margin="0,0,0,4" Click="OnNavFocusClicked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏱️" FontSize="15" Margin="0,0,10,0" />
                            <TextBlock Text="专注与AI监管" />
                        </StackPanel>
                    </Button>

                    <Button Name="NavFinanceBtn" Style="{StaticResource NavTabButtonStyle}" Margin="0,0,0,4" Click="OnNavFinanceClicked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💰" FontSize="15" Margin="0,0,10,0" />
                            <TextBlock Text="收入与支出" />
                        </StackPanel>
                    </Button>

                    <Button Name="NavSyncBtn" Style="{StaticResource NavTabButtonStyle}" Margin="0,0,0,4" Click="OnNavSyncClicked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="☁️" FontSize="15" Margin="0,0,10,0" />
                            <TextBlock Text="Google 同步中枢" />
                        </StackPanel>
                    </Button>

                    <Button Name="NavSettingsBtn" Style="{StaticResource NavTabButtonStyle}" Margin="0,0,0,4" Click="OnNavSettingsClicked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" FontSize="15" Margin="0,0,10,0" />
                            <TextBlock Text="Gemini API 设置" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Bottom System Telemetry Card -->
                <Border Grid.Row="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                            <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" />
                            <TextBlock Text="原生极轻引擎" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                        </StackPanel>
                        
                        <TextBlock Name="MemoryUsageText" Text="内存: 24.5 MB" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,2" />
                        <TextBlock Name="CpuUsageText" Text="CPU: 0.0% (零后台轮询)" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8" />
                        
                        <Button Content="⚡ 瞬间压制内存" Background="#27272A" Foreground="#FAFAFA" BorderThickness="1" BorderBrush="#3F3F46" Padding="8,5" FontSize="12" HorizontalAlignment="Stretch" Cursor="Hand" Click="OnTrimMemoryClicked" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= MAIN DASHBOARD BODY ================= -->
        <Grid Grid.Column="1" Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Dashboard Top Action & Header Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="今日工作台" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="2026年10月2日 · 联想小新Pad与ColorOS多端就绪" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Top Quick Action Buttons & Model Badge -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,12,0" Cursor="Hand" MouseLeftButtonUp="OnModelBadgeClicked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#38BDF8" Margin="0,0,6,0" />
                            <TextBlock Name="ActiveModelBadge" Text="⚡ 模型: gemini-2.5-flash" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Button Content="+ 快捷记账" Background="#27272A" Foreground="#FAFAFA" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="14,8" Margin="0,0,10,0" FontSize="13" Cursor="Hand" Click="OnQuickExpenseHeaderClicked" />
                    <Button Content="+ 新建日程" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" Padding="16,8" FontWeight="SemiBold" FontSize="13" Cursor="Hand" Click="OnNewScheduleHeaderClicked" />
                </StackPanel>
            </Grid>

            <!-- Main Content Area -->
            <Grid Grid.Row="1">
                <!-- 1. SCHEDULE & TIMETABLE VIEW (Google Calendar) -->
                <Grid Name="ScheduleView" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Google Calendar Top Navigation & Action Toolbar -->
                    <Border Grid.Row="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Date Navigator -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📅" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Google 日历" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,14,0" />

                                <Button x:Name="CalTodayBtn" Content="今天" Background="#27272A" Foreground="#FAFAFA" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="12,5" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0" Click="OnCalTodayClicked" />
                                
                                <Button x:Name="CalPrevBtn" Content="◀" Background="Transparent" Foreground="{StaticResource TextSecondary}" BorderThickness="0" Padding="8,4" FontSize="12" Cursor="Hand" ToolTip="前一天" Click="OnCalPrevClicked" />
                                <Button x:Name="CalNextBtn" Content="▶" Background="Transparent" Foreground="{StaticResource TextSecondary}" BorderThickness="0" Padding="8,4" FontSize="12" Cursor="Hand" ToolTip="后一天" Click="OnCalNextClicked" Margin="0,0,12,0" />

                                <TextBlock x:Name="CalDateHeaderTitle" Text="2026年10月2日 · 星期五" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <Border x:Name="CalTodayTag" Background="#1E3A8A" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Visibility="Visible">
                                    <TextBlock Text="今日" FontSize="11" Foreground="#60A5FA" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>

                            <!-- Right: Sync Status & Mode, Sync Action, View Switcher -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Sync Status Badge -->
                                <Border x:Name="CalSyncBadge" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="CalSyncStatusDot" Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" />
                                        <TextBlock x:Name="CalSyncStatusText" Text="💾 本地数据模式" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                    </StackPanel>
                                </Border>

                                <!-- Sync Button -->
                                <Button x:Name="CalSyncNowBtn" Content="🔄 同步 Google 日历" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" Padding="12,6" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0" Click="OnSyncGoogleCalendarClicked" />

                                <!-- Settings Button -->
                                <Button x:Name="CalConfigBtn" Content="⚙️ 订阅设置" Background="#27272A" Foreground="{StaticResource TextSecondary}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="10,6" FontSize="12" Cursor="Hand" Margin="0,0,10,0" ToolTip="配置 Google Calendar iCal 私密订阅地址" Click="OnOpenGoogleCalendarConfigClicked" />

                                <!-- View Toggle (Grid vs Agenda) -->
                                <Border Background="#18181B" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="CalViewGridBtn" Content="📊 时间网格" Background="#27272A" Foreground="#38BDF8" BorderThickness="0" Padding="10,4" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Click="OnCalViewGridClicked" />
                                        <Button x:Name="CalViewAgendaBtn" Content="📋 议程清单" Background="Transparent" Foreground="{StaticResource TextMuted}" BorderThickness="0" Padding="10,4" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Click="OnCalViewAgendaClicked" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Google Calendar Main Content Split: Left Calendar Canvas, Right AI & Metrics -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="7*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Calendar Area -->
                        <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <Grid>
                                <!-- View 1: Day Time Grid Canvas -->
                                <Grid x:Name="CalGridContainer" Visibility="Visible">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Grid Sub-header: Weekday header and Add button -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="CalGridDayHeader" Text="全天日程网格 (24H)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                                            <TextBlock Text=" · 点击任意时段即可直接新建日程" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="+ 新建日程" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" Padding="10,5" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Click="OnNewScheduleHeaderClicked" />
                                    </Grid>

                                    <!-- 24-Hour Scrollable Canvas -->
                                    <ScrollViewer Grid.Row="1" x:Name="CalGridScrollViewer" VerticalScrollBarVisibility="Auto">
                                        <Grid x:Name="CalGridTimeTrack">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Left: Hour Labels (06:00 to 23:00) -->
                                            <StackPanel Grid.Column="0" x:Name="CalHourLabelsPanel" />

                                            <!-- Right: Hour Slot Dividers & Events Canvas -->
                                            <Grid Grid.Column="1">
                                                <!-- Background Grid Lines & Clickable Slots -->
                                                <StackPanel x:Name="CalHourSlotsPanel" />

                                                <!-- Absolute Canvas for Events & Red Current Time Line -->
                                                <Canvas x:Name="CalEventsCanvas" ClipToBounds="True" />
                                            </Grid>
                                        </Grid>
                                    </ScrollViewer>
                                </Grid>

                                <!-- View 2: Agenda List View -->
                                <Grid x:Name="CalAgendaContainer" Visibility="Collapsed">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="📋 议程清单视图" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Content="+ 新建日程" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" Padding="12,6" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Click="OnNewScheduleHeaderClicked" />
                                            </Grid>

                                            <!-- Empty State (Shown when 0 schedules) -->
                                            <Border x:Name="ScheduleEmptyState" Background="#18181B" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="32" Margin="0,10,0,0">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="📅" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                                    <TextBlock Text="该日期暂无排期日程" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                                    <TextBlock Text="点击上方「+ 新建日程」或同步 Google 日历" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,0,16,0" />
                                                    <Button Content="+ 立即添加日程" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" Padding="18,9" FontWeight="SemiBold" FontSize="13" Cursor="Hand" HorizontalAlignment="Center" Click="OnNewScheduleHeaderClicked" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Dynamic Schedule Items Container -->
                                            <StackPanel x:Name="ScheduleTimelinePanel" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Right: AI Supervision & Real-time Radar -->
                        <Border Grid.Column="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Mini Metrics Card -->
                                <Border Grid.Row="0" Background="#18181B" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="今日日程完成率" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,6" VerticalAlignment="Center">
                                            <TextBlock x:Name="MetricScheduleCompletedText" Text="0" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" />
                                            <TextBlock x:Name="MetricScheduleTotalText" Text=" / 0 个时间块" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Bottom" Margin="4,0,0,2" />
                                        </StackPanel>
                                        <ProgressBar x:Name="MetricScheduleProgressBar" Value="0" Maximum="100" Height="4" Foreground="#38BDF8" Background="#27272A" BorderThickness="0" Margin="0,0,0,8" />
                                        
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="专注时长" FontSize="10" Foreground="{StaticResource TextMuted}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="MetricFocusMinutesText" Text="0" FontSize="13" FontWeight="Bold" Foreground="#10B981" />
                                                    <TextBlock x:Name="MetricFocusStatusText" Text=" 分钟" FontSize="11" Foreground="#10B981" VerticalAlignment="Bottom" />
                                                </StackPanel>
                                                <TextBlock x:Name="MetricFocusSubtitleText" Text="Win32 前台实时嗅探中" FontSize="9" Foreground="{StaticResource TextMuted}" Visibility="Collapsed" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="今日支出" FontSize="10" Foreground="{StaticResource TextMuted}" />
                                                <TextBlock x:Name="MetricExpenseTotalText" Text="¥ 0.00" FontSize="13" FontWeight="Bold" Foreground="#F43F5E" />
                                                <TextBlock x:Name="MetricExpenseSubtitleText" Text="今日暂无记账" FontSize="9" Foreground="{StaticResource TextMuted}" Visibility="Collapsed" />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Current Active Window -->
                                <Border Grid.Row="1" Background="#18181B" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                            <Ellipse Width="6" Height="6" Fill="#38BDF8" Margin="0,0,6,0" />
                                            <TextBlock Text="前台活动嗅探 (AI 输入流)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                                        </StackPanel>
                                        <TextBlock Name="ActiveWindowText" Text="捕获中..." FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Audit Trigger Button -->
                                <Button Grid.Row="2" Name="AuditScheduleBtn" Content="✨ 唤醒 Gemini 审查排期" Background="#7C3AED" Foreground="#FFFFFF" BorderThickness="0" Padding="12,8" FontWeight="SemiBold" FontSize="13" Cursor="Hand" Margin="0,0,0,10" HorizontalAlignment="Stretch" Click="OnAuditScheduleClicked" />

                                <!-- Real Gemini Feedback Card -->
                                <Border Grid.Row="3" Background="#231A38" BorderBrush="#5B21B6" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="📋 Gemini 审查与复盘反馈" FontWeight="Bold" FontSize="12" Foreground="#DDD6FE" Margin="0,0,0,6" />
                                            <TextBlock Name="AuditResultText" Text="点击上方按钮，Gemini 将根据该日期的所有日程排期与桌面活动，审查时间块密度、精力分配与潜在拖延风险。" FontSize="12" LineHeight="18" Foreground="#C4B5FD" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 2. FOCUS & AI SUPERVISION VIEW -->
                <Grid Name="FocusView" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="⏱️ 专注管理与 Gemini 监督思考中枢" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6" />
                            <TextBlock Text="充当你的 AI 思考合伙人与行为监督官：评估你的新灵感、检验执行可行性、防分心拉回、智能任务排程。" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,0,0,20" />

                            <!-- Module A: Evaluate Idea & Thought -->
                            <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                        <TextBlock Text="💡" FontSize="18" Margin="0,0,8,0" />
                                        <TextBlock Text="监督评估我的想法与决策 (Idea &amp; Plan Auditor)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                    </StackPanel>
                                    <TextBlock Text="遇到突发的灵感、技术构想或生活安排？让 Gemini 从「主线专注度、可行性、沉没成本与第一步行动」帮你泼冷水或给出深度洞察：" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12" />

                                    <TextBox Name="UserIdeaInput" Background="#18181B" Foreground="#FAFAFA" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="12" FontSize="13" AcceptsReturn="True" TextWrapping="Wrap" Height="80" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" />

                                    <Button Name="EvaluateIdeaBtn" Content="🚀 让 Gemini 深入评估这个想法" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" Padding="16,10" FontWeight="SemiBold" FontSize="13" Cursor="Hand" HorizontalAlignment="Left" Margin="0,0,0,12" Click="OnEvaluateIdeaClicked" />

                                    <Border Background="#18181B" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                            <TextBlock Name="IdeaEvaluationResultText" Text="（等待你的想法输入...）" FontSize="13" LineHeight="20" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Module B: Smart Auto-Scheduler -->
                            <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                        <TextBlock Text="✨" FontSize="18" Margin="0,0,8,0" />
                                        <TextBlock Text="AI 智能排程帮手 (Smart Planner)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                    </StackPanel>
                                    <TextBlock Text="输入你想达成的目标，Gemini 结合你现有的空白时间自动拆解为合理专注时间块：" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12" />

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Name="GoalPlanInput" Background="#18181B" Foreground="#FAFAFA" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="12,10" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <Button Grid.Column="1" Name="PlanScheduleBtn" Content="生成推荐排程" Background="#7C3AED" Foreground="#FFFFFF" BorderThickness="0" Padding="16,10" FontWeight="SemiBold" Cursor="Hand" Click="OnPlanScheduleClicked" />
                                    </Grid>

                                    <Border Background="#18181B" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                            <TextBlock Name="GoalPlanResultText" Text="（等待排程目标输入...）" FontSize="13" LineHeight="20" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 3. FINANCE VIEW -->
                <Grid x:Name="FinanceView" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="800" HorizontalAlignment="Left" Margin="0,0,0,20">
                            <TextBlock Text="💰 智能自然语言收支记账" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />

                            <!-- Input Card -->
                            <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="自然语言输入记账（支持输入如「中午肯德基汉堡花了35.5元」或「打车28元」，自动提取分类与金额并入库）：" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="QuickExpenseInput" Background="#18181B" Foreground="#FAFAFA" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="12,10" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <Button Grid.Column="1" Content="智能入库记账" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" Padding="18,10" FontWeight="SemiBold" Cursor="Hand" Click="OnQuickExpenseClicked" />
                                    </Grid>
                                    <TextBlock x:Name="ExpenseResultText" Text="" Foreground="#10B981" FontSize="13" />
                                </StackPanel>
                            </Border>

                            <!-- Today Expense Records List -->
                            <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="📋 今日收支明细清单" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="FinanceSummaryText" Grid.Column="1" Text="今日合计: ¥ 0.00" FontSize="14" FontWeight="Bold" Foreground="#F43F5E" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Empty state -->
                                    <Border x:Name="ExpenseEmptyState" Background="#18181B" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="28" Margin="0,6,0,0">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="🪙" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                            <TextBlock Text="今日暂无收支记录" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                            <TextBlock Text="在上方输入框输入一句话即可智能记账，数据安全保存在本地 SQLite 中" FontSize="12" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Dynamic expense items list -->
                                    <StackPanel x:Name="ExpenseHistoryPanel" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 4. SYNC VIEW -->
                <Grid x:Name="SyncView" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="800" HorizontalAlignment="Left" Margin="0,0,0,20">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock Text="☁️" FontSize="20" Margin="0,0,8,0" />
                                <TextBlock Text="Google Drive 隐式空间数据同步中心" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                            </StackPanel>
                            <TextBlock Text="RMF 采用完全无服务器架构，直接将日程、专注与收支数据同步至你私有的 Google Drive 隐藏空间（drive.appdata）。即使未配置同步，本地也拥有完整的 Local-First SQLite 存储。" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,20" TextWrapping="Wrap" />

                            <!-- Current Status Card -->
                            <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,18">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="📡 当前连接与网盘状态" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                        <Border Grid.Column="1" x:Name="SyncStatusBadge" Background="#332022" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                            <TextBlock x:Name="SyncStatusBadgeText" Text="⚠️ 未绑定云端账号" FontSize="11" Foreground="#F87171" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                    <TextBlock x:Name="SyncStatusText" Text="当前处于【本地离线模式】。所有数据已安全保存在本地高性能 SQLite 数据库中，尚未配置 Google Drive 授权。" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,0,0,14" TextWrapping="Wrap" />

                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="SyncNowBtn" Content="🔄 立即执行云端增量同步" Background="#27272A" Foreground="#FAFAFA" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="16,9" FontWeight="SemiBold" Cursor="Hand" Click="OnSyncNowClicked" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Credentials Setup Card -->
                            <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="🔑 Google Drive OAuth 2.0 凭据配置" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6" />
                                    <TextBlock Text="因数据同步涉及你的私有网盘空间，Google 要求必须使用 OAuth 2.0 客户端凭据（而非普通的静态 API Key）：" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12" />

                                    <TextBlock Text="Google Cloud OAuth 2.0 Client ID：" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                    <TextBox x:Name="GoogleClientIdInput" Background="#18181B" Foreground="#FAFAFA" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="12,8" FontSize="13" Margin="0,0,0,12" />

                                    <TextBlock Text="Google Cloud OAuth 2.0 Client Secret (密钥)：" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                    <TextBox x:Name="GoogleClientSecretInput" Background="#18181B" Foreground="#FAFAFA" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="12,8" FontSize="13" Margin="0,0,0,16" />

                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="SaveDriveConfigBtn" Content="💾 保存凭据并发起 Google 授权登录" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" Padding="18,10" FontWeight="SemiBold" FontSize="13" Cursor="Hand" Margin="0,0,12,0" Click="OnSaveDriveConfigClicked" />
                                    </StackPanel>
                                    <TextBlock x:Name="DriveConfigStatusText" Text="" FontSize="12" Foreground="#38BDF8" Margin="0,10,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 5. SETTINGS VIEW -->
                <Grid Name="SettingsView" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24" MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,0,20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                    <TextBlock Text="⚙️" FontSize="20" Margin="0,0,8,0" />
                                    <TextBlock Text="Gemini 接入模型与监督模式控制中心" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                </StackPanel>
                                <TextBlock Text="灵活切换接入的 Google AI 模型，微调监督官性格严厉度，并可配置网络反向代理，数据全部本地保存。" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,22" TextWrapping="Wrap" />

                                <!-- SECTION 1: MODEL SELECTION -->
                                <Border Background="#18181B" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,18">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="🧠 1. 接入模型版本选择 (支持 API 动态探测)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                                <TextBlock Text="可直接从 Google 官方 API 实时拉取你账号权限下的所有可用模型列表：" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1" x:Name="FetchModelsBtn" Content="🔄 联网拉取官方模型" Background="#27272A" Foreground="#38BDF8" BorderBrush="#38BDF8" BorderThickness="1" Padding="12,6" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Click="OnFetchModelsClicked" />
                                        </Grid>

                                        <TextBlock x:Name="FetchModelsStatusText" Text="" FontSize="11" Foreground="#38BDF8" Margin="0,0,0,6" />

                                        <ComboBox Name="ModelSelectCombo" SelectedIndex="0" Background="#27272A" Foreground="#FFFFFF" Padding="12,8" FontSize="13" Margin="0,0,0,12" SelectionChanged="OnModelSelectionChanged">
                                            <ComboBoxItem Content="gemini-2.5-flash (推荐 · 最新首选 · 秒级响应 · 免费额度高)" Tag="gemini-2.5-flash" />
                                            <ComboBoxItem Content="gemini-2.5-pro (最强推理 · 复杂任务拆解与深度批判)" Tag="gemini-2.5-pro" />
                                            <ComboBoxItem Content="gemini-2.0-flash (最新多模态极速模型)" Tag="gemini-2.0-flash" />
                                            <ComboBoxItem Content="gemini-1.5-pro (经典长上下文深思模型)" Tag="gemini-1.5-pro" />
                                            <ComboBoxItem Content="gemini-1.5-flash (轻量快速版本)" Tag="gemini-1.5-flash" />
                                            <ComboBoxItem Content="[自定义输入模型名称...] (手动指定专属微调或实验版本)" Tag="custom" />
                                        </ComboBox>

                                        <!-- Custom Model Name Input (shown if Custom selected) -->
                                        <StackPanel Name="CustomModelPanel" Visibility="Collapsed" Margin="0,0,0,6">
                                            <TextBlock Text="输入自定义模型 Identifier（例如 models/gemini-experimental）：" FontSize="12" Foreground="#38BDF8" Margin="0,0,0,4" />
                                            <TextBox Name="CustomModelInput" Background="#27272A" Foreground="#FAFAFA" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="10,8" FontSize="13" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- SECTION 2: API CREDENTIALS & NETWORK -->
                                <Border Background="#18181B" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="🔑 2. API 凭据与网络代理" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12" />

                                        <TextBlock Text="Google AI Studio API Key (密钥)：" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                        <TextBox Name="ApiKeyInput" Background="#27272A" Foreground="#FAFAFA" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="12,10" FontSize="13" Margin="0,0,0,14" />

                                        <TextBlock Text="自定义 API 反代 Base URL (可选，境内网络加速时填入，如 https://api.example.com)：" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                        <TextBox Name="BaseUrlInput" Background="#27272A" Foreground="#FAFAFA" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="12,8" FontSize="13" Text="https://generativelanguage.googleapis.com" Margin="0,0,0,6" />
                                    </StackPanel>
                                </Border>

                                <!-- Action buttons -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Name="SaveSettingsBtn" Content="💾 保存并应用配置" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" Padding="20,11" FontWeight="SemiBold" FontSize="13" Cursor="Hand" Margin="0,0,12,0" Click="OnSaveSettingsClicked" />
                                    <Button Name="TestApiBtn" Content="⚡ 测试当前模型联通" Background="#27272A" Foreground="#FAFAFA" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="18,11" FontSize="13" Cursor="Hand" Click="OnTestApiClicked" />
                                </StackPanel>

                                <TextBlock Name="SettingsStatusText" Text="" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- Modal: Add New Schedule Dialog -->
        <Grid x:Name="NewScheduleModal" Visibility="Collapsed" Background="#99000000" Grid.ColumnSpan="2" Panel.ZIndex="999">
            <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="📅 新建排期日程时间块" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                        <Button Grid.Column="1" Content="✕" Background="Transparent" Foreground="{StaticResource TextMuted}" BorderThickness="0" FontSize="15" FontWeight="Bold" Cursor="Hand" Click="OnCloseScheduleModalClicked" />
                    </Grid>

                    <TextBlock x:Name="NewScheduleDateLabel" Text="所属日期: 2026年10月2日" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <TextBlock Text="日程任务标题：" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                    <TextBox x:Name="NewScheduleTitleInput" Background="#18181B" Foreground="#FAFAFA" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="10,8" FontSize="13" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="开始时间 (HH:mm)：" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                            <TextBox x:Name="NewScheduleStartInput" Background="#18181B" Foreground="#FAFAFA" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="10,8" FontSize="13" Text="09:00" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="结束时间 (HH:mm)：" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                            <TextBox x:Name="NewScheduleEndInput" Background="#18181B" Foreground="#FAFAFA" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="10,8" FontSize="13" Text="10:30" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="分类标签：" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                    <ComboBox x:Name="NewScheduleCategoryCombo" SelectedIndex="0" Background="#18181B" Foreground="#FFFFFF" Padding="10,8" FontSize="13" Margin="0,0,0,12">
                        <ComboBoxItem Content="核心研发" Tag="WORK" />
                        <ComboBoxItem Content="深度学习" Tag="STUDY" />
                        <ComboBoxItem Content="日常事务" Tag="LIFE" />
                        <ComboBoxItem Content="运动健康" Tag="HEALTH" />
                        <ComboBoxItem Content="财务管理" Tag="FINANCE" />
                    </ComboBox>

                    <TextBlock Text="任务说明 / 期望成果 (可选)：" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                    <TextBox x:Name="NewScheduleDescInput" Background="#18181B" Foreground="#FAFAFA" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="10,8" FontSize="13" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,18" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Background="#27272A" Foreground="#FAFAFA" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="16,8" FontSize="13" Cursor="Hand" Margin="0,0,10,0" Click="OnCloseScheduleModalClicked" />
                        <Button Content="✅ 保存并入库" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" Padding="20,8" FontWeight="SemiBold" FontSize="13" Cursor="Hand" Click="OnSaveScheduleModalClicked" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Modal: Google Calendar iCal Sync Dialog -->
        <Grid x:Name="GoogleCalendarSyncModal" Visibility="Collapsed" Background="#99000000" Grid.ColumnSpan="2" Panel.ZIndex="999">
            <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📅" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="Google Calendar 日历同步配置" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Background="Transparent" Foreground="{StaticResource TextMuted}" BorderThickness="0" FontSize="15" FontWeight="Bold" Cursor="Hand" Click="OnCloseGoogleCalendarConfigClicked" />
                    </Grid>

                    <!-- Instructions -->
                    <Border Background="#18181B" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="💡 如何获取 Google Calendar 订阅地址？" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,0,0,6" />
                            <TextBlock Text="1. 在浏览器打开 Google Calendar (calendar.google.com)" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,2" />
                            <TextBlock Text="2. 在左侧「我的日历」找到你的日历，点击右侧「⋮」选择「设置与共享」" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,2" />
                            <TextBlock Text="3. 页面滚动到底部「整合日历」，复制「iCal 格式的私密地址」" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,2" />
                            <TextBlock Text="4. 将以 basic.ics 结尾的链接粘贴至下方即可自动同步：" FontSize="11" Foreground="{StaticResource TextSecondary}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Google Calendar 私密 iCal 订阅地址：" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                    <TextBox x:Name="GoogleCalendarIcsInput" Background="#18181B" Foreground="#FAFAFA" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="10,8" FontSize="12" Margin="0,0,0,8" />

                    <TextBlock x:Name="GoogleCalendarSyncModalStatus" Text="" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="解除同步 (恢复纯本地)" Background="Transparent" Foreground="#EF4444" BorderThickness="0" Cursor="Hand" FontSize="12" Click="OnDisconnectGoogleCalendarClicked" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="取消" Background="#27272A" Foreground="#FAFAFA" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="16,8" FontSize="13" Cursor="Hand" Margin="0,0,10,0" Click="OnCloseGoogleCalendarConfigClicked" />
                            <Button x:Name="SaveGoogleCalSyncBtn" Content="💾 保存并立即同步" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" Padding="18,8" FontWeight="SemiBold" FontSize="13" Cursor="Hand" Click="OnSaveGoogleCalendarSyncClicked" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
