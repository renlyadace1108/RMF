                                    </StackPanel>
                                    <Slider x:Name="RgbSliderR" Grid.Column="1" Minimum="0" Maximum="255" SmallChange="1" LargeChange="10" Value="26" VerticalAlignment="Center" Margin="8,0" ValueChanged="OnRgbSliderValueChanged" />
                                    <TextBox x:Name="RgbInputR" Grid.Column="2" Text="26" FontSize="12" Padding="6,3" TextAlignment="Center" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" TextChanged="OnRgbInputTextChanged" />
                                </Grid>

                                <!-- G 通道 (绿色) -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
