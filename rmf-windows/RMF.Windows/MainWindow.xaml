                            <TextBox x:Name="StudyTopicTargetHoursInput" Text="20" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,6" FontSize="12" TextChanged="OnStudyTopicTargetValueChanged" />
