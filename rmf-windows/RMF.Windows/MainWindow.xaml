                                            <Border x:Name="FocusLiveBadge" Background="#26334D" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="FocusLiveBadgeText" Text="⚪ 胶囊未启动" FontSize="10.5" Foreground="#94A3B8" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="FocusLiveBringHudBtn" Content="🪟 呼出置顶" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="10,4" FontSize="11" Margin="0,0,6,0" Click="OnFocusPageBringHudToFrontClicked" ToolTip="将桌面悬浮胶囊置于最前台" />
                                            <Button x:Name="FocusLivePauseBtn" Content="⏸ 暂停/继续" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="10,4" FontSize="11" Margin="0,0,6,0" Click="OnFocusPageTogglePauseClicked" ToolTip="暂停或继续胶囊计时" />
                                            <Button x:Name="FocusLiveFinishBtn" Content="✔ 完成结算" Style="{StaticResource GoogleActionBtnStyle}" Padding="12,4" FontSize="11" FontWeight="SemiBold" Click="OnFocusPageFinishSessionClicked" ToolTip="结束专注并反哺学时与目标" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Live Bound Schedule Banner -->
                                    <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="当前绑定日程" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                                <TextBlock x:Name="FocusLiveBoundTitle" Text="暂无运行中的专注任务，请在下方选择日程绑定启动" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                                <TextBlock x:Name="FocusLiveBoundDodInfo" Text="验收标准 DoD: 0/0 已完成" FontSize="11" Foreground="#38BDF8" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock x:Name="FocusLiveTimerLarge" Text="25:00" FontSize="26" FontWeight="Bold" Foreground="#38BDF8" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Right" />
                                                <TextBlock x:Name="FocusLiveModeIndicator" Text="番茄倒计时模式" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Schedule & Task Binding Pool Card -->
                            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                                <StackPanel>
                                    <!-- Title & Filter Bar -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="关联日程" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <RadioButton x:Name="FocusTabTodaySchedulesRadio" Content="今日日程" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="0,0,10,0" VerticalAlignment="Center" Checked="OnFocusBindingTabChanged" />
                                            <RadioButton x:Name="FocusTabBacklogRadio" Content="待办任务" Foreground="{DynamicResource TextPrimary}" Margin="0,0,10,0" VerticalAlignment="Center" Checked="OnFocusBindingTabChanged" />
                                            <RadioButton x:Name="FocusTabStudyRadio" Content="学习主题" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Checked="OnFocusBindingTabChanged" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Quick Custom Focus Launcher Bar -->
                                    <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="FocusQuickCustomTitleInput" Background="Transparent" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" FontSize="12" VerticalAlignment="Center" Padding="4,2" TextChanged="OnFocusQuickCustomTitleChanged" />
                                            <TextBlock x:Name="FocusQuickCustomTitlePlaceholder" Text="任务名称..." FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" IsHitTestVisible="False" Margin="4,0,0,0" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                                                <TextBox x:Name="FocusQuickCustomMinsInput" Text="25" Width="36" Background="{DynamicResource ControlBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" HorizontalContentAlignment="Center" VerticalAlignment="Center" Padding="2" FontSize="11" />
                                                <TextBlock Text="分钟" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Content="开始专注" Style="{StaticResource GoogleActionBtnStyle}" Padding="12,5" FontSize="11.5" FontWeight="SemiBold" Click="OnFocusQuickCustomLaunchClicked" />
                                        </Grid>
                                    </Border>

                                    <!-- Binding Items List Container -->
                                    <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Hidden">
                                        <StackPanel x:Name="FocusBindableItemsPanel" />
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right Column: Focus Duration Settings & Interruption / Integrity Audit -->
                        <StackPanel Grid.Column="1">

                            <!-- Focus Duration & Preferences Card -->
                            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="专注设置" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12" />

                                    <!-- 1. Default Focus Duration -->
                                    <TextBlock Text="专注时长" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6" />
                                    <WrapPanel Margin="0,0,0,8">
                                        <Button Content="15m" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="10,4" FontSize="11" Margin="0,0,6,6" Click="OnFocusPresetDurationClicked" Tag="15" />
                                        <Button Content="25m" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="10,4" FontSize="11" Margin="0,0,6,6" Click="OnFocusPresetDurationClicked" Tag="25" />
                                        <Button Content="30m" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="10,4" FontSize="11" Margin="0,0,6,6" Click="OnFocusPresetDurationClicked" Tag="30" />
                                        <Button Content="45m" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="10,4" FontSize="11" Margin="0,0,6,6" Click="OnFocusPresetDurationClicked" Tag="45" />
                                        <Button Content="60m" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="10,4" FontSize="11" Margin="0,0,6,6" Click="OnFocusPresetDurationClicked" Tag="60" />
                                        <Button Content="90m" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="10,4" FontSize="11" Margin="0,0,6,6" Click="OnFocusPresetDurationClicked" Tag="90" />
                                    </WrapPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="自定义时长 (分钟):" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" x:Name="FocusSettingCustomMinsInput" Width="60" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" HorizontalContentAlignment="Center" Padding="4,3" FontSize="11" Text="25" />
                                    </Grid>

                                    <!-- 2. Break Duration -->
                                    <TextBlock Text="休息时长" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6" />
                                    <WrapPanel Margin="0,0,0,8">
                                        <Button Content="5m 短休" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="10,4" FontSize="11" Margin="0,0,6,6" Click="OnFocusPresetBreakClicked" Tag="5" />
                                        <Button Content="10m 标准" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="10,4" FontSize="11" Margin="0,0,6,6" Click="OnFocusPresetBreakClicked" Tag="10" />
                                        <Button Content="15m 长休" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="10,4" FontSize="11" Margin="0,0,6,6" Click="OnFocusPresetBreakClicked" Tag="15" />
                                    </WrapPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="自定义休息 (分钟):" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" x:Name="FocusSettingBreakMinsInput" Width="60" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" HorizontalContentAlignment="Center" Padding="4,3" FontSize="11" Text="5" />
                                    </Grid>

                                    <!-- 3. Timer Mode Selection -->
                                    <TextBlock Text="计时模式" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                        <RadioButton x:Name="FocusModePomodoroRadio" Content="⏱ 番茄倒计时" IsChecked="True" Foreground="{DynamicResource TextPrimary}" Margin="0,0,16,0" />
                                        <RadioButton x:Name="FocusModeStopwatchRadio" Content="⏲ 正向秒表" Foreground="{DynamicResource TextPrimary}" />
                                    </StackPanel>

                                    <!-- 4. Anti-Cheat Idle Threshold -->
                                    <TextBlock Text="无操作自动暂停" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6" />
                                    <WrapPanel Margin="0,0,0,14">
                                        <Button Content="3 分钟" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="10,4" FontSize="11" Margin="0,0,6,6" Click="OnFocusPresetIdleClicked" Tag="3" />
                                        <Button Content="5 分钟 (推荐)" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="10,4" FontSize="11" Margin="0,0,6,6" Click="OnFocusPresetIdleClicked" Tag="5" />
                                        <Button Content="10 分钟" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="10,4" FontSize="11" Margin="0,0,6,6" Click="OnFocusPresetIdleClicked" Tag="10" />
                                    </WrapPanel>

                                    <!-- Save Button -->
                                    <Button Content="保存设置" Style="{StaticResource GoogleActionBtnStyle}" Padding="16,8" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Stretch" Click="OnFocusSaveConfigClicked" />
                                </StackPanel>
                            </Border>

                            <!-- Today Interruptions & Anti-Cheat Audit Card -->
                            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="打断记录" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock x:Name="FocusInterruptionCountBadge" Grid.Column="1" Text="0 次打断" FontSize="11" Foreground="#F59E0B" />
                                    </Grid>

                                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Hidden">
                                        <StackPanel x:Name="FocusInterruptionLogsPanel" />
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Grid>

    <!-- ================= 2. SCHEDULE SUMMARY & RETROSPECTIVE PAGE ================= -->
                <Grid x:Name="SummaryPageContainer" Visibility="Collapsed" Background="{DynamicResource GoogleSurface}">
                    <ScrollViewer x:Name="SummaryScrollViewer" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Padding="20,16,20,24">
                        <StackPanel HorizontalAlignment="Stretch">

                            <!-- 0. Header & Badges Row -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <WrapPanel VerticalAlignment="Center">
                                        <TextBlock Text="📊" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="统计" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,14,0" />
                                        <!-- Streak Badge -->
                                        <Border Background="#3B2314" BorderBrush="#EA580C" BorderThickness="1" CornerRadius="12" Padding="8,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="SummaryStreakBadgeText" Text="🔥 连续专注 5 天" FontSize="11" FontWeight="SemiBold" Foreground="#FB923C" />
                                        </Border>
                                        <!-- Karma / Level Badge -->
                                        <Border Background="#2E1065" BorderBrush="#7C3AED" BorderThickness="1" CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock x:Name="SummaryKarmaBadgeText" Text="⚡ 效能积分: 890" FontSize="11" FontWeight="SemiBold" Foreground="#C084FC" />
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="🔄 刷新数据" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="12,6" FontSize="12" Click="OnRefreshSummaryClicked" Margin="0,0,8,0" />
                                    <Button Content="➕ 新建日程" Style="{StaticResource GoogleActionBtnStyle}" Padding="14,6" FontSize="12" FontWeight="SemiBold" Click="OnGoogleCreateClicked" />
                                </StackPanel>
                            </Grid>

                            <!-- 1. Period Selector & Navigation Bar (滴答清单 / Todoist 核心风格) -->
                            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Capsule Period Switcher -->
                                    <Border Grid.Column="0" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="3">
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="SummaryPeriodBtnDay" Content="今日" Style="{StaticResource GoogleTopBtnStyle}" Padding="10,3" FontSize="11" Click="OnSummaryPeriodSelectDay" />
                                            <Button x:Name="SummaryPeriodBtnWeek" Content="本周" Style="{StaticResource GoogleTopBtnStyle}" Background="{DynamicResource AccentBlue}" Foreground="#FFFFFF" Padding="10,3" FontSize="11" FontWeight="SemiBold" Click="OnSummaryPeriodSelectWeek" />
                                            <Button x:Name="SummaryPeriodBtnMonth" Content="本月" Style="{StaticResource GoogleTopBtnStyle}" Padding="10,3" FontSize="11" Click="OnSummaryPeriodSelectMonth" />
                                            <Button x:Name="SummaryPeriodBtn30Days" Content="近30天" Style="{StaticResource GoogleTopBtnStyle}" Padding="10,3" FontSize="11" Click="OnSummaryPeriodSelect30Days" />
                                            <Button x:Name="SummaryPeriodBtnAll" Content="全部" Style="{StaticResource GoogleTopBtnStyle}" Padding="10,3" FontSize="11" Click="OnSummaryPeriodSelectAll" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Date Range Navigation (< range > 今天) -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Button Content="‹" Style="{StaticResource GoogleTopBtnStyle}" Width="28" Height="28" Padding="0" FontSize="15" FontWeight="Bold" Margin="0,0,8,0" Click="OnSummaryPeriodPrevClicked" ToolTip="上一周期" />
                                        <TextBlock x:Name="SummaryPeriodRangeText" Text="2026年9月28日 - 10月4日 (第40周)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="4,0,8,0" />
                                        <Button Content="›" Style="{StaticResource GoogleTopBtnStyle}" Width="28" Height="28" Padding="0" FontSize="15" FontWeight="Bold" Margin="0,0,8,0" Click="OnSummaryPeriodNextClicked" ToolTip="下一周期" />
                                        <Button Content="今天" Style="{StaticResource GoogleTopBtnStyle}" Padding="8,3" FontSize="11" Click="OnSummaryPeriodTodayClicked" ToolTip="返回当前周期" />
                                    </StackPanel>

                                    <!-- Quick Summary Note & Export Actions -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="SummaryPeriodBriefText" Text="周维度专注分析" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <Button Content="📊 导出海报" Style="{StaticResource GoogleTopBtnStyle}" Background="#1E3A8A" Foreground="#93C5FD" BorderThickness="1" BorderBrush="#3B82F6" Padding="8,4" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0" ToolTip="导出统计长图海报" Click="OnExportWeeklyAuditPosterClicked" />
                                        <Button Content="📝 复制数据" Style="{StaticResource GoogleTopBtnStyle}" Background="{DynamicResource ControlBackground}" Foreground="{DynamicResource TextPrimary}" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Padding="8,4" FontSize="11" ToolTip="复制结构化 Markdown 审计数据" Click="OnExportWeeklyAuditMarkdownClicked" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 2. KPI Cards (4 Cards) -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Card 1: Total & Completion -->
                                <Border Grid.Column="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="任务交付完成率" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock x:Name="SummaryCompletionRateText" Text="0.0%" FontSize="22" FontWeight="Bold" Foreground="#34D399" Margin="0,4,0,2" />
                                        <ProgressBar x:Name="SummaryCompletionProgressBar" Height="4" Maximum="100" Value="0" Background="{DynamicResource ControlBackground}" Foreground="#34D399" Margin="0,2,0,4" />
                                        <TextBlock x:Name="SummaryCompletedTasksText" Text="已完成 0 项 / 总 0 项" FontSize="11" Foreground="#059669" />
                                    </StackPanel>
                                </Border>

                                <!-- Card 2: Total Hours & Daily Average -->
                                <Border Grid.Column="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="累计专注投入工时" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock x:Name="SummaryTotalHoursText" Text="0.0 h" FontSize="22" FontWeight="Bold" Foreground="#FBBF24" Margin="0,4,0,2" />
                                        <TextBlock x:Name="SummaryDeepWorkHoursText" Text="深度: 0.0 h · 浅层: 0.0 h" FontSize="11" Foreground="#D97706" />
                                        <TextBlock x:Name="SummaryDailyAvgHoursText" Text="日均专注: 0.0 h/天" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Card 3: Deep Work Purity -->
                                <Border Grid.Column="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="深度工作" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock x:Name="SummaryDeepPurityRateText" Text="0.0%" FontSize="22" FontWeight="Bold" Foreground="#A78BFA" Margin="0,4,0,2" />
                                        <ProgressBar x:Name="SummaryDeepPurityProgressBar" Height="4" Maximum="100" Value="0" Background="{DynamicResource ControlBackground}" Foreground="#A78BFA" Margin="0,2,0,4" />
                                        <TextBlock x:Name="SummaryDeepWorkRatioDescText" Text="" FontSize="11" Foreground="#7C3AED" Visibility="Collapsed" />
                                    </StackPanel>
                                </Border>

                                <!-- Card 4: DoD Acceptance Rate -->
                                <Border Grid.Column="3" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="DoD 验收达标率" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock x:Name="SummaryDodRateText" Text="0.0%" FontSize="22" FontWeight="Bold" Foreground="#C084FC" Margin="0,4,0,2" />
                                        <ProgressBar x:Name="SummaryDodProgressBar" Height="4" Maximum="100" Value="0" Background="{DynamicResource ControlBackground}" Foreground="#C084FC" Margin="0,2,0,4" />
                                        <TextBlock x:Name="SummaryDodCountText" Text="含验收: 0 项 · 达成 0 项" FontSize="11" Foreground="#9333EA" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 3. 每日 24 小时全景作息时钟图 (24-Hour Circular Timeline) -->
                            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                     <!-- Clock Header: Title + Date Navigator + Summary Tag -->
                                    <Grid Grid.Row="0" Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="24小时作息" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Date Switcher Controls -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="‹" Style="{StaticResource GoogleTopBtnStyle}" Width="28" Height="28" Padding="0" FontSize="14" FontWeight="Bold" Click="OnDailyClockPrevDayClicked" ToolTip="前一天" />
                                            <DatePicker x:Name="DailyClockDatePicker" Background="{DynamicResource ControlBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Height="28" FontSize="11" Margin="6,0" SelectedDateChanged="OnDailyClockDatePickerChanged" />
                                            <Button Content="›" Style="{StaticResource GoogleTopBtnStyle}" Width="28" Height="28" Padding="0" FontSize="14" FontWeight="Bold" Click="OnDailyClockNextDayClicked" ToolTip="后一天" Margin="0,0,6,0" />
                                            <Button Content="今天" Style="{StaticResource GoogleTopBtnStyle}" Padding="8,3" FontSize="11" Click="OnDailyClockTodayClicked" ToolTip="返回今日" Margin="0,0,10,0" />
                                            <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                                <TextBlock x:Name="DailyClockSummaryTag" Text="当日排期 0 项 · 0.0h" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                     <!-- Clock Body: 24h Circular Dial (Left) + Chronological Schedule List (Right) -->
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="460" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Left Column: Circular Clock Vector Dial (Enlarged) -->
                                        <Border Grid.Column="0" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <!-- Vector Canvas for 24-Hour Dial, Ticks, Arcs & Needle -->
                                                <Canvas x:Name="DailyClockCanvas" Width="420" Height="420" ClipToBounds="False">
                                                    <Canvas.CacheMode>
                                                        <BitmapCache EnableClearType="True" SnapsToDevicePixels="True" />
                                                    </Canvas.CacheMode>
                                                </Canvas>

                                                <!-- Center Disc Info Box -->
                                                <Border Width="150" Height="150" CornerRadius="75" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock x:Name="DailyClockCenterTitleText" Text="全天作息" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
                                                        <TextBlock x:Name="DailyClockCenterHoursText" Text="0.0 h" FontSize="22" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" Margin="0,3,0,3" />
                                                        <TextBlock x:Name="DailyClockCenterTasksText" Text="0 项日程" FontSize="11" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
                                                        <TextBlock x:Name="DailyClockCenterHoverText" Text="" FontSize="10" Foreground="#34D399" HorizontalAlignment="Center" MaxWidth="125" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <!-- Right Column: Chronological Schedules Breakdown List -->
                                        <Border Grid.Column="2" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="全天事项" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" x:Name="DailyClockDetailsStatusText" Text="" Visibility="Collapsed" />
                                                </Grid>

                                                <ScrollViewer Grid.Row="1" x:Name="DailyClockScrollViewer" MaxHeight="380" VerticalScrollBarVisibility="Hidden">
                                                    <StackPanel x:Name="DailyClockItemsListPanel">
                                                        <!-- Populated dynamically with time block cards -->
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- 4. Visual Analytics Matrix (多维分析图表矩阵: 交付走势 + 环形占比 + 24h时段热力) -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.1*" />
                                </Grid.ColumnDefinitions>

                                 <!-- Card 1: 周期交付走势柱状图 (7-Day / Period Trend) -->
                                <Border Grid.Column="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,10,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="140" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                            <TextBlock Text="完成走势" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock x:Name="SummaryTrendSubtitleText" Text="" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <UniformGrid Grid.Row="1" x:Name="SummaryTrendBarsGrid" Columns="7" Margin="0,0,0,4" />
                                        <Border Grid.Row="2" Visibility="Collapsed">
                                            <TextBlock x:Name="SummaryTrendInsightText" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Card 2: 分类工时环形图 (Category Donut Chart) -->
                                <Border Grid.Column="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,10,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="140" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                            <TextBlock Text="分类占比" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                        </StackPanel>

                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Vector Donut Canvas + Center Label -->
                                            <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Canvas x:Name="CategoryDonutCanvas" Width="110" Height="110">
                                                    <Canvas.CacheMode>
                                                        <BitmapCache EnableClearType="True" SnapsToDevicePixels="True" />
                                                    </Canvas.CacheMode>
                                                </Canvas>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="总工时" FontSize="9" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
                                                    <TextBlock x:Name="CategoryDonutTotalHoursText" Text="0.0h" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>

                                            <!-- Legends Beside Donut (Direct stackpanel, no scroll trap) -->
                                            <StackPanel x:Name="SummaryCategoryLegendPanel" Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0" />
                                        </Grid>

                                        <Border Grid.Row="2" Visibility="Collapsed">
                                            <TextBlock x:Name="CategoryDonutInsightText" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Card 3: 24小时专注时段热力分布 (Hourly Focus Heatmap Bar Chart) -->
                                <Border Grid.Column="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="140" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                                            <TextBlock Text="时段热力" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                        </StackPanel>

                                        <!-- 24-Hour Bar Chart + Peak Badges -->
                                        <Grid Grid.Row="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="16" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- 24 Bars -->
                                            <UniformGrid Grid.Row="0" x:Name="HourlyActivityBarsGrid" Columns="24" Margin="0,0,0,2" />

                                            <!-- Axis Labels -->
                                            <Grid Grid.Row="1">
                                                <TextBlock Text="0h" FontSize="9" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Left" />
                                                <TextBlock Text="6h" FontSize="9" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Left" Margin="60,0,0,0" />
                                                <TextBlock Text="12h" FontSize="9" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" />
                                                <TextBlock Text="18h" FontSize="9" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" Margin="0,0,60,0" />
                                                <TextBlock Text="24h" FontSize="9" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" />
                                            </Grid>

                                            <!-- Golden Peak Hours Summary Row -->
                                            <Grid Grid.Row="2" Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" x:Name="SummaryMorningHoursText" Text="早间 0.0h" FontSize="9" Foreground="#60A5FA" />
                                                <TextBlock Grid.Column="1" x:Name="SummaryAfternoonHoursText" Text="午间 0.0h" FontSize="9" Foreground="#FBBF24" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="2" x:Name="SummaryEveningHoursText" Text="晚间 0.0h" FontSize="9" Foreground="#A78BFA" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Grid>

                                        <Border Grid.Row="2" Visibility="Collapsed">
                                            <TextBlock x:Name="SummaryPeakHourInsightText" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- 4. Filter Toolbar -->
                            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Status Filter -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="状态：" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox x:Name="SummaryStatusCombo" Background="{DynamicResource ControlBackground}" Foreground="{DynamicResource TextPrimary}" Padding="8,4" FontSize="12" Width="100" SelectionChanged="OnSummaryFilterChanged">
                                            <ComboBoxItem Content="全部状态" IsSelected="True" Tag="ALL" />
                                            <ComboBoxItem Content="已完成" Tag="COMPLETED" />
                                            <ComboBoxItem Content="进行中" Tag="IN_PROGRESS" />
                                            <ComboBoxItem Content="待进行" Tag="PENDING" />
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Category Filter -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="分类：" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox x:Name="SummaryCategoryCombo" Background="{DynamicResource ControlBackground}" Foreground="{DynamicResource TextPrimary}" Padding="8,4" FontSize="12" Width="105" SelectionChanged="OnSummaryFilterChanged">
                                            <ComboBoxItem Content="全部分类" IsSelected="True" Tag="ALL" />
                                            <ComboBoxItem Content="工作 (WORK)" Tag="WORK" />
                                            <ComboBoxItem Content="学习 (STUDY)" Tag="STUDY" />
                                            <ComboBoxItem Content="生活 (LIFE)" Tag="LIFE" />
                                            <ComboBoxItem Content="健康 (HEALTH)" Tag="HEALTH" />
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- WorkType Filter -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="认知负荷：" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox x:Name="SummaryWorkTypeCombo" Background="{DynamicResource ControlBackground}" Foreground="{DynamicResource TextPrimary}" Padding="8,4" FontSize="12" Width="105" SelectionChanged="OnSummaryFilterChanged">
                                            <ComboBoxItem Content="全部类型" IsSelected="True" Tag="ALL" />
                                            <ComboBoxItem Content="🎯 深度工作" Tag="DEEP_WORK" />
                                            <ComboBoxItem Content="⚡ 浅层事务" Tag="SHALLOW_WORK" />
                                            <ComboBoxItem Content="☕ 缓冲休息" Tag="REST_BUFFER" />
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Keyword Search -->
                                    <Border Grid.Column="3" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" Width="220">
                                        <Grid>
                                            <TextBlock Text="🔍 搜索日程/DoD..." FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="4,0,0,0" IsHitTestVisible="False" Visibility="{Binding Text.IsEmpty, ElementName=SummarySearchInput, Converter={StaticResource BoolToVis}}" />
                                            <TextBox x:Name="SummarySearchInput" Background="Transparent" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" FontSize="12" Padding="2" TextChanged="OnSummarySearchInputChanged" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- 5. Schedules Review List (TickTick / Todoist Style Cards) -->
                            <StackPanel x:Name="SummaryItemsListPanel">
                                <!-- Dynamic Rendered Schedule Summary Cards -->
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ================= 3. STUDY & KNOWLEDGE MANAGEMENT PAGE ================= -->
                <Grid x:Name="StudyPageContainer" Visibility="Collapsed" Background="{DynamicResource GoogleSurface}" Margin="16,14,16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Top Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📚" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="学习" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="🔄 刷新" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="14,6" FontSize="12" Click="OnRefreshStudyClicked" Margin="0,0,8,0" />
                            <Button Content="➕ 新建主题" Style="{StaticResource GoogleActionBtnStyle}" Padding="16,6" FontSize="12" FontWeight="SemiBold" Click="OnCreateStudyTopicClicked" />
                        </StackPanel>
                    </Grid>

                    <!-- Row 1: Executive KPI Cards (4 Cards) -->
                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Active Topics -->
                        <Border Grid.Column="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="正在攻克主题" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock x:Name="StudyActiveTopicsText" Text="0 个" FontSize="22" FontWeight="Bold" Foreground="#8AB4F8" Margin="0,4,0,2" />
                                <TextBlock x:Name="StudyTotalTopicsText" Text="全量档案: 0 个主题" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Accumulated Study Hours -->
                        <Border Grid.Column="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="累计打卡学时" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock x:Name="StudyTotalHoursText" Text="0.0 小时" FontSize="22" FontWeight="Bold" Foreground="#34D399" Margin="0,4,0,2" />
                                <TextBlock x:Name="StudyTargetHoursText" Text="总目标学时: 0.0 h" FontSize="11" Foreground="#059669" />
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Average Progress -->
                        <Border Grid.Column="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="整体平均进度" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock x:Name="StudyAvgProgressText" Text="0.0%" FontSize="22" FontWeight="Bold" Foreground="#FBBF24" Margin="0,4,0,2" />
                                <ProgressBar x:Name="StudyAvgProgressBar" Height="4" Maximum="100" Value="0" Background="{DynamicResource ControlBackground}" Foreground="#FBBF24" Margin="0,2,0,2" />
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Completed Topics -->
                        <Border Grid.Column="3" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="已结业主题" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock x:Name="StudyCompletedTopicsText" Text="0 个" FontSize="22" FontWeight="Bold" Foreground="#C084FC" Margin="0,4,0,2" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Row 2: Filter Toolbar -->
                    <Border Grid.Row="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Category Filter -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="分类领域：" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox x:Name="StudyCategoryFilterCombo" Background="{DynamicResource ControlBackground}" Foreground="{DynamicResource TextPrimary}" Padding="8,4" FontSize="12" Width="120" SelectionChanged="OnStudyFilterChanged">
                                    <ComboBoxItem Content="全部分类" IsSelected="True" Tag="ALL" />
                                    <ComboBoxItem Content="技术栈" Tag="技术栈" />
                                    <ComboBoxItem Content="计算机基础" Tag="计算机基础" />
                                    <ComboBoxItem Content="外语" Tag="外语" />
                                    <ComboBoxItem Content="读书精读" Tag="读书精读" />
                                    <ComboBoxItem Content="资格考证" Tag="资格考证" />
                                    <ComboBoxItem Content="兴趣" Tag="兴趣" />
                                </ComboBox>
                            </StackPanel>

                            <!-- Status Filter -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="状态：" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox x:Name="StudyStatusFilterCombo" Background="{DynamicResource ControlBackground}" Foreground="{DynamicResource TextPrimary}" Padding="8,4" FontSize="12" Width="100" SelectionChanged="OnStudyFilterChanged">
                                    <ComboBoxItem Content="全部状态" IsSelected="True" Tag="ALL" />
                                    <ComboBoxItem Content="进行中" Tag="IN_PROGRESS" />
                                    <ComboBoxItem Content="已结业" Tag="COMPLETED" />
                                    <ComboBoxItem Content="未开始" Tag="NOT_STARTED" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 3: Topics List / Grid Container (Hidden scrollbar) -->
                    <Border Grid.Row="3" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <ScrollViewer x:Name="StudyTopicsScrollViewer" VerticalScrollBarVisibility="Hidden">
                            <StackPanel x:Name="StudyTopicsPanel">
                                <!-- Dynamic Rendered Study Topic Cards -->
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ================= 3.5. FITNESS & WORKOUT WORKSPACE (每日健身计划与记录) ================= -->
                <Grid x:Name="FitnessPageContainer" Visibility="Collapsed" Background="{DynamicResource GoogleSurface}">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Top Header & Date Stepper & Actions -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: KPI Statistics Banner -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 2: Main Two-Column Layout (Left: Exercises Checklist, Right: History Logs) -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Top Header & Date Stepper & Action Buttons -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="20,12,20,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Title & Subtitle -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🏋️" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="每日健身计划与训练追踪" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="定制分化力量与有氧训练 · 组数负重打卡 · 连续坚持与消耗统计" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Center: Date Stepper (< 今天 >) -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Button Content="‹" Style="{StaticResource GoogleTopBtnStyle}" Width="28" Height="28" Padding="0" FontSize="16" FontWeight="Bold" Margin="0,0,4,0" Click="OnFitnessPrevDayClicked" ToolTip="上一天" />
                                <Button x:Name="FitnessTodayBtn" Content="今天" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="10,3" FontSize="11" FontWeight="SemiBold" Margin="0,0,4,0" Click="OnFitnessTodayClicked" ToolTip="返回今日" />
                                <Button Content="›" Style="{StaticResource GoogleTopBtnStyle}" Width="28" Height="28" Padding="0" FontSize="16" FontWeight="Bold" Margin="0,0,8,0" Click="OnFitnessNextDayClicked" ToolTip="下一天" />
                                <TextBlock x:Name="FitnessDateRangeText" Text="2026年10月9日 星期五" FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Right: Actions -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="🔄 刷新" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="10,5" FontSize="12" Click="OnRefreshFitnessClicked" Margin="0,0,8,0" />
                                <Button Content="⚡ 载入模版" Style="{StaticResource GoogleTopBtnStyle}" Padding="10,5" FontSize="12" Click="OnFitnessTemplateMenuClicked" Margin="0,0,8,0" ToolTip="快速应用推拉腿分化或高燃有氧模版" />
                                <Button Content="📅 投影至日程" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="10,5" FontSize="12" Click="OnFitnessProjectToScheduleClicked" Margin="0,0,8,0" ToolTip="将今日健身计划同步到日程时间流中" />
                                <Button Content="➕ 定制计划" Style="{StaticResource GoogleTopBtnStyle}" Padding="10,5" FontSize="12" Click="OnFitnessCreatePlanClicked" Margin="0,0,8,0" ToolTip="创建或修改当日训练主题" />
                                <Button x:Name="FitnessFinishWorkoutBtn" Content="🎉 打卡结算" Style="{StaticResource GoogleActionBtnStyle}" Padding="14,6" FontSize="12" FontWeight="SemiBold" Click="OnFitnessFinishWorkoutClicked" ToolTip="完成今日训练并记录体能数据" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 1: KPI Statistics Banner -->
                    <Border Grid.Row="1" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="20,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Card 1: 今日主题与状态 -->
                            <Border Grid.Column="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                <StackPanel>
                                    <TextBlock Text="今日训练主题" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock x:Name="FitnessStatusKpiText" Text="未设定计划" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <!-- Card 2: 组数完成进度 -->
                            <Border Grid.Column="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                <StackPanel>
                                    <TextBlock Text="完成组数进度" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock x:Name="FitnessDoneRatioKpiText" Text="✓ 0/0 组" FontSize="14" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Card 3: 今日总训练容量 -->
                            <Border Grid.Column="4" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                <StackPanel>
                                    <TextBlock Text="今日总训练容量" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock x:Name="FitnessVolumeKpiText" Text="⚡ 0 kg" FontSize="14" FontWeight="Bold" Foreground="#38BDF8" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Card 4: 连续打卡与周统计 -->
                            <Border Grid.Column="6" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                <StackPanel>
                                    <TextBlock Text="连续运动 / 周统计" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock x:Name="FitnessStreakKpiText" Text="🔥 0 天 · 0m" FontSize="14" FontWeight="Bold" Foreground="#F59E0B" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Row 2: Main Two-Column Layout -->
                    <Grid Grid.Row="2">
                        <Grid Margin="20,14,20,16">
                            <Grid.ColumnDefinitions>
                                <!-- Column 0: Left - Today's Exercises Checklist -->
                                <ColumnDefinition Width="1.35*" />
                                <ColumnDefinition Width="16" />
                                <!-- Column 1: Right - History Workout Logs -->
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Column: Today's Exercise Plan & Checklist -->
                            <Border Grid.Column="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📋" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock x:Name="FitnessExerciseListHeader" Text="今日训练动作清单" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="➕ 添加动作" Style="{StaticResource GoogleActionBtnStyle}" Padding="10,4" FontSize="11" FontWeight="SemiBold" Click="OnFitnessAddExerciseClicked" />
                                    </Grid>

                                    <!-- Exercises ScrollViewer -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                                        <StackPanel x:Name="FitnessExercisesListPanel">
                                            <!-- Dynamically generated exercise cards -->
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>

                            <!-- Right Column: History Workout Logs -->
                            <Border Grid.Column="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🏆" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <TextBlock Text="历史训练日志" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="近 14 天" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- History ScrollViewer -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                                        <StackPanel x:Name="FitnessHistoryListPanel">
                                            <!-- Dynamically generated history workout logs -->
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Floating Rest Timer Dock -->
                        <Border x:Name="FitnessRestTimerDock" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24" Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1.5" CornerRadius="24" Padding="16,8" Panel.ZIndex="100">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.45" Color="Black" />
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⏱️" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="组间休息:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock x:Name="FitnessRestTimerText" Text="01:30" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <ProgressBar x:Name="FitnessRestTimerProgress" Width="100" Height="6" Value="100" Maximum="100" Foreground="#38BDF8" Background="#334155" BorderThickness="0" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <Button Content="-15s" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="7,2" FontSize="10.5" Margin="0,0,4,0" Click="OnFitnessTimerSub15Clicked" />
                                <Button Content="+30s" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="7,2" FontSize="10.5" Margin="0,0,4,0" Click="OnFitnessTimerAdd30Clicked" />
                                <Button x:Name="FitnessTimerPauseResumeBtn" Content="暂停" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="7,2" FontSize="10.5" Margin="0,0,4,0" Click="OnFitnessTimerPauseResumeClicked" />
                                <Button Content="跳过 ✕" Style="{StaticResource GoogleActionBtnStyle}" Padding="8,2" FontSize="10.5" Click="OnFitnessTimerSkipClicked" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ================= 4. TIMETABLE PAGE (WAKEUP 课程表) ================= -->
                <Grid x:Name="TimetablePageContainer" Visibility="Collapsed" Background="{DynamicResource GoogleSurface}">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Top Header & Week Selector & Actions -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Horizontal Scrollable Week Number Capsules Bar -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 2: Matrix Timetable Grid -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Top Header & Current Week & Actions -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="20,12,20,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Title & Semester & Quick Week Stepper -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🎓" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TimetableCurrentWeekTitle" Text="第 5 周" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                        <Border x:Name="TimetableIsCurrentWeekBadge" Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="10" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="本周" FontSize="10" FontWeight="SemiBold" Foreground="#34D399" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="TimetableSemesterSubtitle" Text="2026年秋季学期 · 全20周" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                                </StackPanel>

                                <!-- Stepper: < 本周 > -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="‹" Style="{StaticResource GoogleTopBtnStyle}" Width="28" Height="28" Padding="0" FontSize="16" FontWeight="Bold" Margin="0,0,4,0" Click="OnTimetablePrevWeekClicked" ToolTip="上一周" />
                                    <Button Content="本周" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="10,3" FontSize="11" FontWeight="SemiBold" Margin="0,0,4,0" Click="OnTimetableCurrentWeekClicked" ToolTip="返回当前周" />
                                    <Button Content="›" Style="{StaticResource GoogleTopBtnStyle}" Width="28" Height="28" Padding="0" FontSize="16" FontWeight="Bold" Click="OnTimetableNextWeekClicked" ToolTip="下一周" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Center: Current Week Date Range Notice -->
                            <TextBlock Grid.Column="1" x:Name="TimetableWeekDateRangeText" Text="2026年10月5日 - 10月11日" FontSize="12" Foreground="#8AB4F8" HorizontalAlignment="Center" VerticalAlignment="Center" />

                            <!-- Right: Actions -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="🔄 刷新" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="10,5" FontSize="12" Click="OnRefreshTimetableClicked" Margin="0,0,8,0" />
                                <Button Content="🔀 调停课" Style="{StaticResource GoogleTopBtnStyle}" Padding="10,5" FontSize="12" Click="OnOpenAdjustmentModalClicked" Margin="0,0,8,0" ToolTip="管理停课、调课改期与临时补课" />
                                <Button Content="⚙ 课表设置" Style="{StaticResource GoogleTopBtnStyle}" Padding="10,5" FontSize="12" Click="OnOpenTimetableSettingsClicked" Margin="0,0,8,0" ToolTip="学期周数、作息时间与课堂长度" />
                                <Button Content="➕ 添加课程" Style="{StaticResource GoogleActionBtnStyle}" Padding="14,6" FontSize="12" FontWeight="SemiBold" Click="OnCreateCourseClicked" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 1: Horizontal Scrollable Week Number Capsules Bar (WakeUp 经典交互) -->
                    <Border Grid.Row="1" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="14,6">
                        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="TimetableWeekCapsulesPanel" Orientation="Horizontal">
                                <!-- Dynamically generated Week 1~20 capsule buttons -->
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Row 2: Matrix Timetable Grid Area -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <!-- Days of Week Header (Mon-Sun + Dates) -->
                            <RowDefinition Height="46" />
                            <!-- Scrollable Schedule Matrix Track -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Days of Week Header -->
                        <Border Grid.Row="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1">
                            <Grid x:Name="TimetableHeaderColumnsGrid">
                                <!-- Dynamically built: Column 0 = Month, Columns 1-7 = Mon-Sun -->
                            </Grid>
                        </Border>

                        <!-- Timetable Matrix Body (Hidden Scrollbar) -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" x:Name="TimetableScrollViewer">
                            <Grid x:Name="TimetableMatrixGrid">
                                <!-- Dynamically built matrix: Column 0 = Time slot labels (1-12), Columns 1-7 = Day slots + Course Cards -->
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- 5. DAILY ACHIEVEMENT REPORT PAGE (每日成果汇报) -->
                <Grid x:Name="DailyReportPageContainer" Visibility="Collapsed" Background="{DynamicResource GoogleSurface}">
                    <ScrollViewer x:Name="DailyReportScrollViewer" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Padding="20,16,20,24">
                        <StackPanel HorizontalAlignment="Stretch">

                            <!-- Top Header & Action Bar -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Title & Today Status Badge -->
                                <StackPanel Grid.Column="0">
                                    <WrapPanel VerticalAlignment="Center">
                                        <TextBlock Text="🏆" FontSize="22" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="日报" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                        <Border Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="12" Padding="10,3" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="DailyReportDateTitleBadge" Text="2026年10月4日" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" />
                                        </Border>
                                        <Border Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="12" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock x:Name="DailyReportStatusBadge" Text="✓ 已对账" FontSize="11" FontWeight="SemiBold" Foreground="#34D399" />
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>

                                <!-- Action Buttons -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="DailyReportToggleViewBtn" Content="👁️ 预览" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="10,5" FontSize="12" Click="OnToggleDailyReportViewClicked" Margin="0,0,8,0" ToolTip="在编辑与预览之间切换" />
                                    <Button Content="🔄 刷新" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="10,5" FontSize="12" Click="OnRefreshDailyReportClicked" Margin="0,0,8,0" ToolTip="重新加载本日数据" />
                                    <Button Content="✨ 智能生成" Style="{StaticResource GoogleOutlineBtnStyle}" Foreground="{DynamicResource AccentBlue}" BorderBrush="{DynamicResource AccentBlue}" Padding="12,5" FontSize="12" Click="OnGenerateDailyReportClicked" Margin="0,0,8,0" ToolTip="基于今日日程与工时生成模块草稿" />
                                    <Button Content="📋 复制" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="12,5" FontSize="12" Click="OnCopyDailyReportClicked" Margin="0,0,8,0" ToolTip="复制完整 Markdown 汇报至剪贴板" />
                                    <Button Content="💾 保存" Style="{StaticResource GoogleActionBtnStyle}" Background="{DynamicResource AccentBlue}" Padding="14,6" FontSize="12" FontWeight="SemiBold" Click="OnSaveDailyReportContentClicked" ToolTip="保存今日汇报 (Ctrl+S)" />
                                </StackPanel>
                            </Grid>

                            <!-- Date Stepper & Navigation Bar -->
                            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Quick Day Jump -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="‹ 前一天" Style="{StaticResource GoogleTopBtnStyle}" Padding="10,4" FontSize="12" Click="OnDailyReportPrevDayClicked" Margin="0,0,6,0" />
                                        <Button Content="今天" Style="{StaticResource GoogleActionBtnStyle}" Padding="12,4" FontSize="12" Click="OnDailyReportTodayClicked" Margin="0,0,6,0" />
                                        <Button Content="后一天 ›" Style="{StaticResource GoogleTopBtnStyle}" Padding="10,4" FontSize="12" Click="OnDailyReportNextDayClicked" Margin="0,0,8,0" />
                                    </StackPanel>

                                    <!-- Current Displayed Date & Day of Week -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="📅" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="DailyReportCurrentDateText" Text="2026年10月4日 星期日" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <DatePicker x:Name="DailyReportDatePicker" Background="{DynamicResource ControlBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" SelectedDateChanged="OnDailyReportDatePickerChanged" Width="34" Height="26" ToolTip="点击日历图标跳转指定日期" Opacity="0.85" />
                                    </StackPanel>

                                    <!-- Target / Ratio Tag -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="DailyReportQuickSummaryTag" Text="已完成 0 项 / 深度工时 0.0h" FontSize="12" FontWeight="SemiBold" Foreground="#A78BFA" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 4 Key Daily KPI Metric Cards -->
                            <Grid Margin="0,0,0,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Metric 1: Tasks Completion -->
                                <Border Grid.Column="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="今日任务交付率" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock x:Name="DailyReportCompletionRateText" Text="0.0%" FontSize="22" FontWeight="Bold" Foreground="#34D399" Margin="0,4,0,2" />
                                        <ProgressBar x:Name="DailyReportCompletionProgressBar" Height="4" Maximum="100" Value="0" Background="{DynamicResource ControlBackground}" Foreground="#34D399" Margin="0,2,0,4" />
                                        <TextBlock x:Name="DailyReportTaskCountText" Text="已完成 0 项 / 今日总计 0 项" FontSize="11" Foreground="#059669" />
                                    </StackPanel>
                                </Border>

                                <!-- Metric 2: Deep Work & Cognitive Time -->
                                <Border Grid.Column="1" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="深度工作投入" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock x:Name="DailyReportDeepHoursText" Text="0.0 h" FontSize="22" FontWeight="Bold" Foreground="#C084FC" Margin="0,4,0,2" />
                                        <ProgressBar x:Name="DailyReportDeepPurityProgressBar" Height="4" Maximum="100" Value="0" Background="{DynamicResource ControlBackground}" Foreground="#C084FC" Margin="0,2,0,4" />
                                        <TextBlock x:Name="DailyReportDeepPurityText" Text="浅层 0.0 h · 休息缓冲 0.0 h" FontSize="11" Foreground="#7C3AED" />
                                    </StackPanel>
                                </Border>

                                <!-- Metric 3: DoD Fulfillment Checklist -->
                                <Border Grid.Column="2" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="DoD 验收标准达标" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock x:Name="DailyReportDodRateText" Text="0.0%" FontSize="22" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,2" />
                                        <ProgressBar x:Name="DailyReportDodProgressBar" Height="4" Maximum="100" Value="0" Background="{DynamicResource ControlBackground}" Foreground="#38BDF8" Margin="0,2,0,4" />
                                        <TextBlock x:Name="DailyReportDodCountText" Text="达标 0 项 / 设限 0 项" FontSize="11" Foreground="#0284C7" />
                                    </StackPanel>
                                </Border>

                                <!-- Metric 4: Focus & Interruption Loss -->
                                <Border Grid.Column="3" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="打断损耗与专注度" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock x:Name="DailyReportFocusScoreText" Text="100 分" FontSize="22" FontWeight="Bold" Foreground="#FBBF24" Margin="0,4,0,2" />
                                        <ProgressBar x:Name="DailyReportFocusProgressBar" Height="4" Maximum="100" Value="100" Background="{DynamicResource ControlBackground}" Foreground="#FBBF24" Margin="0,2,0,4" />
                                        <TextBlock x:Name="DailyReportInterruptLossText" Text="打断损耗 0 分钟" FontSize="11" Foreground="#D97706" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Two Main Columns: Left = Today Achievements & Carryover; Right = Generated Report & Reflections -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.1*" />
                                    <ColumnDefinition Width="0.9*" />
                                </Grid.ColumnDefinitions>

                                <!-- Left Column: Completed Achievements + Pending/Tomorrow Backlog -->
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">

                                    <!-- Block 1: Completed Achievements (今日核心战果与交付物) -->
                                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,16">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="🎯" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="今日完成" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" x:Name="DailyReportCompletedHeaderBadge" Text="共 0 项交付" FontSize="11" Foreground="#34D399" VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Dynamic Completed Items List -->
                                            <StackPanel x:Name="DailyReportCompletedItemsPanel">
                                                <!-- Populated dynamically via code-behind -->
                                            </StackPanel>

                                            <!-- Empty State Placeholder -->
                                            <TextBlock x:Name="DailyReportCompletedEmptyText" Text="今日尚无标记为已完成的日程，勾选完成或生成新战果后即时展现。" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="4,8,0,8" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Block 2: Incomplete Backlog & Tomorrow's Plan (待递延任务与明日规划) -->
                                    <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="⏳" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="明日计划" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" x:Name="DailyReportPendingHeaderBadge" Text="待跟进 0 项" FontSize="11" Foreground="#F59E0B" VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Dynamic Pending/Tomorrow Items List -->
                                            <StackPanel x:Name="DailyReportPendingItemsPanel">
                                                <!-- Populated dynamically via code-behind -->
                                            </StackPanel>

                                            <!-- Empty State Placeholder -->
                                            <TextBlock x:Name="DailyReportPendingEmptyText" Text="今日全部安排均已清空交付，无滞留待办！🎉" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="4,8,0,8" Visibility="Collapsed" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Right Column: 4 Distinct Modular Report Blocks (各个模块单独成框 + 现代化手账体验) -->
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">

                                    <!-- Main Editor Container (可切换编辑/预览) -->
                                    <StackPanel x:Name="DailyReportEditorContainer">

                                        <!-- Module Card 1: 认知工时与专注指标总结 (优雅可视化看板) -->
                                        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,12">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="📊" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="工时与指标" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="复制" Style="{StaticResource GoogleTopBtnStyle}" Padding="10,3" FontSize="11" Click="OnCopySection1Clicked" ToolTip="复制工时与指标文本到剪贴板" />
                                                </Grid>

                                                <!-- Metric Badges Row -->
                                                <WrapPanel Margin="0,0,0,8">
                                                    <Border Background="#2E1065" BorderBrush="#7C3AED" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                                                        <TextBlock FontSize="11" Foreground="#E9D5FF">
                                                            <Run Text="🎯 深度工作: " Foreground="#C084FC" />
                                                            <Run x:Name="DailyReportSec1DeepRun" Text="0.0 h" FontWeight="Bold" Foreground="#FFFFFF" />
                                                        </TextBlock>
                                                    </Border>
                                                    <Border Background="#1E293B" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                                                        <TextBlock FontSize="11" Foreground="#BAE6FD">
                                                            <Run Text="⚡ 浅层事务: " Foreground="#38BDF8" />
                                                            <Run x:Name="DailyReportSec1ShallowRun" Text="0.0 h" FontWeight="Bold" Foreground="#FFFFFF" />
                                                        </TextBlock>
                                                    </Border>
                                                    <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                                                        <TextBlock FontSize="11" Foreground="#A7F3D0">
                                                            <Run Text="🎯 交付完成: " Foreground="#34D399" />
                                                            <Run x:Name="DailyReportSec1DeliverRun" Text="100.0% (0/0)" FontWeight="Bold" Foreground="#FFFFFF" />
                                                        </TextBlock>
                                                    </Border>
                                                    <Border Background="#312E81" BorderBrush="#4F46E5" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                                                        <TextBlock FontSize="11" Foreground="#C7D2FE">
                                                            <Run Text="🛡️ DoD 达成: " Foreground="#818CF8" />
                                                            <Run x:Name="DailyReportSec1DodRun" Text="0/0 项" FontWeight="Bold" Foreground="#FFFFFF" />
                                                        </TextBlock>
                                                    </Border>
                                                    <Border Background="#451A03" BorderBrush="#D97706" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                                                        <TextBlock FontSize="11" Foreground="#FDE68A">
                                                            <Run Text="🔥 专注度: " Foreground="#FBBF24" />
                                                            <Run x:Name="DailyReportSec1FocusRun" Text="100分 · 零打断" FontWeight="Bold" Foreground="#FFFFFF" />
                                                        </TextBlock>
                                                    </Border>
                                                </WrapPanel>

                                                <!-- Narrative Text Summary Block -->
                                                <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                                    <TextBlock x:Name="DailyReportSec1MetricsTextBlock" Text="• 深度工作投入：0.0 小时 · 浅层事务：0.0 小时 · 休息缓冲：0.0 小时&#x0a;• 任务交付完成率：100.0% (交付 0 项 / 总计 0 项)&#x0a;• DoD 验收标准达成：0/0 项&#x0a;• 专注保持极高，今日零打断损耗" FontSize="12" Foreground="{DynamicResource TextSecondary}" LineHeight="20" TextWrapping="Wrap" />
                                                </Border>

                                                <!-- Hidden Raw TextBox for 100% backward compatibility of serialization -->
                                                <TextBox x:Name="DailyReportSecMetricsTextBox" Visibility="Collapsed" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Module Card 2: 今日核心交付与产出 (Key Wins) -->
                                        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,12">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="🎯" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="今日完成" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="导入已完成" Style="{StaticResource GoogleTopBtnStyle}" Foreground="#34D399" Padding="8,3" FontSize="11" Click="OnExtractCompletedToWinsClicked" Margin="0,0,6,0" ToolTip="一键将今日已完成日程及 DoD 填入此模块" />
                                                        <Button Content="复制" Style="{StaticResource GoogleTopBtnStyle}" Padding="8,3" FontSize="11" Click="OnCopySection2Clicked" ToolTip="复制今日交付成果" />
                                                    </StackPanel>
                                                </Grid>

                                                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                                    <TextBox x:Name="DailyReportSecWinsTextBox"
                                                             Background="Transparent"
                                                             Foreground="{DynamicResource TextPrimary}"
                                                             CaretBrush="#38BDF8"
                                                             BorderThickness="0"
                                                             AcceptsReturn="True"
                                                             TextWrapping="Wrap"
                                                             VerticalScrollBarVisibility="Hidden"
                                                             MinHeight="85"
                                                             MaxHeight="260"
                                                             FontSize="13"
                                                             FontFamily="Segoe UI, Microsoft YaHei UI" />
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- Module Card 3: 递延事项与明日重点计划 (Next Steps) -->
                                        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,12">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="⏳" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="明日计划" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="导入待办" Style="{StaticResource GoogleTopBtnStyle}" Foreground="#FBBF24" Padding="8,3" FontSize="11" Click="OnExtractPendingToNextStepsClicked" Margin="0,0,6,0" ToolTip="一键将今日未完成或待跟进日程按格式导入" />
                                                        <Button Content="复制" Style="{StaticResource GoogleTopBtnStyle}" Padding="8,3" FontSize="11" Click="OnCopySection3Clicked" ToolTip="复制明日计划文本" />
                                                    </StackPanel>
                                                </Grid>

                                                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                                    <TextBox x:Name="DailyReportSecNextStepsTextBox"
                                                             Background="Transparent"
                                                             Foreground="{DynamicResource TextPrimary}"
                                                             CaretBrush="#F59E0B"
                                                             BorderThickness="0"
                                                             AcceptsReturn="True"
                                                             TextWrapping="Wrap"
                                                             VerticalScrollBarVisibility="Hidden"
                                                             MinHeight="75"
                                                             MaxHeight="240"
                                                             FontSize="13"
                                                             FontFamily="Segoe UI, Microsoft YaHei UI" />
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- Module Card 4: 今日复盘与认知反思 (Reflections) -->
                                        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="💡" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="复盘心得" FontSize="13.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="复制" Style="{StaticResource GoogleTopBtnStyle}" Padding="8,3" FontSize="11" Click="OnCopySection4Clicked" Margin="0,0,6,0" ToolTip="复制反思心得文本" />
                                                        <Button Content="保存" Style="{StaticResource GoogleActionBtnStyle}" Background="#7C3AED" Padding="12,3" FontSize="11" FontWeight="SemiBold" Click="OnSaveDailyReportContentClicked" ToolTip="保存所有模块内容到数据库 (Ctrl+S)" />
                                                    </StackPanel>
                                                </Grid>

                                                <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                                    <TextBox x:Name="DailyReportReflectionTextBox"
                                                             Background="Transparent"
                                                             Foreground="{DynamicResource TextPrimary}"
                                                             CaretBrush="#C084FC"
                                                             BorderThickness="0"
                                                             AcceptsReturn="True"
                                                             TextWrapping="Wrap"
                                                             VerticalScrollBarVisibility="Hidden"
                                                             MinHeight="100"
                                                             MaxHeight="320"
                                                             FontSize="13"
                                                             FontFamily="Segoe UI, Microsoft YaHei UI"
                                                             ToolTip="记录今日心得与改进建议" />
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>

                                    <!-- Full Markdown Report Preview Container (战报预览模式) -->
                                    <Border x:Name="DailyReportPreviewContainer" Visibility="Collapsed" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20,16">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="📖" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="预览" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="复制" Style="{StaticResource GoogleActionBtnStyle}" Background="{DynamicResource AccentBlue}" Padding="12,4" FontSize="11" FontWeight="SemiBold" Click="OnCopyDailyReportClicked" />
                                            </Grid>
                                            <Border Background="{DynamicResource InputBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                                                <TextBox x:Name="DailyReportPreviewFullTextBox"
                                                         IsReadOnly="True"
                                                         Background="Transparent"
                                                         Foreground="{DynamicResource TextPrimary}"
                                                         BorderThickness="0"
                                                         Padding="0"
                                                         FontSize="12.5"
                                                         FontFamily="Cascadia Code, Consolas, Segoe UI"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         MinHeight="360"
                                                         MaxHeight="560"
                                                         VerticalScrollBarVisibility="Hidden" />
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                </StackPanel>
                            </Grid>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ================= 6. SETTINGS PAGE (系统设置) ================= -->
                <Grid x:Name="SettingsPageContainer" Visibility="Collapsed" Background="{DynamicResource GoogleSurface}">
                    <Grid.RowDefinitions>
                        <!-- Top Header & Tabs Bar -->
                        <RowDefinition Height="Auto" />
                        <!-- Scrollable Content Area -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Header & Settings Tab Navigation Bar -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="24,14,24,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Title & Subtitle -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource AccentBlue}" BorderThickness="1" Margin="0,0,12,0">
                                        <TextBlock Text="⚙️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="设置" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource AccentBlue}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                        <TextBlock x:Name="SettingsHeaderNoticeText" Text="已自动保存" FontSize="11" Foreground="{DynamicResource AccentBlue}" FontWeight="Medium" />
                                    </Border>
                                    <Button Content="📖 使用指南" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="10,4" FontSize="11" Margin="0,0,6,0" Click="OnOpenTutorialPageClicked" ToolTip="打开系统使用指南" />
                                    <Button Content="✨ 重播引导" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="10,4" FontSize="11" Click="OnReplayOnboardingClicked" ToolTip="重新打开新手引导" />
                                </StackPanel>
                            </Grid>

                            <!-- Settings Tabs Navigation Bar -->
                            <Border Grid.Row="1" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                                <WrapPanel Orientation="Horizontal">
                                    <Button x:Name="SettingsTabThemeBtn" Content="外观" Style="{StaticResource GoogleTopBtnStyle}" Background="{DynamicResource AccentBlue}" Foreground="#FFFFFF" Padding="14,6" FontSize="12" FontWeight="SemiBold" Click="OnSettingsTabThemeClicked" Margin="2,0" />
                                    <Button x:Name="SettingsTabDriveBtn" Content="云同步" Style="{StaticResource GoogleTopBtnStyle}" Background="Transparent" Foreground="{DynamicResource TextSecondary}" Padding="14,6" FontSize="12" FontWeight="Normal" Click="OnSettingsTabDriveClicked" Margin="2,0" />
                                    <Button x:Name="SettingsTabSyncBtn" Content="备份与导出" Style="{StaticResource GoogleTopBtnStyle}" Background="Transparent" Foreground="{DynamicResource TextSecondary}" Padding="14,6" FontSize="12" FontWeight="Normal" Click="OnSettingsTabSyncClicked" Margin="2,0" />
                                    <Button x:Name="SettingsTabClientBtn" Content="设备标识" Style="{StaticResource GoogleTopBtnStyle}" Background="Transparent" Foreground="{DynamicResource TextSecondary}" Padding="14,6" FontSize="12" FontWeight="Normal" Click="OnSettingsTabClientClicked" Margin="2,0" />
                                    <Button x:Name="SettingsTabAdvancedBtn" Content="高级" Style="{StaticResource GoogleTopBtnStyle}" Background="Transparent" Foreground="{DynamicResource TextSecondary}" Padding="14,6" FontSize="12" FontWeight="Normal" Click="OnSettingsTabAdvancedClicked" Margin="2,0" />
                                </WrapPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Scrollable Settings Content Panels -->
                    <ScrollViewer Grid.Row="1" x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Padding="20,16,20,24">
                        <StackPanel HorizontalAlignment="Stretch">

                            <!-- ================= PANEL 0: 外观与个性化 (THEME & APPEARANCE) ================= -->
                            <StackPanel x:Name="SettingsPanelTheme" Visibility="Visible">

                                <!-- Card 1: 主题深浅模式 -->
                                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20,18" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🌓" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="界面显示模式 (Theme Mode)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock x:Name="ThemeCurrentModeLabel" Grid.Column="1" Text="当前模式：夜间模式" FontSize="11" Foreground="{DynamicResource AccentBlue}" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="选择适合您工作习惯的界面模式。日间模式明亮清爽，夜间模式沉浸降噪，亦可自动跟随 Windows 系统深浅模式。" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,14" TextWrapping="Wrap" />

                                        <!-- Mode Selection Buttons -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Light Mode Pill -->
                                            <Button Grid.Column="0" x:Name="ThemeModeLightBtn" Style="{StaticResource GoogleTopBtnStyle}" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="14,14" Click="OnThemeModeLightClicked" ToolTip="切换为日间明亮模式">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="☀️" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                                    <TextBlock x:Name="ThemeModeLightTitleText" Text="日间明亮模式" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" />
                                                    <TextBlock x:Name="ThemeModeLightSubText" Text="清爽白色底色 · 高明度" FontSize="10" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Dark Mode Pill -->
                                            <Button Grid.Column="2" x:Name="ThemeModeDarkBtn" Style="{StaticResource GoogleTopBtnStyle}" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="14,14" Click="OnThemeModeDarkClicked" ToolTip="切换为夜间深色模式">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="🌙" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                                    <TextBlock x:Name="ThemeModeDarkTitleText" Text="夜间深色模式" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBlue}" HorizontalAlignment="Center" />
                                                    <TextBlock x:Name="ThemeModeDarkSubText" Text="沉浸暗黑底色 · 护眼" FontSize="10" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Follow System Pill -->
                                            <Button Grid.Column="4" x:Name="ThemeModeSystemBtn" Style="{StaticResource GoogleTopBtnStyle}" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="14,14" Click="OnThemeModeSystemClicked" ToolTip="跟随 Windows 11/10 系统主题自动切换">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <TextBlock Text="💻" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                                    <TextBlock x:Name="ThemeModeSystemTitleText" Text="跟随系统" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" />
                                                    <TextBlock x:Name="ThemeModeSystemSubText" Text="自动匹配系统深浅设置" FontSize="10" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Card 2: 自定义主题强调色 (Accent Color) -->
                                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20,18" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🎨" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="主题强调色 (Accent Color)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="用于高亮按钮、当前周指示器与核心元素" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                        </Grid>

                                        <TextBlock Text="从精选预设色系中直接选择，或输入任意十六进制颜色代码（支持 #RRGGBB）：" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12" TextWrapping="Wrap" />

                                        <!-- Preset Color Chips -->
                                        <WrapPanel Margin="0,0,0,14">
                                            <Button Style="{StaticResource GoogleTopBtnStyle}" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="10,6" Margin="0,0,8,8" Tag="#1A73E8" Click="OnPresetAccentClicked" ToolTip="Google 蓝 (#1A73E8)">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="16" Height="16" CornerRadius="8" Background="#1A73E8" Margin="0,0,8,0" />
                                                    <TextBlock Text="Google 蓝" FontSize="12" Foreground="{DynamicResource TextPrimary}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource GoogleTopBtnStyle}" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="10,6" Margin="0,0,8,8" Tag="#10B981" Click="OnPresetAccentClicked" ToolTip="翡翠绿 (#10B981)">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="16" Height="16" CornerRadius="8" Background="#10B981" Margin="0,0,8,0" />
                                                    <TextBlock Text="翡翠绿" FontSize="12" Foreground="{DynamicResource TextPrimary}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource GoogleTopBtnStyle}" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="10,6" Margin="0,0,8,8" Tag="#8B5CF6" Click="OnPresetAccentClicked" ToolTip="极光紫 (#8B5CF6)">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="16" Height="16" CornerRadius="8" Background="#8B5CF6" Margin="0,0,8,0" />
                                                    <TextBlock Text="极光紫" FontSize="12" Foreground="{DynamicResource TextPrimary}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource GoogleTopBtnStyle}" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="10,6" Margin="0,0,8,8" Tag="#F97316" Click="OnPresetAccentClicked" ToolTip="暖阳橙 (#F97316)">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="16" Height="16" CornerRadius="8" Background="#F97316" Margin="0,0,8,0" />
                                                    <TextBlock Text="暖阳橙" FontSize="12" Foreground="{DynamicResource TextPrimary}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource GoogleTopBtnStyle}" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="10,6" Margin="0,0,8,8" Tag="#F43F5E" Click="OnPresetAccentClicked" ToolTip="蔷薇红 (#F43F5E)">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="16" Height="16" CornerRadius="8" Background="#F43F5E" Margin="0,0,8,0" />
                                                    <TextBlock Text="蔷薇红" FontSize="12" Foreground="{DynamicResource TextPrimary}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource GoogleTopBtnStyle}" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="10,6" Margin="0,0,8,8" Tag="#06B6D4" Click="OnPresetAccentClicked" ToolTip="碧海青 (#06B6D4)">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="16" Height="16" CornerRadius="8" Background="#06B6D4" Margin="0,0,8,0" />
                                                    <TextBlock Text="碧海青" FontSize="12" Foreground="{DynamicResource TextPrimary}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource GoogleTopBtnStyle}" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="10,6" Margin="0,0,8,8" Tag="#EAB308" Click="OnPresetAccentClicked" ToolTip="晨曦金 (#EAB308)">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="16" Height="16" CornerRadius="8" Background="#EAB308" Margin="0,0,8,0" />
                                                    <TextBlock Text="晨曦金" FontSize="12" Foreground="{DynamicResource TextPrimary}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource GoogleTopBtnStyle}" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="10,6" Margin="0,0,8,8" Tag="#64748B" Click="OnPresetAccentClicked" ToolTip="钛合灰 (#64748B)">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="16" Height="16" CornerRadius="8" Background="#64748B" Margin="0,0,8,0" />
                                                    <TextBlock Text="钛合灰" FontSize="12" Foreground="{DynamicResource TextPrimary}" />
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>

                                        <!-- Custom Hex & RGB Real-time Preview Color Picker -->
                                        <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="HEX 颜色代码：" FontSize="12" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <Border Grid.Column="1" x:Name="ThemeCustomAccentPreviewBadge" Width="26" Height="26" CornerRadius="4" Background="#1A73E8" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBox Grid.Column="2" x:Name="ThemeCustomAccentHexInput" Text="#1A73E8" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,4" Height="30" FontSize="12" VerticalContentAlignment="Center" FontFamily="Cascadia Code, Consolas" TextChanged="OnThemeCustomAccentHexTextChanged" />
                                                    <Button Grid.Column="4" Content="应用强调色" Style="{StaticResource GoogleActionBtnStyle}" Padding="14,4" Height="30" FontSize="12" FontWeight="SemiBold" Click="OnApplyCustomAccentClicked" />
                                                    <Button Grid.Column="6" Content="🎨 独立调色大弹窗" Style="{StaticResource GoogleTopBtnStyle}" Padding="10,4" Height="30" FontSize="11" Click="OnOpenThemeRgbPickerModalClicked" ToolTip="打开全功能 RGB 调色盘弹窗" />
                                                </Grid>

                                                <!-- RGB 实时调色滑块面板 -->
                                                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="14" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- 3 原色滑块 -->
                                                        <StackPanel Grid.Column="0">
                                                            <!-- R 滑块 -->
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="48" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="38" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Border Width="8" Height="8" CornerRadius="4" Background="#EF4444" Margin="0,0,5,0" />
                                                                    <TextBlock Text="R (红)" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                                                </StackPanel>
                                                                <Slider x:Name="ThemeAccentSliderR" Grid.Column="1" Minimum="0" Maximum="255" SmallChange="1" LargeChange="10" Value="26" VerticalAlignment="Center" Margin="6,0" ValueChanged="OnThemeAccentRgbSliderChanged" />
                                                                <TextBlock x:Name="ThemeAccentRText" Grid.Column="2" Text="26" FontSize="11" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas, monospace" />
                                                            </Grid>

                                                            <!-- G 滑块 -->
                                                            <Grid Margin="0,0,0,6">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="48" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="38" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Border Width="8" Height="8" CornerRadius="4" Background="#10B981" Margin="0,0,5,0" />
                                                                    <TextBlock Text="G (绿)" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                                                </StackPanel>
                                                                <Slider x:Name="ThemeAccentSliderG" Grid.Column="1" Minimum="0" Maximum="255" SmallChange="1" LargeChange="10" Value="115" VerticalAlignment="Center" Margin="6,0" ValueChanged="OnThemeAccentRgbSliderChanged" />
                                                                <TextBlock x:Name="ThemeAccentGText" Grid.Column="2" Text="115" FontSize="11" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas, monospace" />
                                                            </Grid>

                                                            <!-- B 滑块 -->
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="48" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="38" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Border Width="8" Height="8" CornerRadius="4" Background="#3B82F6" Margin="0,0,5,0" />
                                                                    <TextBlock Text="B (蓝)" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                                                </StackPanel>
                                                                <Slider x:Name="ThemeAccentSliderB" Grid.Column="1" Minimum="0" Maximum="255" SmallChange="1" LargeChange="10" Value="232" VerticalAlignment="Center" Margin="6,0" ValueChanged="OnThemeAccentRgbSliderChanged" />
                                                                <TextBlock x:Name="ThemeAccentBText" Grid.Column="2" Text="232" FontSize="11" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas, monospace" />
                                                            </Grid>
                                                        </StackPanel>

                                                        <!-- 实时预览色块 -->
                                                        <Border Grid.Column="2" CornerRadius="6" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="12,6" VerticalAlignment="Center" MinWidth="130">
                                                            <StackPanel HorizontalAlignment="Center">
                                                                <Border x:Name="ThemeAccentLargePreviewSwatch" Width="68" Height="36" CornerRadius="5" Background="#1A73E8" BorderBrush="#33FFFFFF" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,4">
                                                                    <TextBlock x:Name="ThemeAccentRgbSummaryText" Text="RGB(26,115,232)" FontSize="9" Foreground="White" Background="#80000000" VerticalAlignment="Bottom" HorizontalAlignment="Center" Padding="3,1" FontFamily="Consolas, monospace" />
                                                                </Border>
                                                                <TextBlock Text="RGB 实时预览色样" FontSize="10" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Card 3: 背景底色微调 (Background Tone Customization) -->
                                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20,18" Margin="0,0,0,16">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🌌" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="自定义底色深浅风格 (Background Tone)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="微调深色/亮色界面的主背景基调" FontSize="11" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                        </Grid>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Dark Background Settings -->
                                            <Border Grid.Column="0" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="🌙 深色模式背景基调" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlue}" VerticalAlignment="Center" />
                                                        <Border Grid.Column="1" x:Name="ThemeCustomDarkBgPreviewBadge" Width="20" Height="20" CornerRadius="4" Background="#202124" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" ToolTip="当前深色背景颜色预览" />
                                                    </Grid>
                                                    <WrapPanel Margin="0,0,0,8">
                                                        <Button Content="经典炭黑 (#202124)" Style="{StaticResource GoogleTopBtnStyle}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,4" Margin="0,0,6,6" FontSize="11" Tag="#202124" Click="OnPresetDarkBgClicked" />
                                                        <Button Content="AMOLED 纯黑 (#121212)" Style="{StaticResource GoogleTopBtnStyle}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,4" Margin="0,0,6,6" FontSize="11" Tag="#121212" Click="OnPresetDarkBgClicked" />
                                                        <Button Content="幽蓝深夜 (#181926)" Style="{StaticResource GoogleTopBtnStyle}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,4" Margin="0,0,6,6" FontSize="11" Tag="#181926" Click="OnPresetDarkBgClicked" />
                                                    </WrapPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="ThemeCustomDarkBgInput" Text="#202124" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,4" Height="28" FontSize="11" VerticalContentAlignment="Center" FontFamily="Cascadia Code, Consolas" TextChanged="OnThemeCustomDarkBgTextChanged" />
                                                        <Button Grid.Column="2" Content="应用" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="10,2" Height="28" FontSize="11" Click="OnApplyCustomDarkBgClicked" />
                                                        <Button Grid.Column="4" Content="🎨 RGB 调色" Style="{StaticResource GoogleTopBtnStyle}" Padding="8,2" Height="28" FontSize="11" Click="OnOpenDarkBgRgbPickerClicked" ToolTip="打开 RGB 实时调色盘自选深色背景" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- Light Background Settings -->
                                            <Border Grid.Column="2" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="☀️ 日间模式背景基调" FontSize="12.5" FontWeight="SemiBold" Foreground="#F59E0B" VerticalAlignment="Center" />
                                                        <Border Grid.Column="1" x:Name="ThemeCustomLightBgPreviewBadge" Width="20" Height="20" CornerRadius="4" Background="#F8F9FA" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" ToolTip="当前日间背景颜色预览" />
                                                    </Grid>
                                                    <WrapPanel Margin="0,0,0,8">
                                                        <Button Content="纯净灰白 (#F8F9FA)" Style="{StaticResource GoogleTopBtnStyle}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,4" Margin="0,0,6,6" FontSize="11" Tag="#F8F9FA" Click="OnPresetLightBgClicked" />
                                                        <Button Content="极简纯白 (#FFFFFF)" Style="{StaticResource GoogleTopBtnStyle}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,4" Margin="0,0,6,6" FontSize="11" Tag="#FFFFFF" Click="OnPresetLightBgClicked" />
                                                        <Button Content="冰川冷灰 (#F1F5F9)" Style="{StaticResource GoogleTopBtnStyle}" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,4" Margin="0,0,6,6" FontSize="11" Tag="#F1F5F9" Click="OnPresetLightBgClicked" />
                                                    </WrapPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="ThemeCustomLightBgInput" Text="#F8F9FA" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,4" Height="28" FontSize="11" VerticalContentAlignment="Center" FontFamily="Cascadia Code, Consolas" TextChanged="OnThemeCustomLightBgTextChanged" />
                                                        <Button Grid.Column="2" Content="应用" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="10,2" Height="28" FontSize="11" Click="OnApplyCustomLightBgClicked" />
                                                        <Button Grid.Column="4" Content="🎨 RGB 调色" Style="{StaticResource GoogleTopBtnStyle}" Padding="8,2" Height="28" FontSize="11" Click="OnOpenLightBgRgbPickerClicked" ToolTip="打开 RGB 实时调色盘自选日间背景" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Card 4: 实时效果预览 (Live Preview) & 重置默认 -->
                                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20,18">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="👁️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="实时渲染预览 (Live Preview)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="🔄 恢复默认色彩方案" Style="{StaticResource GoogleOutlineBtnStyle}" Foreground="{DynamicResource TextSecondary}" Padding="12,3" FontSize="11" Click="OnResetThemeDefaultsClicked" ToolTip="恢复 Google 经典深色沉浸主题与 Google 蓝" />
