                            <TextBox x:Name="StudyTopicProgressInput" Text="0" IsReadOnly="True" Focusable="False" Background="{DynamicResource ControlBackground}" Foreground="{DynamicResource TextSecondary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,6" FontSize="12" ToolTip="依据已完成量与目标总量自动推算" />
