                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="🏃 高燃心肺有氧与减脂 (Fat Burn Cardio)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="跑步机变速跑 · 划船机间歇划 · 开合跳俯卧撑循环 · 全身动态拉伸" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                                </StackPanel>
