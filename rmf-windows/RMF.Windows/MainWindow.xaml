                                    <TextBox x:Name="RgbInputB" Grid.Column="2" Text="232" FontSize="12" Padding="6,3" TextAlignment="Center" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" TextChanged="OnRgbInputTextChanged" />
                                </Grid>

