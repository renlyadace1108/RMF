                                        </StackPanel>
                                    </Button>
                                    <Button Tag="#D97706" Click="OnRgbPresetSwatchClicked" Style="{StaticResource GoogleOutlineBtnStyle}" Margin="0,0,6,6" Padding="6,3" ToolTip="琥珀橙 (#D97706)">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="12" Height="12" CornerRadius="6" Background="#D97706" Margin="0,0,4,0" />
                                            <TextBlock Text="琥珀橙" FontSize="10.5" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="#DC2626" Click="OnRgbPresetSwatchClicked" Style="{StaticResource GoogleOutlineBtnStyle}" Margin="0,0,6,6" Padding="6,3" ToolTip="玫瑰红 (#DC2626)">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="12" Height="12" CornerRadius="6" Background="#DC2626" Margin="0,0,4,0" />
                                            <TextBlock Text="玫瑰红" FontSize="10.5" />
                                        </StackPanel>
                                    </Button>
                                    <Button Tag="#0891B2" Click="OnRgbPresetSwatchClicked" Style="{StaticResource GoogleOutlineBtnStyle}" Margin="0,0,6,6" Padding="6,3" ToolTip="青碧蓝 (#0891B2)">
                                        <StackPanel Orientation="Horizontal">
