            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.6" Color="Black" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="🔔" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="UpcomingEventTimeText" Text="即将开始 (10分钟后)" FontSize="11" FontWeight="Bold" Foreground="#A78BFA" />
                    <TextBlock x:Name="UpcomingEventTitleText" Text="日程任务标题" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Content="查看" Background="#6D28D9" Foreground="#FFFFFF" BorderThickness="0" Padding="8,4" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,6,0" Click="OnUpcomingEventViewClicked" />
