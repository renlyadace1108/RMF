        <!-- ================= MODAL 1: GOOGLE CALENDAR EVENT DIALOG (WITH DOD & COGNITIVE LEVEL) ================= -->
        <Grid x:Name="EventModal" Visibility="Collapsed" Background="#99000000" Grid.RowSpan="2" Panel.ZIndex="999">
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Width="520" MaxHeight="640" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /> <!-- 0: Pinned Header -->
                        <RowDefinition Height="*" />    <!-- 1: Scrollable Form Body -->
                        <RowDefinition Height="Auto" /> <!-- 2: Pinned Action Footer -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Pinned Header with Title & Close -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="EventModalHeaderTitle" Text="添加日程时间块" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" Style="{StaticResource GoogleModalCloseBtnStyle}" HorizontalAlignment="Right" Click="OnCloseEventModalClicked" ToolTip="关闭 (Esc)" />
                    </Grid>

                    <!-- Row 1: Scrollable Form Body with Auto Scrollbar -->
                    <ScrollViewer Grid.Row="1" x:Name="EventModalScrollViewer" MaxHeight="480" VerticalScrollBarVisibility="Hidden" Padding="0,0,6,0">
                        <StackPanel>
                            <!-- Event Title Input -->
                            <TextBlock Text="日程任务标题：" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                            <TextBox x:Name="EventTitleInput" TextChanged="OnEventTitleInputTextChanged" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="10,8" FontSize="14" Margin="0,0,0,12" />

                            <!-- All-Day & Recurrence Controls -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="EventIsAllDayCheck" Content="全天日程 (All-Day)" Foreground="{DynamicResource TextPrimary}" FontSize="12" VerticalAlignment="Center" Checked="OnEventIsAllDayChecked" Unchecked="OnEventIsAllDayChecked" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="🔁 重复:" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <ComboBox x:Name="EventRecurrenceCombo" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" Padding="8,4" FontSize="11" Width="140" SelectedIndex="0">
                                        <ComboBoxItem Content="不重复" Tag="NONE" />
                                        <ComboBoxItem Content="每天" Tag="DAILY" />
                                        <ComboBoxItem Content="工作日 (周一至周五)" Tag="WEEKDAYS" />
                                        <ComboBoxItem Content="每周" Tag="WEEKLY" />
                                        <ComboBoxItem Content="每月" Tag="MONTHLY" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- Date & Time Row (Interactive DatePicker + Editable Time Combos) -->
                            <TextBlock Text="日程日期与起止时段：" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                            <Grid x:Name="EventDateTimeGrid" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.4*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <DatePicker Grid.Column="0" x:Name="EventDatePicker" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Height="32" FontSize="12" VerticalAlignment="Center" SelectedDateChanged="OnEventDatePickerChanged" ToolTip="点击选择日程日期" />
                                <ComboBox Grid.Column="2" x:Name="EventStartTimeCombo" IsEditable="True" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Height="32" FontSize="12" VerticalAlignment="Center" Text="09:00" SelectionChanged="OnEventStartTimeComboChanged" ToolTip="开始时间 (可下拉选取或直接输入，如 09:00 或 9)" />
                                <ComboBox Grid.Column="4" x:Name="EventEndTimeCombo" IsEditable="True" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Height="32" FontSize="12" VerticalAlignment="Center" Text="10:00" ToolTip="结束时间 (可下拉选取或直接输入，如 10:00 或 10)" />
                            </Grid>

                            <!-- 事项类型 (WorkType) -->
                            <TextBlock Text="事项类型：" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                            <ComboBox x:Name="EventWorkTypeCombo" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" Padding="10,6" FontSize="12" Margin="0,0,0,12" SelectedIndex="0">
                                <ComboBoxItem Content="🎯 深度工作" Tag="DEEP_WORK" />
                                <ComboBoxItem Content="⚡ 浅层事务" Tag="SHALLOW_WORK" />
                                <ComboBoxItem Content="☕ 缓冲休息" Tag="REST_BUFFER" />
                            </ComboBox>

                            <!-- 目标层级绑定 (Parent Goal) -->
                            <TextBlock Text="关联父级战略目标 (OKR 穿透)：" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                            <ComboBox x:Name="EventGoalCombo" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" Padding="10,6" FontSize="12" Margin="0,0,0,12" />

                            <!-- Category Input (Select Only + Tag Management Entry) -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="分类标签 (下拉选择)：" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="🏷️ 管理标签" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="8,2" FontSize="11" Click="OnOpenTagManagementClicked" ToolTip="打开标签管理界面（新增、重命名或删除标签）" />
                            </Grid>
                            <ComboBox x:Name="EventCategoryCombo" SelectionChanged="OnEventCategoryComboSelectionChanged" IsEditable="False" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" Padding="10,6" FontSize="12" Margin="0,0,0,12" />

                            <!-- 日程主题色 (Color) 与 自定义RGB 入口 -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="日程主题色 (Color)：" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="🎨 自定义RGB颜色..." Style="{StaticResource GoogleOutlineBtnStyle}" Padding="8,2" FontSize="11" Click="OnOpenCustomColorPickerClicked" ToolTip="打开RGB调色盘自定义颜色并实时预览" />
                            </Grid>
                            <ComboBox x:Name="EventColorCombo" SelectionChanged="OnEventColorComboSelectionChanged" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" Padding="10,6" FontSize="12" Margin="0,0,0,6" SelectedIndex="0">
                                <ComboBoxItem Content="🔵 默认蓝 (#1A73E8)" Tag="#1A73E8" />
                                <ComboBoxItem Content="🟢 翡翠绿 (#059669)" Tag="#059669" />
                                <ComboBoxItem Content="🟣 薰衣紫 (#7C3AED)" Tag="#7C3AED" />
                                <ComboBoxItem Content="🟠 琥珀橙 (#D97706)" Tag="#D97706" />
                                <ComboBoxItem Content="🔴 玫瑰红 (#DC2626)" Tag="#DC2626" />
                                <ComboBoxItem Content="🩵 青碧色 (#0891B2)" Tag="#0891B2" />
                                <ComboBoxItem Content="🔘 炭石灰 (#4B5563)" Tag="#4B5563" />
                                <ComboBoxItem Content="🎨 自定义 RGB 颜色..." Tag="CUSTOM_POPUP" />
                            </ComboBox>

                            <!-- 日程时间块主题色实时预览卡片 (选择后立即可见真实日程效果) -->
                            <Border x:Name="EventColorPreviewCard" Background="#181A73E8" BorderBrush="#1A73E8" BorderThickness="1.5" CornerRadius="6" Padding="12,8" Margin="0,0,0,12" Cursor="Hand" ToolTip="主题色预览（点击可打开RGB调色盘自定义颜色）" MouseLeftButtonDown="OnColorPreviewCardClicked">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="EventColorPreviewSwatch" Grid.Column="0" Width="18" Height="18" CornerRadius="9" Background="#1A73E8" Margin="0,0,10,0" VerticalAlignment="Center" BorderBrush="#33FFFFFF" BorderThickness="1" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="EventColorPreviewTitle" Text="示例日程：深度专注研讨" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                            <Border x:Name="EventColorPreviewTagBadge" Background="#261A73E8" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="EventColorPreviewTagText" Text="工作" FontSize="10" Foreground="#1A73E8" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="EventColorPreviewTime" Text="17:15 - 19:45" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                            <TextBlock x:Name="EventColorPreviewHex" Text="#1A73E8" FontSize="11" FontWeight="SemiBold" FontFamily="Consolas, monospace" Foreground="{DynamicResource TextPrimary}" />
                                        </Border>
                                        <TextBlock Text="预览效果 (点击调色)" FontSize="9.5" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Actuals & Tracking Row (用于复盘与 P&L) -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                        <TextBlock Text="实际耗时(分):" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Text="🔒 专注时钟" FontSize="9" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" ToolTip="由悬浮胶囊/专注时钟真实计时产出，防手动篡改" />
                                    </StackPanel>
                                    <TextBox x:Name="EventActualMinutesInput" IsReadOnly="True" Focusable="False" Background="{DynamicResource ControlBackground}" Foreground="{DynamicResource TextSecondary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="6" FontSize="12" Text="0" ToolTip="实际专注耗时仅由专注计时真实累计，禁止直接修改防作弊" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="打断损耗(分):" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2" />
                                    <TextBox x:Name="EventInterruptionMinutesInput" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="6" FontSize="12" Text="0" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="状态:" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,2" />
                                    <ComboBox x:Name="EventStatusCombo" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" Padding="6" FontSize="11" SelectedIndex="0">
                                        <ComboBoxItem Content="待进行" Tag="PENDING" />
                                        <ComboBoxItem Content="进行中" Tag="IN_PROGRESS" />
                                        <ComboBoxItem Content="已完成" Tag="COMPLETED" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- 弹性幽灵占位 & 坐标锁定 -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                                <CheckBox x:Name="EventIsTentativeCheck" Content="👻 弹性幽灵待确认占位块" Foreground="#93C5FD" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="作为待确认占位，不锁定实际空闲" />
                                <CheckBox x:Name="EventIsLockedCheck" Content="🔒 锁定日程时间坐标" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" VerticalAlignment="Center" ToolTip="锁定坐标防止误拖拽与缩放调整" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Row 2: Pinned Action Footer (Always visible, never cut off!) -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,8,0,0">
                        <Grid>
                            <Button x:Name="EventDeleteBtn" Content="🗑️ 删除日程" Background="Transparent" Foreground="#EA4335" BorderThickness="0" FontSize="12" Cursor="Hand" HorizontalAlignment="Left" Click="OnDeleteEventModalClicked" Visibility="Collapsed" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="取消" Background="Transparent" Foreground="{DynamicResource TextSecondary}" BorderThickness="0" Padding="14,8" FontSize="13" Cursor="Hand" Margin="0,0,10,0" Click="OnCloseEventModalClicked" />
                                <Button x:Name="EventSaveBtn" Content="保存" Style="{StaticResource GoogleActionBtnStyle}" Padding="22,8" FontWeight="SemiBold" FontSize="13" Click="OnSaveEventModalClicked" IsDefault="True" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= MODAL 2: 目标创建/编辑弹窗 (GOAL MODAL) ================= -->
        <Grid x:Name="GoalModal" Visibility="Collapsed" Background="#99000000" Grid.RowSpan="2" Panel.ZIndex="999">
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="GoalModalHeaderTitle" Text="🎯 创建战略层级目标" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" Style="{StaticResource GoogleModalCloseBtnStyle}" HorizontalAlignment="Right" Click="OnCloseGoalModalClicked" ToolTip="关闭 (Esc)" />
                    </Grid>

                    <TextBlock Text="目标层级 (Level)：" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                    <ComboBox x:Name="GoalLevelCombo" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" Padding="10,6" FontSize="12" Margin="0,0,0,12" SelectedIndex="2" SelectionChanged="OnGoalLevelChanged">
                        <ComboBoxItem Content="🌟 长期愿景 (Vision) - 终身/战略方向" Tag="VISION" />
                        <ComboBoxItem Content="🚩 年度目标 (Annual) - 年终里程碑" Tag="ANNUAL" />
                        <ComboBoxItem Content="🎯 季度目标 (Objective) - OKR战役" Tag="OBJECTIVE" />
                        <ComboBoxItem Content="🔷 月度冲刺 (Monthly) - 交付节点" Tag="MONTHLY" />
                        <ComboBoxItem Content="📌 周关键任务 (KeyTask) - 关键产出" Tag="KEY_TASK" />
                    </ComboBox>

                    <TextBlock Text="目标名称：" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                    <TextBox x:Name="GoalTitleInput" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="10,8" FontSize="13" Margin="0,0,0,12" />

                    <TextBlock x:Name="GoalParentLabel" Text="父级目标：" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                    <ComboBox x:Name="GoalParentCombo" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" Padding="10,6" FontSize="12" Margin="0,0,0,12" />

                    <TextBlock Text="周期 / 季度 (如 2026-Q4)：" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                    <TextBox x:Name="GoalQuarterInput" Text="2026-Q4" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="10,6" FontSize="12" Margin="0,0,0,14" />

                    <Grid>
                        <Button x:Name="GoalDeleteBtn" Content="🗑️ 删除" Background="Transparent" Foreground="#EA4335" BorderThickness="0" FontSize="12" Cursor="Hand" HorizontalAlignment="Left" Click="OnDeleteGoalClicked" Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="取消" Background="Transparent" Foreground="{DynamicResource TextSecondary}" BorderThickness="0" Padding="14,8" FontSize="13" Cursor="Hand" Margin="0,0,10,0" Click="OnCloseGoalModalClicked" />
                            <Button Content="保存目标" Style="{StaticResource GoogleActionBtnStyle}" Padding="18,8" FontWeight="SemiBold" FontSize="13" Click="OnSaveGoalClicked" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= MODAL 3: 待办任务创建弹窗 (BACKLOG MODAL) ================= -->
        <Grid x:Name="BacklogModal" Visibility="Collapsed" Background="#99000000" Grid.RowSpan="2" Panel.ZIndex="999">
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📥 添加待办任务至敏捷池" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" Style="{StaticResource GoogleModalCloseBtnStyle}" HorizontalAlignment="Right" Click="OnCloseBacklogModalClicked" ToolTip="关闭 (Esc)" />
                    </Grid>

                    <TextBlock Text="任务名称：" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                    <TextBox x:Name="BacklogTitleInput" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="10,8" FontSize="13" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="优先级：" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                            <ComboBox x:Name="BacklogPriorityCombo" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" Padding="8,6" FontSize="12" SelectedIndex="1">
                                <ComboBoxItem Content="低优先级" Tag="LOW" />
                                <ComboBoxItem Content="中等" Tag="MEDIUM" />
                                <ComboBoxItem Content="高优先级" Tag="HIGH" />
                                <ComboBoxItem Content="紧急" Tag="URGENT" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="预估耗时 (分钟)：" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                            <TextBox x:Name="BacklogMinutesInput" Text="45" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,6" FontSize="12" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="验收标准 (DoD) - 可检验量化标准：" FontSize="12" Foreground="#C084FC" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox x:Name="BacklogDodInput" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="#7C3AED" BorderThickness="1" Padding="8" FontSize="12" Margin="0,0,0,12" />

                    <TextBlock Text="关联战略目标 (OKR)：" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                    <ComboBox x:Name="BacklogGoalCombo" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" Padding="8,6" FontSize="12" Margin="0,0,0,16" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Background="Transparent" Foreground="{DynamicResource TextSecondary}" BorderThickness="0" Padding="14,8" FontSize="13" Cursor="Hand" Margin="0,0,10,0" Click="OnCloseBacklogModalClicked" />
                        <Button Content="存入敏捷池" Style="{StaticResource GoogleActionBtnStyle}" Padding="18,8" FontWeight="SemiBold" FontSize="13" Click="OnSaveBacklogClicked" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

<!-- ================= MODAL 6: 快速跳转指定日期 (GO TO DATE) ================= -->
        <Grid x:Name="GoToDateModal" Visibility="Collapsed" Background="#99000000" Grid.RowSpan="2" Panel.ZIndex="999">
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📅" FontSize="16" Margin="0,0,8,0" />
                            <TextBlock Text="跳转到指定日期" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource GoogleModalCloseBtnStyle}" HorizontalAlignment="Right" Click="OnCloseGoToDateClicked" ToolTip="关闭 (Esc)" />
                    </Grid>

                    <TextBlock Text="选择目标年月日：" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
                    <DatePicker x:Name="GoToDatePicker" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" Margin="0,0,0,18" Padding="6" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Background="Transparent" Foreground="{DynamicResource TextSecondary}" BorderThickness="0" Padding="14,6" FontSize="12" Cursor="Hand" Margin="0,0,8,0" Click="OnCloseGoToDateClicked" />
                        <Button Content="立即跳转" Style="{StaticResource GoogleActionBtnStyle}" Padding="18,6" FontSize="12" FontWeight="SemiBold" Click="OnConfirmGoToDateClicked" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= MODAL 7: 系统与日历设置已迁移至独立主页面 (SettingsPageContainer) ================= -->
        <Grid x:Name="SettingsModal" Visibility="Collapsed" />

        <!-- ================= 8. 本周时间投入与效能复盘模态卡片 (ANALYTICS MODAL) ================= -->
        <Grid x:Name="AnalyticsModal" Visibility="Collapsed" Background="#80000000" Grid.RowSpan="2">
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Width="600" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Title Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="📊 本周时间投入与效能复盘" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock x:Name="AnalyticsDateRangeText" Text="2026年9月28日 - 10月4日" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource GoogleModalCloseBtnStyle}" HorizontalAlignment="Right" Click="OnCloseAnalyticsModalClicked" ToolTip="关闭 (Esc)" />
                    </Grid>

                    <!-- Main Stats Content -->
                    <StackPanel Grid.Row="1">
                        <!-- 4 Metric Cards -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Total Hours -->
                            <Border Grid.Column="0" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="⏱️ 总排期" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock x:Name="AnalyticsTotalHoursText" Text="0.0 h" FontSize="18" FontWeight="Bold" Foreground="#8AB4F8" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Deep Work -->
                            <Border Grid.Column="2" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="🎯 深度工作" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock x:Name="AnalyticsDeepHoursText" Text="0.0 h" FontSize="18" FontWeight="Bold" Foreground="#C084FC" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Shallow Work -->
                            <Border Grid.Column="4" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="⚡ 浅层事务" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock x:Name="AnalyticsShallowHoursText" Text="0.0 h" FontSize="18" FontWeight="Bold" Foreground="#FBBF24" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Rest Buffer -->
                            <Border Grid.Column="6" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="☕ 缓冲恢复" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock x:Name="AnalyticsRestHoursText" Text="0.0 h" FontSize="18" FontWeight="Bold" Foreground="#34D399" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- DoD & Completion Metrics -->
                        <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="✅ 任务完成率" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock x:Name="AnalyticsCompletionRateText" Text="0% (0/0 项已完成)" FontSize="13" FontWeight="SemiBold" Foreground="#34D399" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="📋 DoD 质检设定率" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock x:Name="AnalyticsDodRateText" Text="100% (目标已量化)" FontSize="13" FontWeight="SemiBold" Foreground="#C084FC" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Category Distribution Bars -->
                        <TextBlock Text="🏷️ 各分类时间投入分布：" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" />
                        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Hidden">
                            <StackPanel x:Name="AnalyticsCategoryBarsPanel" />
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Footer -->
                    <Border Grid.Row="2" Margin="0,16,0,0">
                        <Button Content="关闭" Style="{StaticResource GoogleActionBtnStyle}" HorizontalAlignment="Right" Padding="20,6" FontSize="12" FontWeight="SemiBold" Click="OnCloseAnalyticsModalClicked" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= MODAL 9: 学习主题编辑弹窗 (STUDY TOPIC MODAL) ================= -->
        <Grid x:Name="StudyTopicModal" Visibility="Collapsed" Background="#99000000" Grid.RowSpan="2" Panel.ZIndex="999">
            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📚" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="StudyTopicModalHeader" Text="新建学习主题" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource GoogleModalCloseBtnStyle}" HorizontalAlignment="Right" Click="OnCloseStudyTopicModalClicked" ToolTip="关闭 (Esc)" />
                    </Grid>

                    <!-- Title -->
                    <TextBlock Text="主题名称 / 课程书籍名称：" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                    <TextBox x:Name="StudyTopicTitleInput" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,6" FontSize="13" Margin="0,0,0,12" />

                    <!-- Category & Status -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="分类领域：" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                            <ComboBox x:Name="StudyTopicCategoryInput" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" Padding="8,6" FontSize="12">
                                <ComboBoxItem Content="技术栈" IsSelected="True" />
                                <ComboBoxItem Content="计算机基础" />
                                <ComboBoxItem Content="外语" />
                                <ComboBoxItem Content="读书精读" />
                                <ComboBoxItem Content="资格考证" />
                                <ComboBoxItem Content="兴趣" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="当前状态：" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
                            <ComboBox x:Name="StudyTopicStatusInput" Background="{DynamicResource InputBackground}" Foreground="{DynamicResource TextPrimary}" Padding="8,6" FontSize="12">
                                <ComboBoxItem Content="进行中" Tag="IN_PROGRESS" IsSelected="True" />
                                <ComboBoxItem Content="未开始" Tag="NOT_STARTED" />
                                <ComboBoxItem Content="已结业/已学成" Tag="COMPLETED" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- 目标计量类型 (Progress Type) -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
