<Window x:Class="RMF.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Google 日历 - RMF 个人工作台" 
        Height="840" Width="1320"
        MinHeight="680" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#202124"
        Foreground="#E8EAED"
        PreviewKeyDown="OnWindowPreviewKeyDown">

    <Window.Resources>
        <!-- Google Calendar Dark Theme Colors -->
        <SolidColorBrush x:Key="GoogleSurface" Color="#202124" />
        <SolidColorBrush x:Key="GoogleSurfaceVariant" Color="#303134" />
        <SolidColorBrush x:Key="GoogleBorder" Color="#3C4043" />
        <SolidColorBrush x:Key="GoogleBorderSubtle" Color="#2A2B2D" />
        <SolidColorBrush x:Key="GoogleText" Color="#E8EAED" />
        <SolidColorBrush x:Key="GoogleTextSecondary" Color="#9AA0A6" />
        <SolidColorBrush x:Key="GoogleBlue" Color="#1A73E8" />
        <SolidColorBrush x:Key="GoogleBlueHover" Color="#185ABC" />
        <SolidColorBrush x:Key="GoogleBlueLight" Color="#8AB4F8" />
        <SolidColorBrush x:Key="GoogleRed" Color="#EA4335" />
        <SolidColorBrush x:Key="GoogleGreen" Color="#0B8043" />
        <SolidColorBrush x:Key="GoogleYellow" Color="#F4511E" />
        <SolidColorBrush x:Key="GooglePurple" Color="#8E24AA" />

        <!-- Backward compatible aliases -->
        <SolidColorBrush x:Key="SidebarBackground" Color="#202124" />
        <SolidColorBrush x:Key="CardBackground" Color="#202124" />
        <SolidColorBrush x:Key="CardHoverBackground" Color="#303134" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#3C4043" />
        <SolidColorBrush x:Key="TextPrimary" Color="#E8EAED" />
        <SolidColorBrush x:Key="TextSecondary" Color="#9AA0A6" />
        <SolidColorBrush x:Key="TextMuted" Color="#71717A" />
        <SolidColorBrush x:Key="AccentBlue" Color="#1A73E8" />
        <SolidColorBrush x:Key="AccentPurple" Color="#8E24AA" />
        <SolidColorBrush x:Key="AccentGreen" Color="#0B8043" />
        <SolidColorBrush x:Key="AccentRed" Color="#EA4335" />

        <!-- Google Calendar Top Button Style -->
        <Style x:Key="GoogleTopBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E8EAED" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#303134" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Google Action Button Style -->
        <Style x:Key="GoogleActionBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A73E8" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Google Outline Button Style -->
        <Style x:Key="GoogleOutlineBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#8AB4F8" />
            <Setter Property="BorderBrush" Value="#5F6368" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#303134" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Google Create Pill Button Style -->
        <Style x:Key="GoogleCreateBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#37383B" />
            <Setter Property="Foreground" Value="#E8EAED" />
            <Setter Property="BorderBrush" Value="#5F6368" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="22" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#444746" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Right Rail Icon Button Style -->
        <Style x:Key="RightRailBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9AA0A6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="22" Width="40" Height="40">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#303134" />
                                <Setter Property="Foreground" Value="#E8EAED" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#202124">
        <Grid.RowDefinitions>
            <!-- Google Calendar Top Navigation Header Bar -->
            <RowDefinition Height="64" />
            <!-- Main Content Area: Left Drawer + Main Calendar Canvas + Right Companion Drawer + Rail -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= 1. GOOGLE CALENDAR TOP APP BAR ================= -->
        <Border Grid.Row="0" Background="#202124" BorderBrush="#3C4043" BorderThickness="0,0,0,1" Padding="12,0,16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Hamburger, Today, Chevrons, Date Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="HamburgerBtn" Content="☰" Style="{StaticResource GoogleTopBtnStyle}" Width="40" Height="40" FontSize="18" ToolTip="主菜单 (展开/收起左侧栏)" Click="OnToggleLeftSidebarClicked" Margin="0,0,14,0" />
                    <Button x:Name="TopTodayBtn" Content="今天" Style="{StaticResource GoogleOutlineBtnStyle}" Foreground="#E8EAED" Padding="14,6" FontSize="14" FontWeight="Medium" Margin="0,0,14,0" Click="OnCalTodayClicked" ToolTip="跳转到今天 (快捷键: T)" />
                    <Button x:Name="TopPrevBtn" Content="‹" Style="{StaticResource GoogleTopBtnStyle}" Width="32" Height="32" FontSize="22" FontWeight="Bold" ToolTip="前一个时段 (快捷键: J 或 P)" Click="OnCalPrevClicked" Margin="0,0,2,0" />
                    <Button x:Name="TopNextBtn" Content="›" Style="{StaticResource GoogleTopBtnStyle}" Width="32" Height="32" FontSize="22" FontWeight="Bold" ToolTip="后一个时段 (快捷键: K 或 N)" Click="OnCalNextClicked" Margin="0,0,14,0" />
                    <Border Background="Transparent" CornerRadius="4" Padding="6,4" Cursor="Hand" MouseLeftButtonUp="OnTopDateHeaderClicked" ToolTip="点击快速跳转指定日期 (快捷键: G)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TopDateHeaderTitle" Text="2026年10月" FontSize="20" FontWeight="Normal" Foreground="#E8EAED" VerticalAlignment="Center" />
                            <TextBlock Text=" ▾" FontSize="12" Foreground="#9AA0A6" VerticalAlignment="Center" Margin="2,2,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Center: Google Search Pill with Floating Dropdown -->
                <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#303134" CornerRadius="8" MaxWidth="280" Width="260" Height="36" Padding="10,0" VerticalAlignment="Center" Margin="8,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="12" Foreground="#9AA0A6" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="SearchEventsInput" Grid.Column="1" Background="Transparent" Foreground="#E8EAED" BorderThickness="0" FontSize="12" VerticalAlignment="Center" TextChanged="OnSearchEventsTextChanged" ToolTip="搜索日程、DoD 或标签 (快捷键: /)" />
                            <Button Grid.Column="2" x:Name="ClearSearchBtn" Content="✕" Background="Transparent" Foreground="#9AA0A6" BorderThickness="0" FontSize="11" Cursor="Hand" Visibility="Collapsed" Click="OnClearSearchClicked" ToolTip="清空搜索" />
                        </Grid>
                    </Border>

                    <!-- Search Results Floating Popup Dropdown -->
                    <Popup x:Name="SearchResultsPopup" PlacementTarget="{Binding ElementName=SearchEventsInput}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="8" HorizontalOffset="-30">
                        <Border Background="#28292C" BorderBrush="#5F6368" BorderThickness="1" CornerRadius="8" Width="360" MaxHeight="320" Padding="8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="Black" />
                            </Border.Effect>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="🔍 搜索匹配结果" FontSize="11" Foreground="#9AA0A6" Margin="4,2,4,6" FontWeight="SemiBold" />
                                    <StackPanel x:Name="SearchResultsListPanel" />
                                    <TextBlock x:Name="SearchResultsEmptyText" Text="未找到匹配的日程" FontSize="11" Foreground="#71717A" Margin="4,4,4,4" Visibility="Collapsed" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>

                <!-- Right: Sync Telemetry Badge, Conflict Button, View Switcher, Settings, Avatar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Granular Sync Status Badge -->
                    <Border x:Name="CalSyncBadge" Background="#303134" BorderBrush="#5F6368" BorderThickness="1" CornerRadius="4" Padding="10,5" Margin="0,0,10,0" Cursor="Hand" ToolTip="点击查看同步与客户端来源遥测" MouseLeftButtonUp="OnSyncBadgeClicked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="CalSyncStatusDot" Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" />
                            <TextBlock x:Name="CalSyncStatusText" Text="🟢 本地与云端一致" FontSize="12" Foreground="#E8EAED" />
                        </StackPanel>
                    </Border>

                    <Button x:Name="CalSyncNowBtn" Content="🔄 同步" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="12,5" FontSize="13" FontWeight="Medium" Margin="0,0,14,0" Click="OnSyncGoogleCalendarClicked" ToolTip="立即同步 Google 日历" />

                    <!-- View Selector: 日 (Day) / 周 (Week) / 月 (Month) / 年 (Year) / 自定义 (Custom) -->
                    <Border Background="#303134" BorderBrush="#5F6368" BorderThickness="1" CornerRadius="4" Padding="2" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ViewDayBtn" Content="日" Style="{StaticResource GoogleTopBtnStyle}" Foreground="#E8EAED" Padding="12,4" FontSize="13" FontWeight="Normal" Click="OnViewDayClicked" ToolTip="日视图 (快捷键: D)" />
                            <Button x:Name="ViewWeekBtn" Content="周" Style="{StaticResource GoogleTopBtnStyle}" Background="#1A73E8" Foreground="#FFFFFF" Padding="12,4" FontSize="13" FontWeight="SemiBold" Click="OnViewWeekClicked" ToolTip="周视图 (快捷键: W)" />
                            <Button x:Name="ViewMonthBtn" Content="月" Style="{StaticResource GoogleTopBtnStyle}" Foreground="#E8EAED" Padding="12,4" FontSize="13" FontWeight="Normal" Click="OnViewMonthClicked" ToolTip="月视图 (快捷键: M)" />
                            <Button x:Name="ViewYearBtn" Content="年" Style="{StaticResource GoogleTopBtnStyle}" Foreground="#E8EAED" Padding="12,4" FontSize="13" FontWeight="Normal" Click="OnViewYearClicked" ToolTip="年视图 (快捷键: Y)" />
                            <Button x:Name="ViewCustomBtn" Content="自定义" Style="{StaticResource GoogleTopBtnStyle}" Foreground="#E8EAED" Padding="12,4" FontSize="13" FontWeight="Normal" Click="OnViewCustomClicked" ToolTip="自定义/4天视图 (快捷键: X)" />
                        </StackPanel>
                    </Border>

                    <!-- Settings Gear -->
                    <Button Content="⚙️" Style="{StaticResource GoogleTopBtnStyle}" Width="36" Height="36" FontSize="16" ToolTip="系统与 API 配置" Click="OnToggleSettingsDrawerClicked" Margin="0,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 2. MAIN BODY (LEFT DRAWER + CALENDAR CANVAS + RIGHT DRAWER + RAIL) ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Column 0: Left Google Drawer (Collapsible) -->
                <ColumnDefinition Width="280" x:Name="LeftSidebarColumn" />
                <!-- Column 1: Main Google Calendar Canvas (Week / Day / Month / Agenda) -->
                <ColumnDefinition Width="*" />
                <!-- Column 2: Right Companion Drawer (Collapsed) -->
                <ColumnDefinition Width="0" x:Name="RightDrawerColumn" />
                <!-- Column 3: Far-Right Google Workspace Rail (Collapsed/Removed) -->
                <ColumnDefinition Width="0" x:Name="RightRailColumn" />
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT DRAWER ================= -->
            <Border Grid.Column="0" Background="#202124" BorderBrush="#3C4043" BorderThickness="0,0,1,0" Padding="12,14,12,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Top Action Buttons: "+ 创建日程" and "+ 待办" -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="GoogleCreateBtn" Style="{StaticResource GoogleCreateBtnStyle}" HorizontalAlignment="Left" Click="OnGoogleCreateClicked">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="➕" FontSize="14" Foreground="#8AB4F8" FontWeight="Bold" Margin="0,0,8,0" />
                                    <TextBlock Text="创建" FontSize="14" FontWeight="SemiBold" Foreground="#E8EAED" Margin="0,0,6,0" />
                                    <TextBlock Text="▾" FontSize="11" Foreground="#9AA0A6" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Content="+ 待办" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="10,6" FontSize="12" FontWeight="Medium" Click="OnAddBacklogClicked" ToolTip="直接创建未排期任务存入敏捷池" />
                        </Grid>

                        <!-- Interactive Mini Month Calendar (Date Picker) -->
                        <Border Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="4,0,4,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="MiniCalMonthTitle" Text="2026年10月" FontSize="13" FontWeight="SemiBold" Foreground="#E8EAED" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="‹" Style="{StaticResource GoogleTopBtnStyle}" Width="24" Height="24" FontSize="16" FontWeight="Bold" Click="OnMiniCalPrevClicked" />
                                    <Button Grid.Column="2" Content="›" Style="{StaticResource GoogleTopBtnStyle}" Width="24" Height="24" FontSize="16" FontWeight="Bold" Click="OnMiniCalNextClicked" />
                                </Grid>

                                <UniformGrid Columns="7" Margin="0,0,0,4">
                                    <TextBlock Text="一" FontSize="11" Foreground="#9AA0A6" HorizontalAlignment="Center" />
                                    <TextBlock Text="二" FontSize="11" Foreground="#9AA0A6" HorizontalAlignment="Center" />
                                    <TextBlock Text="三" FontSize="11" Foreground="#9AA0A6" HorizontalAlignment="Center" />
                                    <TextBlock Text="四" FontSize="11" Foreground="#9AA0A6" HorizontalAlignment="Center" />
                                    <TextBlock Text="五" FontSize="11" Foreground="#9AA0A6" HorizontalAlignment="Center" />
                                    <TextBlock Text="六" FontSize="11" Foreground="#9AA0A6" HorizontalAlignment="Center" />
                                    <TextBlock Text="日" FontSize="11" Foreground="#9AA0A6" HorizontalAlignment="Center" />
                                </UniformGrid>

                                <UniformGrid x:Name="MiniCalGrid" Columns="7" Rows="6" />
                            </StackPanel>
                        </Border>

                        <Border Height="1" Background="#3C4043" Margin="0,0,0,14" />

                        <!-- ================= MODULE 2.1: 待办任务敏捷池 (BACKLOG DRAWER) ================= -->
                        <Border Background="#28292C" BorderBrush="#3C4043" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="📥" FontSize="13" Margin="0,0,6,0" />
                                        <TextBlock Text="待办敏捷池 (Backlog)" FontSize="12" FontWeight="SemiBold" Foreground="#E8EAED" />
                                        <Border x:Name="BacklogCountBadge" Background="#37383B" CornerRadius="10" Padding="6,1" Margin="6,0,0,0">
                                            <TextBlock x:Name="BacklogCountText" Text="0" FontSize="10" Foreground="#8AB4F8" FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="+" Style="{StaticResource GoogleTopBtnStyle}" Width="24" Height="24" FontSize="14" HorizontalAlignment="Right" ToolTip="添加待办任务" Click="OnAddBacklogClicked" />
                                </Grid>

                                <TextBlock Text="💡 提示：点击或拖拽卡片，可直接投放至主时间轴任意空白槽排期" FontSize="10" Foreground="#9AA0A6" Margin="0,0,0,6" TextWrapping="Wrap" />

                                <StackPanel x:Name="BacklogItemsPanel" />
                                <TextBlock x:Name="BacklogEmptyText" Text="暂无未排期任务，点击右上角「+」暂存" FontSize="11" Foreground="#71717A" Margin="4,4,0,4" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <!-- ================= MODULE 2.2: 目标层级穿透树 (GOAL TREE) ================= -->
                        <Border Background="#28292C" BorderBrush="#3C4043" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🎯" FontSize="13" Margin="0,0,6,0" />
                                        <TextBlock Text="目标层级树 (OKR)" FontSize="12" FontWeight="SemiBold" Foreground="#E8EAED" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="+ 目标" Background="Transparent" Foreground="#8AB4F8" BorderThickness="0" FontSize="11" HorizontalAlignment="Right" Cursor="Hand" Click="OnAddGoalClicked" ToolTip="新增战略目标 (愿景/季度/周成果)" />
                                </Grid>

                                <TextBlock Text="长期愿景 ➔ 季度目标 ➔ 周关键任务" FontSize="10" Foreground="#9AA0A6" Margin="0,0,0,8" />

                                <StackPanel x:Name="GoalTreePanel" />
                            </StackPanel>
                        </Border>

                        <!-- "我的日历" 动态分类标签 Section -->
                        <Expander Header="🏷️ 分类筛选标签" Foreground="#9AA0A6" FontSize="12" IsExpanded="False" Margin="0,0,0,12">
                            <StackPanel Margin="0,6,0,0">
                                <StackPanel x:Name="MyCalendarsCategoryListPanel" />
                                <TextBlock x:Name="MyCalendarsEmptyText" Text="暂无分类标签" FontSize="11" Foreground="#71717A" Margin="4,0,0,4" Visibility="Collapsed" />
                            </StackPanel>
                        </Expander>

                        <!-- System Telemetry Card -->
                        <Border Background="#28292C" BorderBrush="#3C4043" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,6,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                    <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0" />
                                    <TextBlock Text="极轻本地引擎" FontSize="11" FontWeight="SemiBold" Foreground="#9AA0A6" />
                                </StackPanel>
                                <TextBlock Name="MemoryUsageText" Text="内存: 24.5 MB" FontSize="12" FontWeight="Bold" Foreground="#8AB4F8" Margin="0,0,0,2" />
                                <TextBlock Name="CpuUsageText" Text="CPU: 0.0% (零后台轮询)" FontSize="10" Foreground="#71717A" Margin="0,0,0,6" />
                                <Button Content="⚡ 内存瞬间压制" Background="#37383B" Foreground="#E8EAED" BorderThickness="0" Padding="8,4" FontSize="11" HorizontalAlignment="Stretch" Cursor="Hand" Click="OnTrimMemoryClicked" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ================= CENTER: GOOGLE CALENDAR MAIN MULTI-VIEW CANVAS ================= -->
            <Grid Grid.Column="1" Background="#202124">
                <!-- 1. 周视图 (WEEK VIEW - 7 COLUMNS) [DEFAULT] -->
                <Grid x:Name="WeekViewContainer" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <!-- Week Header (Days of week + date circle) -->
                        <RowDefinition Height="64" />
                        <!-- All-Day Events Slot Row -->
                        <RowDefinition Height="Auto" />
                        <!-- 24-Hour Scrollable Time Grid Canvas -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Week Header Row -->
                    <Border Grid.Row="0" Background="#202124" BorderBrush="#3C4043" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="GMT+8" FontSize="10" Foreground="#9AA0A6" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                            <UniformGrid Grid.Column="1" x:Name="WeekHeaderGrid" Columns="7" />
                        </Grid>
                    </Border>

                    <!-- All-Day Row (if any) -->
                    <Border Grid.Row="1" x:Name="WeekAllDayBorder" Background="#202124" BorderBrush="#3C4043" BorderThickness="0,0,0,1" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="全天" FontSize="11" Foreground="#9AA0A6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <UniformGrid Grid.Column="1" x:Name="WeekAllDayGrid" Columns="7" />
                        </Grid>
                    </Border>

                    <!-- 24-Hour Scrollable Week Grid -->
                    <ScrollViewer Grid.Row="2" x:Name="WeekScrollViewer" VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="WeekGridTrack">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: 24 Hour Labels -->
                            <StackPanel Grid.Column="0" x:Name="WeekHourLabelsPanel" />

                            <!-- Right: 7-Column Grid Lines + Clickable Slots + Events Canvas -->
                            <Grid Grid.Column="1">
                                <UniformGrid x:Name="WeekSlotsGrid" Columns="7" />

                                <!-- Absolute Canvas for Events & Red Indicator Line & Drag-to-Select Selection Box -->
                                <Canvas x:Name="WeekEventsCanvas" ClipToBounds="True" Background="Transparent"
                                        MouseLeftButtonDown="OnCanvasMouseLeftButtonDown"
                                        MouseMove="OnCanvasMouseMove"
                                        MouseLeftButtonUp="OnCanvasMouseLeftButtonUp"
                                        DragOver="OnWeekCanvasDragOver"
                                        Drop="OnWeekCanvasDrop"
                                        AllowDrop="True" />
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- 2. 天视图 (DAY VIEW - 1 COLUMN) -->
                <Grid x:Name="DayViewContainer" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Day Header -->
                    <Border Grid.Row="0" Background="#202124" BorderBrush="#3C4043" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="GMT+8" FontSize="10" Foreground="#9AA0A6" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Border x:Name="DayHeaderDateBadge" Background="#1A73E8" Width="40" Height="40" CornerRadius="20" Margin="0,0,12,0">
                                    <TextBlock x:Name="DayHeaderDateNumText" Text="2" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="DayHeaderWeekdayText" Text="星期五" FontSize="15" FontWeight="SemiBold" Foreground="#8AB4F8" />
                                    <TextBlock x:Name="DayHeaderFullDateText" Text="2026年10月2日" FontSize="12" Foreground="#9AA0A6" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 24-Hour Day Grid -->
                    <ScrollViewer Grid.Row="1" x:Name="DayScrollViewer" VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="DayGridTrack">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" x:Name="DayHourLabelsPanel" />
                            <Grid Grid.Column="1">
                                <StackPanel x:Name="DayHourSlotsPanel" />
                                <Canvas x:Name="DayEventsCanvas" ClipToBounds="True" Background="Transparent"
                                        MouseLeftButtonDown="OnCanvasMouseLeftButtonDown"
                                        MouseMove="OnCanvasMouseMove"
                                        MouseLeftButtonUp="OnCanvasMouseLeftButtonUp" />
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- 3. 月视图 (MONTH VIEW) -->
                <Grid x:Name="MonthViewContainer" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#202124" BorderBrush="#3C4043" BorderThickness="0,0,0,1">
                        <UniformGrid Columns="7">
                            <TextBlock Text="周一" FontSize="12" Foreground="#9AA0A6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="周二" FontSize="12" Foreground="#9AA0A6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="周三" FontSize="12" Foreground="#9AA0A6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="周四" FontSize="12" Foreground="#9AA0A6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="周五" FontSize="12" Foreground="#9AA0A6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="周六" FontSize="12" Foreground="#9AA0A6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBlock Text="周日" FontSize="12" Foreground="#9AA0A6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </UniformGrid>
                    </Border>

                    <UniformGrid Grid.Row="1" x:Name="MonthCellsGrid" Columns="7" Rows="6" />
                </Grid>

                <!-- 4. 日程清单视图 (AGENDA VIEW) -->
                <Grid x:Name="AgendaViewContainer" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
                        <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                            <TextBlock Text="📋 日程安排与议程清单" FontSize="18" FontWeight="Bold" Foreground="#E8EAED" Margin="0,0,0,16" />
                            
                            <Border x:Name="AgendaEmptyState" Background="#28292C" BorderBrush="#3C4043" BorderThickness="1" CornerRadius="10" Padding="36" Margin="0,10,0,0" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📅" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" />
                                    <TextBlock Text="当前周期内暂无排期日程" FontSize="15" FontWeight="SemiBold" Foreground="#E8EAED" HorizontalAlignment="Center" Margin="0,0,0,6" />
                                    <TextBlock Text="点击左上角「+ 创建」或点击网格时段快速添加" FontSize="12" Foreground="#9AA0A6" HorizontalAlignment="Center" Margin="0,0,16,0" />
                                    <Button Content="+ 立即创建日程" Background="#1A73E8" Foreground="#FFFFFF" BorderThickness="0" Padding="18,8" FontWeight="SemiBold" FontSize="13" Cursor="Hand" HorizontalAlignment="Center" Click="OnGoogleCreateClicked" />
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="AgendaListPanel" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 5. 年视图 (YEAR VIEW - 12 MONTHS OVERVIEW) -->
                <Grid x:Name="YearViewContainer" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Year Header & Metrics -->
                    <Border Grid.Row="0" Background="#202124" BorderBrush="#3C4043" BorderThickness="0,0,0,1" Padding="20,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="YearViewTitleText" Text="2026 年度日程概览" FontSize="18" FontWeight="Bold" Foreground="#E8EAED" Margin="0,0,16,0" />
                                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,10,0">
                                    <TextBlock x:Name="YearTotalEventsText" Text="全年共 0 个日程" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold" />
                                </Border>
                                <Border Background="#14532D" CornerRadius="4" Padding="8,4">
                                    <TextBlock x:Name="YearDeepWorkHoursText" Text="深度工作: 0.0 小时" FontSize="12" Foreground="#4ADE80" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="1" Content="📅 跳转到本月" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="12,5" FontSize="12" Click="OnYearJumpCurrentMonthClicked" />
                        </Grid>
                    </Border>

                    <!-- 12 Months Grid (4 Columns x 3 Rows) -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
                        <UniformGrid x:Name="YearMonthsGrid" Columns="4" Rows="3" HorizontalAlignment="Stretch" VerticalAlignment="Top" />
                    </ScrollViewer>
                </Grid>

                <!-- 6. 真正意义上的自由自定义排期视图 (TRULY CUSTOM RANGE CALENDAR VIEW) -->
                <Grid x:Name="CustomViewContainer" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <!-- Row 0: Full Custom Range Controls Toolbar -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Custom Header Row (With Sync Horizontal Scroll) -->
                        <RowDefinition Height="64" />
                        <!-- Row 2: Custom All-Day Row (With Sync Horizontal Scroll) -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 3: Main Timeline View / Multi-Day Agenda View -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Toolbar - 自由日期范围挑选与天数输入 -->
                    <Border Grid.Row="0" Background="#28292C" BorderBrush="#3C4043" BorderThickness="0,0,0,1" Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Top Line: 自定义日期范围选择器 + 天数微调 + 应用按钮 -->
                            <WrapPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="📅 起始:" FontSize="12" Foreground="#9AA0A6" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <DatePicker x:Name="CustomStartDatePicker" Width="155" Height="28" Background="#202124" Foreground="#E8EAED" BorderBrush="#5F6368" VerticalContentAlignment="Center" FontSize="12" SelectedDateChanged="OnCustomDateRangePickerChanged" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="至  结束:" FontSize="12" Foreground="#9AA0A6" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <DatePicker x:Name="CustomEndDatePicker" Width="155" Height="28" Background="#202124" Foreground="#E8EAED" BorderBrush="#5F6368" VerticalContentAlignment="Center" FontSize="12" SelectedDateChanged="OnCustomDateRangePickerChanged" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="跨度:" FontSize="12" Foreground="#9AA0A6" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <Button Content="-" Style="{StaticResource GoogleTopBtnStyle}" Width="24" Height="28" Padding="0" Click="OnCustomDaysDecrementClicked" ToolTip="减少 1 天" />
                                    <TextBox x:Name="CustomDaysInput" Text="4" Width="40" Height="28" Background="#202124" Foreground="#38BDF8" BorderBrush="#5F6368" BorderThickness="1" TextAlignment="Center" VerticalContentAlignment="Center" FontSize="12" FontWeight="SemiBold" KeyDown="OnCustomDaysInputKeyDown" Margin="3,0" />
                                    <Button Content="+" Style="{StaticResource GoogleTopBtnStyle}" Width="24" Height="28" Padding="0" Click="OnCustomDaysIncrementClicked" ToolTip="增加 1 天" />
                                    <TextBlock Text="天" FontSize="12" Foreground="#9AA0A6" VerticalAlignment="Center" Margin="4,0,0,0" />
                                </StackPanel>

                                <Button Content="✓ 应用范围" Style="{StaticResource GoogleActionBtnStyle}" Padding="10,4" FontSize="12" FontWeight="SemiBold" Click="OnApplyCustomDateRangeClicked" Margin="0,0,14,0" />

                                <!-- View Mode Toggle: 时间轴网格 vs 多日清单 -->
                                <Border Background="#202124" BorderBrush="#3C4043" BorderThickness="1" CornerRadius="4" Padding="2" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="CustomModeTimelineBtn" Content="📊 时间网格" Style="{StaticResource GoogleTopBtnStyle}" Background="#1A73E8" Foreground="#FFFFFF" Padding="8,3" FontSize="11" FontWeight="SemiBold" Click="OnCustomModeTimelineClicked" />
                                        <Button x:Name="CustomModeAgendaBtn" Content="📋 多日清单" Style="{StaticResource GoogleTopBtnStyle}" Foreground="#E8EAED" Padding="8,3" FontSize="11" FontWeight="Normal" Click="OnCustomModeAgendaClicked" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <!-- Bottom Line: 快速预设标签与状态提示 -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="快捷预设：" FontSize="11" Foreground="#71717A" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <Button Content="3天" Style="{StaticResource GoogleTopBtnStyle}" Padding="6,2" FontSize="11" Margin="0,0,4,0" Click="OnCustomPreset3Days" />
                                    <Button Content="4天" Style="{StaticResource GoogleTopBtnStyle}" Padding="6,2" FontSize="11" Margin="0,0,4,0" Click="OnCustomPreset4Days" />
                                    <Button Content="5天(工作日)" Style="{StaticResource GoogleTopBtnStyle}" Padding="6,2" FontSize="11" Margin="0,0,4,0" Click="OnCustomPreset5Days" />
                                    <Button Content="7天(整周)" Style="{StaticResource GoogleTopBtnStyle}" Padding="6,2" FontSize="11" Margin="0,0,4,0" Click="OnCustomPreset7Days" />
                                    <Button Content="10天" Style="{StaticResource GoogleTopBtnStyle}" Padding="6,2" FontSize="11" Margin="0,0,4,0" Click="OnCustomPreset10Days" />
                                    <Button Content="14天(两周)" Style="{StaticResource GoogleTopBtnStyle}" Padding="6,2" FontSize="11" Margin="0,0,4,0" Click="OnCustomPreset14Days" />
                                    <Button Content="30天(月度)" Style="{StaticResource GoogleTopBtnStyle}" Padding="6,2" FontSize="11" Margin="0,0,4,0" Click="OnCustomPreset30Days" />
                                    <Button Content="本月剩余" Style="{StaticResource GoogleTopBtnStyle}" Padding="6,2" FontSize="11" Click="OnCustomPresetRestOfMonth" />
                                </WrapPanel>

                                <TextBlock Grid.Column="1" x:Name="CustomRangeNoticeText" Text="" FontSize="11" Foreground="#38BDF8" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Row 1: Custom Header Row (With Sync Horizontal Scroll) -->
                    <Border Grid.Row="1" Background="#202124" BorderBrush="#3C4043" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="GMT+8" FontSize="10" Foreground="#9AA0A6" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                            <ScrollViewer Grid.Column="1" x:Name="CustomHeaderScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" x:Name="CustomHeaderContainer" />
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Row 2: Custom All-Day Row (With Sync Horizontal Scroll) -->
                    <Border Grid.Row="2" x:Name="CustomAllDayBorder" Background="#202124" BorderBrush="#3C4043" BorderThickness="0,0,0,1" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="54" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="全天" FontSize="11" Foreground="#9AA0A6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <ScrollViewer Grid.Column="1" x:Name="CustomAllDayScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                <StackPanel Orientation="Horizontal" x:Name="CustomAllDayContainer" />
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Row 3A: 24-Hour Scrollable Custom Grid (With Bi-Directional Scroll) -->
                    <Grid Grid.Row="3" x:Name="CustomTimelineViewGrid" Visibility="Visible">
                        <ScrollViewer x:Name="CustomScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" ScrollChanged="OnCustomScrollViewerScrollChanged">
                            <Grid x:Name="CustomGridTrack">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 24 Hour Labels -->
                                <StackPanel Grid.Column="0" x:Name="CustomHourLabelsPanel" />

                                <!-- N-Column Grid Lines + Clickable Slots + Events Canvas -->
                                <Grid Grid.Column="1" x:Name="CustomCanvasContainer">
                                    <StackPanel Orientation="Horizontal" x:Name="CustomSlotsContainer" />

                                    <!-- Absolute Canvas for Events & Red Indicator Line -->
                                    <Canvas x:Name="CustomEventsCanvas" ClipToBounds="True" Background="Transparent"
                                            MouseLeftButtonDown="OnCanvasMouseLeftButtonDown"
                                            MouseMove="OnCanvasMouseMove"
                                            MouseLeftButtonUp="OnCanvasMouseLeftButtonUp"
                                            DragOver="OnWeekCanvasDragOver"
                                            Drop="OnCustomCanvasDrop"
                                            AllowDrop="True" />
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <!-- Row 3B: 多日看板清单视图 (When CustomModeAgenda is active) -->
                    <Grid Grid.Row="3" x:Name="CustomAgendaViewGrid" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
                            <StackPanel MaxWidth="840" HorizontalAlignment="Left" x:Name="CustomAgendaListPanel" />
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ================= RIGHT COMPANION SLIDE-OUT DRAWER (COLLAPSED) ================= -->
            <Border Grid.Column="2" Background="#202124" BorderBrush="#3C4043" BorderThickness="1,0,0,0" Visibility="Collapsed">
                <Grid>
                    <!-- Close button in drawer top-right -->
                    <Button Content="✕" Style="{StaticResource GoogleTopBtnStyle}" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" Panel.ZIndex="10" Click="OnCloseRightDrawerClicked" />

                    <!-- ================= DRAWER 1: AI 客观日程调度与审计引擎 (✨) ================= -->
                    <Grid x:Name="DrawerGeminiPanel" Visibility="Collapsed" Margin="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,0,20">
                                <!-- Drawer Header -->
                                <StackPanel Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="✨" FontSize="20" Margin="0,0,8,0" />
                                        <TextBlock Text="AI 客观日程调度与审计" FontSize="16" FontWeight="Bold" Foreground="#E8EAED" />
                                    </StackPanel>
                                    <TextBlock Text="冷酷客观 · DoD质检 · 4.5h熔断 · 精力曲线拟合" FontSize="11" Foreground="#9AA0A6" Margin="28,2,0,0" />
                                </StackPanel>

                                <!-- 1. 认知负荷配额与审计体检概览 -->
                                <Border Background="#28292C" BorderBrush="#3C4043" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🧠 深度工作配额" FontSize="12" FontWeight="SemiBold" Foreground="#E8EAED" />
                                                <Border x:Name="AuditHealthScoreBadge" Background="#132E27" CornerRadius="4" Padding="6,1" Margin="6,0,0,0">
                                                    <TextBlock x:Name="AuditHealthScoreText" Text="体检: 100分" FontSize="10" Foreground="#34D399" FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" x:Name="CognitiveLoadText" Text="已用 0.0h / 4.5h (0%)" FontSize="11" Foreground="#8AB4F8" VerticalAlignment="Center" Margin="6,0,0,0" />
                                        </Grid>
                                        <ProgressBar x:Name="CognitiveLoadProgressBar" Minimum="0" Maximum="270" Value="0" Height="8" Background="#1E1B4B" Foreground="#8B5CF6" Margin="0,0,0,6" />
                                        
                                        <!-- 排期熔断警示横幅 (超限时激活) -->
                                        <Border x:Name="CognitiveCircuitBreakerBanner" Background="#3B0713" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="8" Visibility="Collapsed" Margin="0,4,0,0">
                                            <StackPanel>
                                                <TextBlock Text="🚨 认知负荷严重超载！已触发排期熔断" FontSize="11" FontWeight="Bold" Foreground="#FCA5A5" Margin="0,0,0,2" />
                                                <TextBlock Text="今日深度工作已突破 4.5h 生理极限，调度引擎已拒绝继续排入高脑力任务，请将次要任务移入延期冻结池。" FontSize="10" Foreground="#F87171" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- 2. 核心调度与审计双引擎触发区 (Auto-Schedule & Audit Scan) -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="AutoScheduleBtn" Content="🤖 一键客观重排" Background="#1A73E8" Foreground="#FFFFFF" BorderThickness="0" Padding="8,8" FontSize="12" FontWeight="SemiBold" Cursor="Hand" ToolTip="读取待办敏捷池，按四大客观规则自动拟合空闲时段" Click="OnAutoScheduleClicked" />
                                    <Button Grid.Column="2" x:Name="AuditScanBtn" Content="🩺 排期审计体检" Background="#7C3AED" Foreground="#FFFFFF" BorderThickness="0" Padding="8,8" FontSize="12" FontWeight="SemiBold" Cursor="Hand" ToolTip="全盘体检今日时间块的负荷、DoD 与缓冲合规性" Click="OnRunAuditScanClicked" />
                                </Grid>

                                <!-- 3. 一键客观重排建议方案反馈卡片 (Auto-Schedule Preview Card) -->
                                <Border x:Name="AutoSchedulePreviewCard" Background="#1E1E2E" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="📋 客观重排方案建议 (待确认)" FontSize="12" FontWeight="Bold" Foreground="#93C5FD" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="1" Content="✕" Background="Transparent" Foreground="#9AA0A6" BorderThickness="0" FontSize="11" HorizontalAlignment="Right" Cursor="Hand" Click="OnCancelAutoSchedulePlanClicked" />
                                        </Grid>

                                        <!-- 决策归因日志 -->
                                        <Border Background="#13131F" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                            <StackPanel x:Name="AutoScheduleDecisionLogsPanel" />
                                        </Border>

                                        <!-- 拟排入时间块与被拒/延期任务列表 -->
                                        <StackPanel x:Name="AutoSchedulePreviewItemsPanel" Margin="0,0,0,10" />

                                        <!-- 确认应用方案按钮 -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="✅ 确认应用并写入主网格" Background="#059669" Foreground="#FFFFFF" BorderThickness="0" Padding="10,6" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Click="OnApplyAutoSchedulePlanClicked" />
                                            <Button Grid.Column="2" Content="放弃" Background="Transparent" Foreground="#9AA0A6" BorderThickness="0" Padding="8,6" FontSize="11" Cursor="Hand" Click="OnCancelAutoSchedulePlanClicked" />
                                        </Grid>
                                        <TextBlock x:Name="AutoScheduleStatusText" Text="" FontSize="10" Foreground="#10B981" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- 4. 排期审计体检报告卡片 (Audit Scan Result Card) -->
                                <Border x:Name="AuditScanResultCard" Background="#231A38" BorderBrush="#5B21B6" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="🩺 排期审计体检剖析" FontSize="12" FontWeight="Bold" Foreground="#D8B4FE" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="1" Content="✕" Background="Transparent" Foreground="#9AA0A6" BorderThickness="0" FontSize="11" HorizontalAlignment="Right" Cursor="Hand" Click="OnCloseAuditScanResultClicked" />
                                        </Grid>

                                        <TextBlock x:Name="AuditScanSummaryText" Text="体检扫描中..." FontSize="11" Foreground="#E9D5FF" LineHeight="16" Margin="0,0,0,8" TextWrapping="Wrap" />

                                        <!-- 违规与风险隐患列表 -->
                                        <StackPanel x:Name="AuditScanIssuesPanel" Margin="0,0,0,8" />

                                        <!-- AI 专家级审计裁决输出 -->
                                        <Border Background="#160D29" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                                            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                                                <TextBlock x:Name="AuditResultText" Text="（等待 AI 深度审计分析...）" FontSize="11" LineHeight="16" Foreground="#C4B5FD" TextWrapping="Wrap" />
                                            </ScrollViewer>
                                        </Border>

                                        <TextBlock x:Name="AuditRecommendationsText" Text="" FontSize="11" Foreground="#6EE7B7" Margin="0,0,0,6" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- 5. 历史乐观偏差率 (α 乘数) 与转场缓冲建议 -->
                                <Border Background="#28292C" BorderBrush="#3C4043" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="📈 历史乐观偏差率 (α 乘数)" FontSize="12" FontWeight="SemiBold" Foreground="#E8EAED" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="1" Background="#3B1C54" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                                <TextBlock x:Name="OptimismAlphaText" Text="α = 1.35x" FontSize="12" FontWeight="Bold" Foreground="#D8B4FE" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="根据历史完成任务的实际耗时/预估比值动态学习（通常低估 35% 耗时）。" FontSize="10" Foreground="#9AA0A6" Margin="0,0,0,8" TextWrapping="Wrap" />
                                        <Button x:Name="ApplyOptimismBufferBtn" Content="🪄 一键按 α 系数追加转场缓冲" Background="#37383B" Foreground="#E8EAED" BorderThickness="0" Padding="10,6" FontSize="11" FontWeight="SemiBold" Cursor="Hand" Click="OnApplyOptimismBufferClicked" />
                                        <TextBlock x:Name="OptimismBufferStatusText" Text="" FontSize="10" Foreground="#10B981" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- 6. 次要任务延期冻结池 (Deferred Queue) -->
                                <Border Background="#28292C" BorderBrush="#3C4043" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="❄️ 次要延期冻结池" FontSize="12" FontWeight="SemiBold" Foreground="#E8EAED" />
                                                <Border Background="#1E293B" CornerRadius="10" Padding="6,1" Margin="6,0,0,0">
                                                    <TextBlock x:Name="DeferredCountText" Text="0" FontSize="10" Foreground="#94A3B8" FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="锁定今日不可排入" FontSize="10" Foreground="#F472B6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0" />
                                        </Grid>
                                        <TextBlock Text="超出 4.5h 负荷硬顶或被审计驳回的任务自动在此冻结：" FontSize="10" Foreground="#9AA0A6" Margin="0,0,0,6" />
                                        
                                        <StackPanel x:Name="DeferredItemsPanel" />
                                        <TextBlock x:Name="DeferredEmptyText" Text="当前冻结池为空，所有任务排期合理。" FontSize="11" Foreground="#71717A" Margin="2,2,0,2" Visibility="Visible" />
                                    </StackPanel>
                                </Border>

                                <!-- 7. 前台嗅探流与决策推演 (Idea Auditor) -->
                                <Border Background="#28292C" BorderBrush="#3C4043" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="前台活动嗅探流" FontSize="11" Foreground="#9AA0A6" Margin="0,0,0,4" />
                                        <TextBlock x:Name="ActiveWindowText" Text="嗅探中..." FontSize="12" FontWeight="SemiBold" Foreground="#8AB4F8" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="💡 想法与决策评估：" FontSize="12" FontWeight="SemiBold" Foreground="#E8EAED" Margin="0,0,0,4" />
                                <TextBox x:Name="UserIdeaInput" Background="#28292C" Foreground="#E8EAED" BorderBrush="#3C4043" BorderThickness="1" Padding="8" FontSize="12" Height="50" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <Button x:Name="EvaluateIdeaBtn" Content="🚀 深入评估决策" Background="#37383B" Foreground="#E8EAED" BorderThickness="0" Padding="10,6" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,0,8" Click="OnEvaluateIdeaClicked" />
                                <Border Background="#28292C" BorderBrush="#3C4043" BorderThickness="1" CornerRadius="8" Padding="8">
                                    <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="IdeaEvaluationResultText" Text="（等待你的想法输入...）" FontSize="11" Foreground="#9AA0A6" TextWrapping="Wrap" />
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ================= DRAWER 2: 时间损益表 (P&L) 与财报复盘 (💰) ================= -->
                    <Grid x:Name="DrawerExpensePanel" Visibility="Collapsed" Margin="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,0,20">
                                <!-- Top Tab Switcher: P&L vs 记账 -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="PnlTabBtn" Content="📊 时间损益表 (P&amp;L)" Style="{StaticResource GoogleTopBtnStyle}" Background="#1A73E8" Foreground="#FFFFFF" Padding="8,6" FontSize="12" FontWeight="SemiBold" Click="OnSwitchToPnlTabClicked" />
                                    <Button Grid.Column="1" x:Name="ExpenseTabBtn" Content="🪙 财务记账流水" Style="{StaticResource GoogleTopBtnStyle}" Foreground="#9AA0A6" Padding="8,6" FontSize="12" FontWeight="Normal" Click="OnSwitchToExpenseTabClicked" />
                                </Grid>

                                <!-- View 1: 时间损益平衡表 (Time P&L) -->
                                <StackPanel x:Name="TimePnlContainer" Visibility="Visible">
                                    <TextBlock Text="本周工时损益核算 (Time P&amp;L)" FontSize="15" FontWeight="Bold" Foreground="#E8EAED" Margin="0,0,0,10" />

                                    <!-- 4 Key Financial Metrics Cards -->
                                    <UniformGrid Columns="2" Margin="0,0,0,12">
                                        <!-- 1. 营业有效工时 -->
                                        <Border Background="#132E27" BorderBrush="#059669" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,4,8">
                                            <StackPanel>
                                                <TextBlock Text="💎 营业有效工时" FontSize="11" Foreground="#6EE7B7" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <TextBlock x:Name="PnlEffectiveHoursText" Text="0.0 h" FontSize="18" FontWeight="Bold" Foreground="#34D399" />
                                                <TextBlock Text="深度高价值产出" FontSize="10" Foreground="#A7F3D0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 2. 管理损耗/坏账工时 -->
                                        <Border Background="#3B0713" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="8" Padding="10" Margin="4,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="📉 坏账/打断损耗" FontSize="11" Foreground="#FCA5A5" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <TextBlock x:Name="PnlBadDebtHoursText" Text="0.0 h" FontSize="18" FontWeight="Bold" Foreground="#F87171" />
                                                <TextBlock Text="打断/拖延作废工时" FontSize="10" Foreground="#FECACA" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 3. 预算赤字 (Deficit) -->
                                        <Border Background="#351C0C" BorderBrush="#F97316" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,4,0">
                                            <StackPanel>
                                                <TextBlock Text="🔻 预算赤字 (Deficit)" FontSize="11" Foreground="#FDBA74" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <TextBlock x:Name="PnlDeficitHoursText" Text="0.0 h" FontSize="18" FontWeight="Bold" Foreground="#FB923C" />
                                                <TextBlock Text="实际超预估差额" FontSize="10" Foreground="#FED7AA" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 4. 工时有效利用率 (Margin) -->
                                        <Border Background="#1E1B4B" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="8" Padding="10" Margin="4,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="📊 工时利用率" FontSize="11" Foreground="#C7D2FE" FontWeight="SemiBold" Margin="0,0,0,2" />
                                                <TextBlock x:Name="PnlMarginText" Text="100%" FontSize="18" FontWeight="Bold" Foreground="#818CF8" />
                                                <TextBlock Text="(有效-坏账)/总工时" FontSize="10" Foreground="#E0E7FF" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <!-- Attribution Panel: 偏差归因 -->
                                    <Border Background="#28292C" BorderBrush="#3C4043" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="🔍 执行偏差与损耗归因" FontSize="12" FontWeight="SemiBold" Foreground="#E8EAED" Margin="0,0,0,6" />
                                            <StackPanel x:Name="PnlAttributionPanel" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Financial-Grade Weekly Review Actions -->
                                    <TextBlock Text="财报级周复盘导出：" FontSize="12" FontWeight="SemiBold" Foreground="#E8EAED" Margin="0,0,0,6" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="📋 导出 Markdown" Style="{StaticResource GoogleActionBtnStyle}" Padding="10,8" FontSize="12" FontWeight="SemiBold" Margin="0,0,4,0" Click="OnExportMarkdownReportClicked" ToolTip="生成结构化复盘对账报告并复制到剪贴板" />
                                        <Button Grid.Column="1" Content="💾 导出 JSON" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="10,8" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,0" Click="OnExportJsonReportClicked" ToolTip="导出结构化财报 JSON 数据" />
                                    </Grid>
                                    <TextBlock x:Name="ExportReportStatusText" Text="" FontSize="11" Foreground="#10B981" Margin="0,0,0,10" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- View 2: 财务记账流水 (保留原有自然语言流水) -->
                                <StackPanel x:Name="ExpenseRecordContainer" Visibility="Collapsed">
                                    <TextBlock Text="自然语言快速记账（如「午餐35元」）：" FontSize="12" Foreground="#9AA0A6" Margin="0,0,0,8" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="QuickExpenseInput" Background="#28292C" Foreground="#E8EAED" BorderBrush="#3C4043" BorderThickness="1" Padding="10,8" FontSize="13" Margin="0,0,8,0" />
                                        <Button Grid.Column="1" Content="入库" Background="#1A73E8" Foreground="#FFFFFF" BorderThickness="0" Padding="14,8" FontWeight="SemiBold" Cursor="Hand" Click="OnQuickExpenseClicked" />
                                    </Grid>
                                    <TextBlock x:Name="ExpenseResultText" Text="" Foreground="#10B981" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap" />

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="今日流水明细" FontSize="13" FontWeight="Bold" Foreground="#E8EAED" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" x:Name="FinanceSummaryText" Text="合计: ¥ 0.00" HorizontalAlignment="Right" FontSize="13" FontWeight="Bold" Foreground="#F43F5E" VerticalAlignment="Center" />
                                    </Grid>
                                    <StackPanel x:Name="ExpenseHistoryPanel" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- DrawerSettingsPanel moved to root-level SettingsModal -->
                </Grid>
            </Border>

            <!-- ================= FAR-RIGHT GOOGLE WORKSPACE RAIL (REMOVED) ================= -->
            <Border Grid.Column="3" Background="#202124" BorderBrush="#3C4043" BorderThickness="1,0,0,0" Padding="0,12,0,0" Visibility="Collapsed" />
        </Grid>

        <!-- ================= UPCOMING EVENT TOAST BANNER (GOOGLE CALENDAR REMINDER) ================= -->
