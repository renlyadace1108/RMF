        <!-- ================= MODAL: EVENT QUICK DETAIL CARD (GOOGLE CALENDAR STYLE) ================= -->
        <Grid x:Name="EventQuickDetailModal" Visibility="Collapsed" Background="#66000000" Grid.RowSpan="2" Panel.ZIndex="998">
            <Border Background="#28292C" BorderBrush="#5F6368" BorderThickness="1" CornerRadius="12" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <!-- Top Action Header: Color bar / Work type indicator + Actions (Edit, Status, Delete, Close) -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Rectangle x:Name="QuickDetailColorStripe" Width="14" Height="14" RadiusX="3" RadiusY="3" Fill="#1A73E8" Margin="0,0,8,0" />
                            <Border x:Name="QuickDetailWorkTypeBadge" Background="#1E1B4B" CornerRadius="4" Padding="6,2">
                                <TextBlock x:Name="QuickDetailWorkTypeText" Text="🧠 深度工作" FontSize="11" Foreground="#C084FC" FontWeight="SemiBold" />
                            </Border>
                            <Border x:Name="QuickDetailSourceBadge" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="6,0,0,0">
                                <TextBlock x:Name="QuickDetailSourceText" Text="💻 桌面端" FontSize="10" Foreground="#38BDF8" FontWeight="SemiBold" />
                            </Border>
                            <Border x:Name="QuickDetailRecurrenceBadge" Background="#374151" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="QuickDetailRecurrenceText" Text="🔁 每天重复" FontSize="10" Foreground="#E5E7EB" />
                            </Border>
                        </StackPanel>

                        <!-- Action icons on the right -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="QuickDetailDuplicateBtn" Content="📋" Style="{StaticResource GoogleTopBtnStyle}" Width="32" Height="32" FontSize="13" ToolTip="复制日程 (Duplicate)" Click="OnQuickDetailDuplicateClicked" Margin="0,0,4,0" />
                            <Button x:Name="QuickDetailCompleteBtn" Content="✓" Style="{StaticResource GoogleTopBtnStyle}" Width="32" Height="32" FontSize="14" ToolTip="标记为已完成 / 未完成" Click="OnQuickDetailToggleStatusClicked" Margin="0,0,4,0" />
                            <Button x:Name="QuickDetailEditBtn" Content="✏️" Style="{StaticResource GoogleTopBtnStyle}" Width="32" Height="32" FontSize="13" ToolTip="编辑日程详情" Click="OnQuickDetailEditClicked" Margin="0,0,4,0" />
                            <Button x:Name="QuickDetailDeleteBtn" Content="🗑️" Style="{StaticResource GoogleTopBtnStyle}" Width="32" Height="32" FontSize="13" Foreground="#F87171" ToolTip="删除日程" Click="OnQuickDetailDeleteClicked" Margin="0,0,6,0" />
                            <Button Content="✕" Style="{StaticResource GoogleTopBtnStyle}" Width="32" Height="32" FontSize="14" ToolTip="关闭 (Esc)" Click="OnCloseQuickDetailClicked" />
                        </StackPanel>
                    </Grid>

                    <!-- Event Title -->
                    <TextBlock x:Name="QuickDetailTitleText" Text="日程标题" FontSize="18" FontWeight="Bold" Foreground="#E8EAED" TextWrapping="Wrap" Margin="0,0,0,8" />

                    <!-- Time & Date -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="🕒" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="QuickDetailTimeText" Text="2026年10月2日 · 09:00 - 10:30" FontSize="13" Foreground="#9AA0A6" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Linked Goal (if any) -->
                    <StackPanel x:Name="QuickDetailGoalRow" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed">
                        <TextBlock Text="🎯" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="QuickDetailGoalText" Text="关联目标: 核心战役 Q4" FontSize="12" Foreground="#60A5FA" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Definition of Done (DoD) -->
                    <Border x:Name="QuickDetailDodBorder" Background="#1E1B4B" BorderBrush="#6D28D9" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12" Visibility="Collapsed">
