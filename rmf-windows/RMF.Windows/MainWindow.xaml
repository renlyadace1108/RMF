                                        <Border Grid.Column="8" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,14">
                                            <StackPanel>
                                                <TextBlock Text="5. 复盘总结" FontSize="12.5" FontWeight="Bold" Foreground="#F59E0B" Margin="0,0,0,4" />
                                                <TextBlock Text="查看 24 小时作息与工时投入统计。" FontSize="11" Foreground="{DynamicResource TextSecondary}" LineHeight="16" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Section 2: 模块详解卡片列表 -->
                            <TextBlock Text="功能详细使用说明" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,12" />

                            <!-- Card M1: 日程 -->
                            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20,18" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📅 日程模块 (Calendar)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                            <Border Background="{DynamicResource ControlBackground}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="核心工作台" FontSize="10.5" Foreground="{DynamicResource AccentBlue}" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="前往日程" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="14,6" FontSize="11.5" FontWeight="SemiBold" Click="OnTutorialJumpCalendarClicked" />
                                    </Grid>

                                    <TextBlock Text="• 视图切换与浏览：顶部支持「日 (D)」、「周 (W)」、「月 (M)」、「年 (Y)」四种视图自由切换。周视图为默认时间块排期视图，完整展现 0:00 至 24:00 时间网格。" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3" TextWrapping="Wrap" />
                                    <TextBlock Text="• 创建与编辑日程：在日/周视图的时间格中直接单击或拖选即可快速创建日程；双击已有日程卡片可打开编辑弹窗，修改标题、起止时间、分类标签、地点与备注；右键日程卡片支持快速标记完成、删除或转入专注计时。" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3" TextWrapping="Wrap" />
                                    <TextBlock Text="• 时间块拖拽调整：支持直接按住日程卡片拖拽移动来调整开始时间，按住卡片底部边缘拖拽可直观调整持续时长。" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3" TextWrapping="Wrap" />
                                    <TextBlock Text="• 事项分类与认知负荷：日程支持标记「深度工作」、「浅层事务」与「缓冲休息」。周视图右上角会实时统计深度工作配额与投入时长，辅助合理规划精力。" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3" TextWrapping="Wrap" />
                                    <TextBlock Text="• 日期导航：点击顶部「今天 (T)」快速回到当天，使用左右翻页按钮（或快捷键 J/K）前后翻页，点击日期标题可快速弹出迷你日历跳转。" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Card M2: 待办与目标 -->
                            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20,18" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🎯 待办与目标 (Backlog &amp; Goals)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                            <Border Background="{DynamicResource ControlBackground}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="任务敏捷池" FontSize="10.5" Foreground="#38BDF8" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="查看待办" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="14,6" FontSize="11.5" FontWeight="SemiBold" Click="OnTutorialJumpCalendarClicked" />
                                    </Grid>

                                    <TextBlock Text="• 待办清单收集：点击日历左侧抽屉切换到「待办」选项卡，随时收集未经排期的碎片任务与灵感闪念。输入内容后按 Enter 即可快速入池。" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3" TextWrapping="Wrap" />
                                    <TextBlock Text="• 拖拽排期：直接从左侧待办抽屉按住任务，拖入主网格指定的日期和时间槽，即可一键转为排期日程。" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3" TextWrapping="Wrap" />
                                    <TextBlock Text="• 目标管理体系：切换到「目标」抽屉，支持创建层级目标（年/季/月目标）。日程可在编辑时关联所属目标，任务打卡完成后会自动推进目标的整体达成率。" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3" TextWrapping="Wrap" />
                                    <TextBlock Text="• 交付标准 (DoD)：在日程编辑框中可为任务编写 Definition of Done 验收清单，完成一项勾选一项，告别模棱两可的任务交付。" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Card M3: 专注 -->
                            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20,18" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⏱️ 专注模块与悬浮胶囊 (Focus &amp; Mini HUD)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                            <Border Background="{DynamicResource ControlBackground}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="沉浸计时" FontSize="10.5" Foreground="#F59E0B" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="前往专注" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="14,6" FontSize="11.5" FontWeight="SemiBold" Click="OnTutorialJumpFocusClicked" />
                                    </Grid>

                                    <TextBlock Text="• 专注模式设置：在专注页面可配置「倒计时」或「正向计时」，自定义单轮专注时长（如 25 分钟或 50 分钟深度块）与休息时长。" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3" TextWrapping="Wrap" />
                                    <TextBlock Text="• 关联日程任务：开启专注前可从下拉列表中挑选当前正在执行的日程任务，专注结束打卡时会自动将有效专注工时累加沉淀至该任务。" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3" TextWrapping="Wrap" />
                                    <TextBlock Text="• 桌面置顶胶囊 (Ctrl+Shift+F)：随时按下快捷键呼出半透明迷你悬浮胶囊，不遮挡正在运行的代码编辑器或文档窗口。胶囊支持单击暂停/继续、右键菜单快速结束打卡或直接拖拽移动位置。" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3" TextWrapping="Wrap" />
                                    <TextBlock Text="• 自动化挂起与打断记录：支持无操作闲置自动暂停检测。如果中途被迫切换事务，可记录打断原因，帮助复盘分析分心源头。" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Card M4: 统计 -->
                            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20,18" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📊 统计模块 (Analytics &amp; Review)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                            <Border Background="{DynamicResource ControlBackground}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="作息与效能" FontSize="10.5" Foreground="#818CF8" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="前往统计" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="14,6" FontSize="11.5" FontWeight="SemiBold" Click="OnTutorialJumpSummaryClicked" />
                                    </Grid>

                                    <TextBlock Text="• 24小时真实作息：清晰还原全天 24 个时段的具体事项分布与专注时间投入，一眼看清时间流向。" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3" TextWrapping="Wrap" />
                                    <TextBlock Text="• 深度工作比率：统计今日与近期的深度工作占比，监控脑力与认知资源的健康分配。" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3" TextWrapping="Wrap" />
                                    <TextBlock Text="• 完成走势与分类占比：可视化呈现周/月任务完成数量趋势与各类事务工时占比环形图。" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3" TextWrapping="Wrap" />
                                    <TextBlock Text="• 时段热力分布：通过时段热力图找出个人每日最高效的黄金时间段（高能期），为次日排期提供数据参考。" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3" TextWrapping="Wrap" />
                                    <TextBlock Text="• 数据导出：支持一键将复盘数据生成高清海报图片或纯文本导出，便于个人知识库存档与分享。" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Card M5: 学习 -->
                            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20,18" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📚 学习模块 (Study &amp; Spaced Repetition)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                            <Border Background="{DynamicResource ControlBackground}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="知识主题档案" FontSize="10.5" Foreground="#A78BFA" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="前往学习" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="14,6" FontSize="11.5" FontWeight="SemiBold" Click="OnTutorialJumpStudyClicked" />
                                    </Grid>

                                    <TextBlock Text="• 建立学习主题：点击「➕ 新建主题」，为考研、考证、语言学习、专业课程或读书攻坚建立专属档案，设定目标总学时。" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3" TextWrapping="Wrap" />
                                    <TextBlock Text="• 学时打卡：进入主题详情后，支持点击「+1h」、「+2h」或自定义学时输入快速打卡，实时推进主题完成度进度条并记入打卡日志。" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3" TextWrapping="Wrap" />
                                    <TextBlock Text="• 艾宾浩斯复习曲线：每次打卡后系统会自动生成科学记忆复习节点（第1天、第2天、第4天、第7天、第15天），并在主界面适时提示复习，形成长期记忆闭环。" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3" TextWrapping="Wrap" />
                                    <TextBlock Text="• 主题结业与归档：当累计学时达到目标学时即可标记结业，归入已结业档案库，沉淀学习成果。" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Card M6: 课程表 -->
                            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20,18" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🎓 课程表模块 (Timetable)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                            <Border Background="{DynamicResource ControlBackground}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="高校智能排课" FontSize="10.5" Foreground="#34D399" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="前往课程表" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="14,6" FontSize="11.5" FontWeight="SemiBold" Click="OnTutorialJumpTimetableClicked" />
                                    </Grid>

                                    <TextBlock Text="• 学期与作息设置：点击右上角设置，可配置学期总周数、开学第一周周一日期，并可自定义每天各节次（第1节至第12节等）的具体上下课起止时间。" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3" TextWrapping="Wrap" />
                                    <TextBlock Text="• 添加课程：点击课表空白单元格添加课程，输入课程名称、教室地点、授课教师，并设置周数跨度（如 1-16 周）与单双周规则。" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3" TextWrapping="Wrap" />
                                    <TextBlock Text="• 智能调停补课：支持配置法定节假日放假调课、教师出差停课与周末补课规则。配置后无需手动修改整学期课表，系统自动在对应日期的日历排期中生效并标注。" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3" TextWrapping="Wrap" />
                                    <TextBlock Text="• 日程与课表联动：课程会同步映射到主日历周视图中，自习与日程安排可直接根据空堂时间灵活插空排布。" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Card M7: 日报 -->
                            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20,18" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🏆 日报模块 (Daily Report)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                            <Border Background="{DynamicResource ControlBackground}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="每日总结汇报" FontSize="10.5" Foreground="#F59E0B" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="前往日报" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="14,6" FontSize="11.5" FontWeight="SemiBold" Click="OnTutorialJumpDailyReportClicked" />
                                    </Grid>

                                    <TextBlock Text="• 智能自动生成：点击顶部「✨ 智能生成」，系统会自动汇总今日已完成日程清单、今日累计专注工时、各分类投入占比，并自动填充结构化汇报初稿。" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3" TextWrapping="Wrap" />
                                    <TextBlock Text="• 模块化编辑：分为「今日完成」、「明日计划」、「工时与指标」、「复盘心得」四个分区，支持手动补充细节与思考感悟。" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3" TextWrapping="Wrap" />
                                    <TextBlock Text="• 预览与复制：点击「👁️ 预览」查看 Markdown 渲染后的整洁排版；点击「📋 复制」可直接拷贝带格式的汇报文本至剪贴板，一键粘贴到飞书、企业微信、钉钉或工作邮件中。" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3" TextWrapping="Wrap" />
                                    <TextBlock Text="• 历史存档：点击「💾 保存」永久归档，日历日期切换时可随时回看往日报告。" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Card M8: 设置与数据备份 -->
                            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20,18" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="⚙️ 设置与数据安全 (Settings &amp; Backup)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                            <Border Background="{DynamicResource ControlBackground}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="个性化与备份" FontSize="10.5" Foreground="#94A3B8" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="前往设置" Style="{StaticResource GoogleOutlineBtnStyle}" Padding="14,6" FontSize="11.5" FontWeight="SemiBold" Click="OnTutorialJumpSettingsClicked" />
                                    </Grid>

                                    <TextBlock Text="• 外观与主题：支持浅色/深色主题切换，可自由调整主色调（薄荷绿、星空蓝、紫罗兰等），适配个性化视觉喜好。" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3" TextWrapping="Wrap" />
                                    <TextBlock Text="• 云同步与多设备：支持 WebDAV 或专用云同步端点，在多台电脑间同步日程、待办与学习进度。" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3" TextWrapping="Wrap" />
                                    <TextBlock Text="• 本地完整备份与导出：支持一键导出包含全部日程、专注记录、课程与学习档案的 JSON 备份包，可随时导入还原，数据完全掌握在自己手中。" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,3" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Card M6: 快捷键速查表 -->
                            <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20,18" Margin="0,0,0,24">
                                <StackPanel>
                                    <TextBlock Text="⌨️ 快捷键速查" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12" />
                                    <UniformGrid Columns="2">
                                        <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,6,6">
                                            <DockPanel LastChildFill="True">
                                                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="Ctrl + Shift + Space" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlue}" />
                                                </Border>
                                                <TextBlock Text="闪念捕获 (全局呼出速记)" FontSize="11.5" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>

                                        <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="6,0,0,6">
                                            <DockPanel LastChildFill="True">
                                                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="Ctrl + Shift + F" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBlue}" />
                                                </Border>
                                                <TextBlock Text="唤起专注悬浮胶囊" FontSize="11.5" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>

                                        <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,6,6">
                                            <DockPanel LastChildFill="True">
                                                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" DockPanel.Dock="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="T" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                                </Border>
                                                <TextBlock Text="跳转到今天" FontSize="11.5" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>

                                        <Border Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="6,0,0,6">
