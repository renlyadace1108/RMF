<Window x:Class="RMF.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:RMF.Windows"
        mc:Ignorable="d"
        Title="RMF (Renly Manage Platform) - 个人多端中枢" 
        Height="780" Width="1200"
        MinHeight="600" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#18181B"
        Foreground="#F4F4F5">

    <Window.Resources>
        <!-- Custom Color Palette -->
        <SolidColorBrush x:Key="SidebarBackground" Color="#121215" />
        <SolidColorBrush x:Key="CardBackground" Color="#202024" />
        <SolidColorBrush x:Key="CardHoverBackground" Color="#27272C" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#323238" />
        <SolidColorBrush x:Key="TextPrimary" Color="#FAFAFA" />
        <SolidColorBrush x:Key="TextSecondary" Color="#A1A1AA" />
        <SolidColorBrush x:Key="TextMuted" Color="#71717A" />
        <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6" />
        <SolidColorBrush x:Key="AccentPurple" Color="#8B5CF6" />
        <SolidColorBrush x:Key="AccentGreen" Color="#10B981" />
        <SolidColorBrush x:Key="AccentRed" Color="#EF4444" />

        <!-- Navigation Button Style -->
        <Style x:Key="NavTabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#A1A1AA" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="Border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#27272A" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active Nav Style -->
        <Style x:Key="ActiveNavTabButtonStyle" TargetType="Button" BasedOn="{StaticResource NavTabButtonStyle}">
            <Setter Property="Background" Value="#27272A" />
            <Setter Property="Foreground" Value="#38BDF8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT SIDEBAR ================= -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackground}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,1,0" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="4,8,4,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="8" Background="#2563EB" Margin="0,0,10,0">
                            <TextBlock Text="R" FontWeight="Bold" FontSize="18" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel>
                            <TextBlock Text="RMF Hub" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                            <TextBlock Text="Renly Manage Platform" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Nav Menu -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="核心模块" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" Margin="8,0,0,8" />
                    
                    <Button Name="NavScheduleBtn" Style="{StaticResource ActiveNavTabButtonStyle}" Margin="0,0,0,4" Click="OnNavScheduleClicked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📅" FontSize="15" Margin="0,0,10,0" />
                            <TextBlock Text="日程与时间表" />
                        </StackPanel>
                    </Button>

                    <Button Name="NavFocusBtn" Style="{StaticResource NavTabButtonStyle}" Margin="0,0,0,4" Click="OnNavFocusClicked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏱️" FontSize="15" Margin="0,0,10,0" />
                            <TextBlock Text="专注与AI监管" />
                        </StackPanel>
                    </Button>

                    <Button Name="NavFinanceBtn" Style="{StaticResource NavTabButtonStyle}" Margin="0,0,0,4" Click="OnNavFinanceClicked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💰" FontSize="15" Margin="0,0,10,0" />
                            <TextBlock Text="收入与支出" />
                        </StackPanel>
                    </Button>

                    <Button Name="NavSyncBtn" Style="{StaticResource NavTabButtonStyle}" Margin="0,0,0,4" Click="OnNavSyncClicked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="☁️" FontSize="15" Margin="0,0,10,0" />
                            <TextBlock Text="Google 同步中枢" />
                        </StackPanel>
                    </Button>

                    <Button Name="NavSettingsBtn" Style="{StaticResource NavTabButtonStyle}" Margin="0,0,0,4" Click="OnNavSettingsClicked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙️" FontSize="15" Margin="0,0,10,0" />
                            <TextBlock Text="Gemini API 设置" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Bottom System Telemetry Card -->
                <Border Grid.Row="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                            <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,6,0" />
                            <TextBlock Text="原生极轻引擎" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                        </StackPanel>
                        
                        <TextBlock Name="MemoryUsageText" Text="内存: 24.5 MB" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,2" />
                        <TextBlock Name="CpuUsageText" Text="CPU: 0.0% (零后台轮询)" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,8" />
                        
                        <Button Content="⚡ 瞬间压制内存" Background="#27272A" Foreground="#FAFAFA" BorderThickness="1" BorderBrush="#3F3F46" Padding="8,5" FontSize="12" HorizontalAlignment="Stretch" Cursor="Hand" Click="OnTrimMemoryClicked" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= MAIN DASHBOARD BODY ================= -->
        <Grid Grid.Column="1" Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Dashboard Top Action & Header Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="今日工作台" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                    <TextBlock Text="2026年10月2日 · 联想小新Pad与ColorOS多端就绪" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Top Quick Action Buttons & Model Badge -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,12,0" Cursor="Hand" MouseLeftButtonUp="OnModelBadgeClicked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#38BDF8" Margin="0,0,6,0" />
                            <TextBlock Name="ActiveModelBadge" Text="⚡ 模型: gemini-2.5-flash" FontSize="12" Foreground="#38BDF8" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Button Content="+ 快捷记账" Background="#27272A" Foreground="#FAFAFA" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="14,8" Margin="0,0,10,0" FontSize="13" Cursor="Hand" Click="OnQuickExpenseHeaderClicked" />
                    <Button Content="+ 新建日程" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" Padding="16,8" FontWeight="SemiBold" FontSize="13" Cursor="Hand" />
                </StackPanel>
            </Grid>

            <!-- Main Content Area -->
            <Grid Grid.Row="1">
                <!-- 1. SCHEDULE & TIMETABLE VIEW -->
                <Grid Name="ScheduleView" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top 3 Metrics Dashboard Cards -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Metric 1: Tasks -->
                        <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="今日计划进度" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,8" VerticalAlignment="Center">
                                    <TextBlock Text="1" FontSize="26" FontWeight="Bold" Foreground="#38BDF8" />
                                    <TextBlock Text=" / 3 个时间块" FontSize="14" Foreground="{StaticResource TextMuted}" VerticalAlignment="Bottom" Margin="4,0,0,4" />
                                </StackPanel>
                                <ProgressBar Value="33" Maximum="100" Height="4" Foreground="#38BDF8" Background="#27272A" BorderThickness="0" />
                            </StackPanel>
                        </Border>

                        <!-- Metric 2: AI Focus -->
                        <Border Grid.Column="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Gemini 专注评分" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,8" VerticalAlignment="Center">
                                    <TextBlock Text="94" FontSize="26" FontWeight="Bold" Foreground="#10B981" />
                                    <TextBlock Text="分 · 状态良好" FontSize="13" Foreground="#10B981" VerticalAlignment="Bottom" Margin="6,0,0,5" />
                                </StackPanel>
                                <TextBlock Text="当前匹配: 核心研发时间块" FontSize="11" Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                        </Border>

                        <!-- Metric 3: Expense -->
                        <Border Grid.Column="4" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="今日支出统计" FontSize="12" Foreground="{StaticResource TextSecondary}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,8" VerticalAlignment="Center">
                                    <TextBlock Text="¥ 35.50" FontSize="26" FontWeight="Bold" Foreground="#F43F5E" />
                                </StackPanel>
                                <TextBlock Text="午餐 · 支付宝已同步" FontSize="11" Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Bottom Split: Left Timetable Flow, Right AI Inspector -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="4*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Rich Schedule Timetable -->
                        <Border Grid.Column="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="今日日程编排 (Timeline)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16" />

                                    <!-- Item 1 (Active) -->
                                    <Border Background="#25252B" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Time column -->
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="09:30" FontWeight="Bold" FontSize="15" Foreground="#38BDF8" />
                                                <TextBlock Text="11:30" FontSize="12" Foreground="{StaticResource TextMuted}" />
                                            </StackPanel>

                                            <!-- Content -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="核心研发" FontSize="11" Foreground="#38BDF8" FontWeight="SemiBold" />
                                                    </Border>
                                                    <TextBlock Text="RMF Windows 客户端架构" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimary}" />
                                                </StackPanel>
                                                <TextBlock Text="轻量化 Fluent 2 视觉重塑与 Win32 前台采集" FontSize="13" Foreground="{StaticResource TextSecondary}" />
                                            </StackPanel>

                                            <!-- Status Badge -->
                                            <Border Grid.Column="2" Background="#1E3A8A" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                                                <TextBlock Text="● 进行中" FontSize="12" FontWeight="SemiBold" Foreground="#93C5FD" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Item 2 -->
                                    <Border Background="#1D1D21" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="14:00" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextSecondary}" />
                                                <TextBlock Text="15:30" FontSize="12" Foreground="{StaticResource TextMuted}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <Border Background="#3B0764" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="AI 监管" FontSize="11" Foreground="#C084FC" FontWeight="SemiBold" />
                                                    </Border>
                                                    <TextBlock Text="Gemini 监督中枢对接" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimary}" />
                                                </StackPanel>
                                                <TextBlock Text="日常行为偏差分析与晚间复盘报告生成" FontSize="13" Foreground="{StaticResource TextSecondary}" />
                                            </StackPanel>

                                            <Border Grid.Column="2" Background="#27272A" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                                                <TextBlock Text="待执行" FontSize="12" Foreground="{StaticResource TextMuted}" />
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- Item 3 -->
                                    <Border Background="#1D1D21" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="16:00" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextSecondary}" />
                                                <TextBlock Text="17:00" FontSize="12" Foreground="{StaticResource TextMuted}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <Border Background="#064E3B" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                        <TextBlock Text="多端协同" FontSize="11" Foreground="#34D399" FontWeight="SemiBold" />
                                                    </Border>
                                                    <TextBlock Text="Google Drive AppData 增量同步" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimary}" />
                                                </StackPanel>
                                                <TextBlock Text="小新 Pad 12.7 寸大屏与手机端双向增量验证" FontSize="13" Foreground="{StaticResource TextSecondary}" />
                                            </StackPanel>

                                            <Border Grid.Column="2" Background="#27272A" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
                                                <TextBlock Text="待执行" FontSize="12" Foreground="{StaticResource TextMuted}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Right: AI Supervision & Live Window Radar -->
                        <Border Grid.Column="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="🤖 Gemini 行为监管守护" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12" />

                                <!-- Current Active Window -->
                                <Border Grid.Row="1" Background="#18181B" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                            <Ellipse Width="6" Height="6" Fill="#38BDF8" Margin="0,0,6,0" />
                                            <TextBlock Text="前台活动嗅探 (AI 输入流)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" />
                                        </StackPanel>
                                        <TextBlock Name="ActiveWindowText" Text="捕获中..." FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Audit Trigger Button -->
                                <Button Grid.Row="2" Name="AuditScheduleBtn" Content="✨ 唤醒 Gemini 审查今日排期" Background="#7C3AED" Foreground="#FFFFFF" BorderThickness="0" Padding="12,8" FontWeight="SemiBold" FontSize="13" Cursor="Hand" Margin="0,0,0,10" HorizontalAlignment="Stretch" Click="OnAuditScheduleClicked" />

                                <!-- Real Gemini Feedback Card -->
                                <Border Grid.Row="3" Background="#231A38" BorderBrush="#5B21B6" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="📋 Gemini 审查与复盘反馈" FontWeight="Bold" FontSize="12" Foreground="#DDD6FE" Margin="0,0,0,6" />
                                            <TextBlock Name="AuditResultText" Text="点击上方按钮，Gemini 将根据你今日的所有日程排期与桌面活动，审查时间块密度、精力分配与潜在拖延风险。" FontSize="12" LineHeight="18" Foreground="#C4B5FD" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 2. FOCUS & AI SUPERVISION VIEW -->
                <Grid Name="FocusView" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="⏱️ 专注管理与 Gemini 监督思考中枢" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6" />
                            <TextBlock Text="充当你的 AI 思考合伙人与行为监督官：评估你的新灵感、检验执行可行性、防分心拉回、智能任务排程。" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,0,0,20" />

                            <!-- Module A: Evaluate Idea & Thought -->
                            <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                        <TextBlock Text="💡" FontSize="18" Margin="0,0,8,0" />
                                        <TextBlock Text="监督评估我的想法与决策 (Idea &amp; Plan Auditor)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                    </StackPanel>
                                    <TextBlock Text="遇到突发的灵感、技术构想或生活安排？让 Gemini 从「主线专注度、可行性、沉没成本与第一步行动」帮你泼冷水或给出深度洞察：" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12" />

                                    <TextBox Name="UserIdeaInput" Background="#18181B" Foreground="#FAFAFA" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="12" FontSize="13" AcceptsReturn="True" TextWrapping="Wrap" Height="80" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" />

                                    <Button Name="EvaluateIdeaBtn" Content="🚀 让 Gemini 深入评估这个想法" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" Padding="16,10" FontWeight="SemiBold" FontSize="13" Cursor="Hand" HorizontalAlignment="Left" Margin="0,0,0,12" Click="OnEvaluateIdeaClicked" />

                                    <Border Background="#18181B" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                            <TextBlock Name="IdeaEvaluationResultText" Text="（等待你的想法输入...）" FontSize="13" LineHeight="20" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Module B: Smart Auto-Scheduler -->
                            <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                        <TextBlock Text="✨" FontSize="18" Margin="0,0,8,0" />
                                        <TextBlock Text="AI 智能排程帮手 (Smart Planner)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                    </StackPanel>
                                    <TextBlock Text="输入你想达成的目标，Gemini 结合你现有的空白时间自动拆解为合理专注时间块：" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,12" />

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Name="GoalPlanInput" Background="#18181B" Foreground="#FAFAFA" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="12,10" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <Button Grid.Column="1" Name="PlanScheduleBtn" Content="生成推荐排程" Background="#7C3AED" Foreground="#FFFFFF" BorderThickness="0" Padding="16,10" FontWeight="SemiBold" Cursor="Hand" Click="OnPlanScheduleClicked" />
                                    </Grid>

                                    <Border Background="#18181B" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                                        <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                            <TextBlock Name="GoalPlanResultText" Text="（等待排程目标输入...）" FontSize="13" LineHeight="20" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 3. FINANCE VIEW -->
                <Grid Name="FinanceView" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="💰 智能自然语言收支记账" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />
                        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="自然语言输入记账（支持语音或文本，Gemini 自动结构化抽取）：" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,10" />
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Name="QuickExpenseInput" Background="#18181B" Foreground="#FAFAFA" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="12,10" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Button Grid.Column="1" Content="Gemini 解析并入库" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" Padding="16,10" FontWeight="SemiBold" Cursor="Hand" Click="OnQuickExpenseClicked" />
                                </Grid>
                                <TextBlock Name="ExpenseResultText" Text="" Foreground="#10B981" FontSize="13" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 4. SYNC VIEW -->
                <Grid Name="SyncView" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="☁️ Google Drive AppData 增量同步" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />
                        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                            <StackPanel>
                                <TextBlock Text="状态：已连接至云端隐藏空间 `drive.appdata`" Foreground="{StaticResource TextSecondary}" FontSize="14" />
                                <TextBlock Name="SyncStatusText" Text="本地优先 SQLite 状态健康，无冲突。" FontSize="13" Foreground="{StaticResource TextMuted}" Margin="0,8,0,16" />
                                <Button Content="手动立即同步" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" Padding="16,8" FontWeight="SemiBold" HorizontalAlignment="Left" Cursor="Hand" Click="OnSyncNowClicked" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 5. SETTINGS VIEW -->
                <Grid Name="SettingsView" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24" MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,0,20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                    <TextBlock Text="⚙️" FontSize="20" Margin="0,0,8,0" />
                                    <TextBlock Text="Gemini 接入模型与监督模式控制中心" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                                </StackPanel>
                                <TextBlock Text="灵活切换接入的 Google AI 模型，微调监督官性格严厉度，并可配置网络反向代理，数据全部本地保存。" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,22" TextWrapping="Wrap" />

                                <!-- SECTION 1: MODEL SELECTION -->
                                <Border Background="#18181B" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="🧠 1. 接入模型版本选择 (Model Selection)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6" />
                                        <TextBlock Text="不同场景可随时在 App 内无缝切换不同的模型：" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,12" />

                                        <ComboBox Name="ModelSelectCombo" SelectedIndex="0" Background="#27272A" Foreground="#FFFFFF" Padding="12,8" FontSize="13" Margin="0,0,0,12" SelectionChanged="OnModelSelectionChanged">
                                            <ComboBoxItem Content="gemini-2.5-flash (推荐 · 最新首选 · 秒级响应 · 免费额度高)" Tag="gemini-2.5-flash" />
                                            <ComboBoxItem Content="gemini-2.5-pro (最强推理 · 复杂任务拆解与深度批判)" Tag="gemini-2.5-pro" />
                                            <ComboBoxItem Content="gemini-2.0-flash (最新多模态极速模型)" Tag="gemini-2.0-flash" />
                                            <ComboBoxItem Content="gemini-1.5-pro (经典长上下文深思模型)" Tag="gemini-1.5-pro" />
                                            <ComboBoxItem Content="gemini-1.5-flash (轻量快速版本)" Tag="gemini-1.5-flash" />
                                            <ComboBoxItem Content="[自定义输入模型名称...] (手动指定专属微调或实验版本)" Tag="custom" />
                                        </ComboBox>

                                        <!-- Custom Model Name Input (shown if Custom selected) -->
                                        <StackPanel Name="CustomModelPanel" Visibility="Collapsed" Margin="0,0,0,6">
                                            <TextBlock Text="输入自定义模型 Identifier（例如 models/gemini-experimental）：" FontSize="12" Foreground="#38BDF8" Margin="0,0,0,4" />
                                            <TextBox Name="CustomModelInput" Background="#27272A" Foreground="#FAFAFA" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="10,8" FontSize="13" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- SECTION 2: SUPERVISOR PERSONALITY -->
                                <Border Background="#18181B" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="🎭 2. AI 监督官性格与严厉度 (Supervisor Persona)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6" />
                                        <TextBlock Text="控制 Gemini 在审查日程、评估想法时的语气风格：" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,0,0,12" />

                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Name="ToneStrictRadio" GroupName="SupervisorTone" Content="严格鞭策型 (犀利毒舌/直击要害/逼迫聚焦主线)" Foreground="#F87171" FontSize="13" Margin="0,0,16,0" Cursor="Hand" />
                                            <RadioButton Name="ToneBalancedRadio" GroupName="SupervisorTone" IsChecked="True" Content="理性专业型 (高级项目总监视角/重ROI与可行性)" Foreground="#38BDF8" FontSize="13" Margin="0,0,16,0" Cursor="Hand" />
                                            <RadioButton Name="ToneEncouragingRadio" GroupName="SupervisorTone" Content="温和陪伴型 (正面激励/同理心/减压关怀)" Foreground="#34D399" FontSize="13" Cursor="Hand" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- SECTION 3: API CREDENTIALS & NETWORK -->
                                <Border Background="#18181B" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="🔑 3. API 凭据与网络代理" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12" />

                                        <TextBlock Text="Google AI Studio API Key (密钥)：" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                        <TextBox Name="ApiKeyInput" Background="#27272A" Foreground="#FAFAFA" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="12,10" FontSize="13" Margin="0,0,0,14" />

                                        <TextBlock Text="自定义 API 反代 Base URL (可选，境内网络加速时填入，如 https://api.example.com)：" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4" />
                                        <TextBox Name="BaseUrlInput" Background="#27272A" Foreground="#FAFAFA" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="12,8" FontSize="13" Text="https://generativelanguage.googleapis.com" Margin="0,0,0,6" />
                                    </StackPanel>
                                </Border>

                                <!-- Action buttons -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Name="SaveSettingsBtn" Content="💾 保存并应用配置" Background="#2563EB" Foreground="#FFFFFF" BorderThickness="0" Padding="20,11" FontWeight="SemiBold" FontSize="13" Cursor="Hand" Margin="0,0,12,0" Click="OnSaveSettingsClicked" />
                                    <Button Name="TestApiBtn" Content="⚡ 测试当前模型联通" Background="#27272A" Foreground="#FAFAFA" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Padding="18,11" FontSize="13" Cursor="Hand" Click="OnTestApiClicked" />
                                </StackPanel>

                                <TextBlock Name="SettingsStatusText" Text="" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
