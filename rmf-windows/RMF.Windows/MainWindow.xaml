                            </StackPanel>
                            <TextBox x:Name="StudyTopicCompletedHoursInput" Text="0" Background="{DynamicResource ControlBackground}" Foreground="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="8,6" FontSize="12" TextChanged="OnStudyTopicCompletedValueChanged" />
