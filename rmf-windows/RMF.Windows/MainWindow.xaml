                            <Button x:Name="QuickDetailEditBtn" Style="{StaticResource GoogleTopBtnStyle}" Width="32" Height="32" Padding="0" ToolTip="编辑日程详情" Click="OnQuickDetailEditClicked" Margin="0,0,2,0">
                                <Path Data="M 14.5,5.5 L 18.5,9.5 M 6,18 L 9.5,18 L 19,8.5 C 19.5,8 19.5,7.2 19,6.7 L 17.3,5 C 16.8,4.5 16,4.5 15.5,5 L 6,14.5 Z"
                                      Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Width="15" Height="15" Stretch="Uniform" />
                            </Button>
                            <!-- 删除日程 -->
                            <Button x:Name="QuickDetailDeleteBtn" Style="{StaticResource GoogleTopBtnStyle}" Width="32" Height="32" Padding="0" ToolTip="删除日程" Click="OnQuickDetailDeleteClicked" Margin="0,0,2,0">
                                <Path Data="M 6,7 L 18,7 M 10,7 L 10,4.5 C 10,4.2 10.2,4 10.5,4 L 13.5,4 C 13.8,4 14,4.2 14,4.5 L 14,7 M 7.5,7 L 8,19 C 8,19.5 8.5,20 9,20 L 15,20 C 15.5,20 16,19.5 16,19 L 16.5,7 M 10,11 L 10,16 M 14,11 L 14,16"
                                      Stroke="#F87171" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Width="15" Height="15" Stretch="Uniform" />
                            </Button>
                            <!-- 关闭 -->
                            <Button Style="{StaticResource GoogleModalCloseBtnStyle}" ToolTip="关闭 (Esc)" Click="OnCloseQuickDetailClicked" />
                        </StackPanel>
                    </Grid>

                    <!-- Event Title -->
                    <TextBlock x:Name="QuickDetailTitleText" Text="日程标题" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,8" />

                    <!-- Time & Date -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                        <TextBlock Text="🕒" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="QuickDetailTimeText" Text="2026年10月2日 · 09:00 - 10:30" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Linked Goal (if any) -->
                    <StackPanel x:Name="QuickDetailGoalRow" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed">
                        <TextBlock Text="🎯" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="QuickDetailGoalText" Text="关联目标: 核心战役 Q4" FontSize="12" Foreground="#60A5FA" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Definition of Done (DoD) -->
                    <Border x:Name="QuickDetailDodBorder" Background="#1E1B4B" BorderBrush="#6D28D9" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12" Visibility="Collapsed">
