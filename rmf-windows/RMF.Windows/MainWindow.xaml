                            <Button x:Name="QuickDetailDuplicateBtn" Style="{StaticResource GoogleTopBtnStyle}" Width="32" Height="32" Padding="0" ToolTip="复制日程" Click="OnQuickDetailDuplicateClicked" Margin="0,0,2,0">
                                <Path Data="M 10,7 L 19,7 C 19.5,7 20,7.5 20,8 L 20,18 C 20,18.5 19.5,19 19,19 L 10,19 C 9.5,19 9,18.5 9,18 L 9,8 C 9,7.5 9.5,7 10,7 Z M 6,10 L 6,21 C 6,21.5 6.5,22 7,22 L 16,22"
                                      Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Width="16" Height="16" Stretch="Uniform" />
                            </Button>
                            <!-- 标记完成 -->
                            <Button x:Name="QuickDetailCompleteBtn" Style="{StaticResource GoogleTopBtnStyle}" Width="32" Height="32" Padding="0" ToolTip="标记完成 / 未完成" Click="OnQuickDetailToggleStatusClicked" Margin="0,0,2,0">
                                <Path x:Name="QuickDetailCompleteIconPath" Data="M 5,12 L 10,17 L 19,7"
                                      Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Width="15" Height="15" Stretch="Uniform" />
                            </Button>
