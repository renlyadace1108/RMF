            </Border>
        </Grid>

        <!-- ================= MODAL 1: GOOGLE CALENDAR EVENT DIALOG (WITH DOD & COGNITIVE LEVEL) ================= -->
        <Grid x:Name="EventModal" Visibility="Collapsed" Background="#99000000" Grid.RowSpan="2" Panel.ZIndex="999">
            <Border Background="#28292C" BorderBrush="#5F6368" BorderThickness="1" CornerRadius="12" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <ScrollViewer MaxHeight="680" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Header with Title & Close -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" x:Name="EventModalHeaderTitle" Text="添加日程时间块" FontSize="16" FontWeight="SemiBold" Foreground="#E8EAED" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="1" Content="✕" Style="{StaticResource GoogleTopBtnStyle}" Width="28" Height="28" HorizontalAlignment="Right" Click="OnCloseEventModalClicked" ToolTip="关闭 (Esc)" />
                        </Grid>

                        <!-- Event Title Input -->
                        <TextBlock Text="日程任务标题：" FontSize="12" Foreground="#9AA0A6" Margin="0,0,0,4" />
                        <TextBox x:Name="EventTitleInput" Background="#202124" Foreground="#E8EAED" BorderBrush="#5F6368" BorderThickness="1" Padding="10,8" FontSize="14" Margin="0,0,0,12" />

                        <!-- All-Day & Recurrence Controls -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="EventIsAllDayCheck" Content="全天日程 (All-Day)" Foreground="#E8EAED" FontSize="12" VerticalAlignment="Center" Checked="OnEventIsAllDayChecked" Unchecked="OnEventIsAllDayChecked" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="🔁 重复:" FontSize="12" Foreground="#9AA0A6" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox x:Name="EventRecurrenceCombo" Background="#202124" Foreground="#FFFFFF" Padding="8,4" FontSize="11" Width="140" SelectedIndex="0">
                                    <ComboBoxItem Content="不重复" Tag="NONE" />
                                    <ComboBoxItem Content="每天" Tag="DAILY" />
                                    <ComboBoxItem Content="工作日 (周一至周五)" Tag="WEEKDAYS" />
                                    <ComboBoxItem Content="每周" Tag="WEEKLY" />
                                    <ComboBoxItem Content="每月" Tag="MONTHLY" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Date & Time Row -->
                        <Grid x:Name="EventDateTimeGrid" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.5*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#202124" BorderBrush="#3C4043" BorderThickness="1" CornerRadius="4" Padding="10,8">
                                <TextBlock x:Name="EventDateDisplayText" Text="2026年10月2日" FontSize="12" Foreground="#8AB4F8" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </Border>

                            <TextBox Grid.Column="2" x:Name="EventStartTimeInput" Background="#202124" Foreground="#E8EAED" BorderBrush="#3C4043" BorderThickness="1" Padding="8" FontSize="12" Text="09:00" HorizontalContentAlignment="Center" />
                            <TextBox Grid.Column="4" x:Name="EventEndTimeInput" Background="#202124" Foreground="#E8EAED" BorderBrush="#3C4043" BorderThickness="1" Padding="8" FontSize="12" Text="10:00" HorizontalContentAlignment="Center" />
                        </Grid>

                        <!-- 三级认知负荷类型 (WorkType) -->
                        <TextBlock Text="三级认知负荷类型 (Cognitive Load)：" FontSize="12" Foreground="#9AA0A6" Margin="0,0,0,4" />
                        <ComboBox x:Name="EventWorkTypeCombo" Background="#202124" Foreground="#FFFFFF" Padding="10,6" FontSize="12" Margin="0,0,0,12" SelectedIndex="0">
                            <ComboBoxItem Content="🧠 深度工作 (DeepWork) - 高价值/高专注" Tag="DEEP_WORK" />
                            <ComboBoxItem Content="⚡ 浅层事务 (ShallowWork) - 邮件/例会/杂务" Tag="SHALLOW_WORK" />
                            <ComboBoxItem Content="☕ 强制休息/缓冲 (Rest/Buffer) - 脑力恢复" Tag="REST_BUFFER" />
                        </ComboBox>

                        <!-- 目标层级绑定 (Parent Goal) -->
                        <TextBlock Text="关联父级战略目标 (OKR 穿透)：" FontSize="12" Foreground="#9AA0A6" Margin="0,0,0,4" />
                        <ComboBox x:Name="EventGoalCombo" Background="#202124" Foreground="#FFFFFF" Padding="10,6" FontSize="12" Margin="0,0,0,12" />

                        <!-- 验收标准 (Definition of Done) 质检门禁 -->
                        <TextBlock Text="验收标准 (Definition of Done) - 必须具备明确可检验产出：" FontSize="12" Foreground="#C084FC" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox x:Name="EventDodInput" Background="#202124" Foreground="#E8EAED" BorderBrush="#7C3AED" BorderThickness="1" Padding="10,8" FontSize="12" Margin="0,0,0,12" ToolTip="例如：完成模块X全部5个接口联调并通过自动化测试" />

                        <!-- Category Input -->
                        <TextBlock Text="分类 / 标签：" FontSize="12" Foreground="#9AA0A6" Margin="0,0,0,4" />
                        <ComboBox x:Name="EventCategoryCombo" IsEditable="True" Background="#202124" Foreground="#FFFFFF" Padding="10,6" FontSize="12" Margin="0,0,0,12" />

                        <!-- 日程来源标签 (Source Tag) -->
                        <TextBlock Text="日程来源标签 (由客户端或导入通道定义)：" FontSize="12" Foreground="#9AA0A6" Margin="0,0,0,4" />
                        <TextBox x:Name="EventSourceInput" Background="#202124" Foreground="#38BDF8" BorderBrush="#3C4043" BorderThickness="1" Padding="10,8" FontSize="12" Margin="0,0,0,12" ToolTip="例如：💻 桌面端、💻 办公机、☁️ Google日历、📁 .ics导入" />

                        <!-- Description Input -->
                        <TextBlock Text="说明或成果：" FontSize="12" Foreground="#9AA0A6" Margin="0,0,0,4" />
                        <TextBox x:Name="EventDescInput" Background="#202124" Foreground="#E8EAED" BorderBrush="#3C4043" BorderThickness="1" Padding="10,8" FontSize="12" Height="50" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,12" />

                        <!-- 日程主题色 (Color) -->
                        <TextBlock Text="日程主题色 (Color)：" FontSize="12" Foreground="#9AA0A6" Margin="0,0,0,4" />
                        <ComboBox x:Name="EventColorCombo" Background="#202124" Foreground="#FFFFFF" Padding="10,6" FontSize="12" Margin="0,0,0,12" SelectedIndex="0">
                            <ComboBoxItem Content="🔵 默认蓝 (#1A73E8)" Tag="#1A73E8" />
                            <ComboBoxItem Content="🟢 翡翠绿 (#059669)" Tag="#059669" />
                            <ComboBoxItem Content="🟣 薰衣紫 (#7C3AED)" Tag="#7C3AED" />
                            <ComboBoxItem Content="🟠 琥珀橙 (#D97706)" Tag="#D97706" />
                            <ComboBoxItem Content="🔴 玫瑰红 (#DC2626)" Tag="#DC2626" />
                            <ComboBoxItem Content="🩵 青碧色 (#0891B2)" Tag="#0891B2" />
                            <ComboBoxItem Content="🔘 炭石灰 (#4B5563)" Tag="#4B5563" />
                        </ComboBox>

                        <!-- Actuals & Tracking Row (用于复盘与 P&L) -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="实际耗时(分):" FontSize="11" Foreground="#9AA0A6" Margin="0,0,0,2" />
                                <TextBox x:Name="EventActualMinutesInput" Background="#202124" Foreground="#E8EAED" BorderBrush="#3C4043" BorderThickness="1" Padding="6" FontSize="12" Text="0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="打断损耗(分):" FontSize="11" Foreground="#9AA0A6" Margin="0,0,0,2" />
                                <TextBox x:Name="EventInterruptionMinutesInput" Background="#202124" Foreground="#E8EAED" BorderBrush="#3C4043" BorderThickness="1" Padding="6" FontSize="12" Text="0" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="状态:" FontSize="11" Foreground="#9AA0A6" Margin="0,0,0,2" />
                                <ComboBox x:Name="EventStatusCombo" Background="#202124" Foreground="#FFFFFF" Padding="6" FontSize="11" SelectedIndex="0">
                                    <ComboBoxItem Content="待进行" Tag="PENDING" />
                                    <ComboBoxItem Content="进行中" Tag="IN_PROGRESS" />
                                    <ComboBoxItem Content="已完成" Tag="COMPLETED" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Actions Bottom Row -->
                        <Grid>
                            <Button x:Name="EventDeleteBtn" Content="🗑️ 删除日程" Background="Transparent" Foreground="#EA4335" BorderThickness="0" FontSize="12" Cursor="Hand" HorizontalAlignment="Left" Click="OnDeleteEventModalClicked" Visibility="Collapsed" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="取消" Background="Transparent" Foreground="#E8EAED" BorderThickness="0" Padding="14,8" FontSize="13" Cursor="Hand" Margin="0,0,10,0" Click="OnCloseEventModalClicked" />
                                <Button x:Name="EventSaveBtn" Content="保存" Style="{StaticResource GoogleActionBtnStyle}" Padding="20,8" FontWeight="SemiBold" FontSize="13" Click="OnSaveEventModalClicked" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ================= MODAL 2: 目标创建/编辑弹窗 (GOAL MODAL) ================= -->
        <Grid x:Name="GoalModal" Visibility="Collapsed" Background="#99000000" Grid.RowSpan="2" Panel.ZIndex="999">
            <Border Background="#28292C" BorderBrush="#5F6368" BorderThickness="1" CornerRadius="12" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="GoalModalHeaderTitle" Text="🎯 创建战略层级目标" FontSize="16" FontWeight="SemiBold" Foreground="#E8EAED" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" Content="✕" Style="{StaticResource GoogleTopBtnStyle}" Width="28" Height="28" HorizontalAlignment="Right" Click="OnCloseGoalModalClicked" ToolTip="关闭 (Esc)" />
                    </Grid>

                    <TextBlock Text="目标层级 (Level)：" FontSize="12" Foreground="#9AA0A6" Margin="0,0,0,4" />
                    <ComboBox x:Name="GoalLevelCombo" Background="#202124" Foreground="#FFFFFF" Padding="10,6" FontSize="12" Margin="0,0,0,12" SelectedIndex="1" SelectionChanged="OnGoalLevelChanged">
                        <ComboBoxItem Content="🌟 长期愿景 (Vision) - 年度/战略方向" Tag="VISION" />
                        <ComboBoxItem Content="🎯 季度/月度目标 (Objective) - 核心战役" Tag="OBJECTIVE" />
                        <ComboBoxItem Content="📌 周关键任务 (KeyTask) - 关键产出" Tag="KEY_TASK" />
                    </ComboBox>

                    <TextBlock Text="目标名称：" FontSize="12" Foreground="#9AA0A6" Margin="0,0,0,4" />
                    <TextBox x:Name="GoalTitleInput" Background="#202124" Foreground="#E8EAED" BorderBrush="#5F6368" BorderThickness="1" Padding="10,8" FontSize="13" Margin="0,0,0,12" />

                    <TextBlock x:Name="GoalParentLabel" Text="父级目标：" FontSize="12" Foreground="#9AA0A6" Margin="0,0,0,4" />
                    <ComboBox x:Name="GoalParentCombo" Background="#202124" Foreground="#FFFFFF" Padding="10,6" FontSize="12" Margin="0,0,0,12" />

                    <TextBlock Text="周期 / 季度 (如 2026-Q4)：" FontSize="12" Foreground="#9AA0A6" Margin="0,0,0,4" />
                    <TextBox x:Name="GoalQuarterInput" Text="2026-Q4" Background="#202124" Foreground="#E8EAED" BorderBrush="#3C4043" BorderThickness="1" Padding="10,6" FontSize="12" Margin="0,0,0,14" />

                    <Grid>
                        <Button x:Name="GoalDeleteBtn" Content="🗑️ 删除" Background="Transparent" Foreground="#EA4335" BorderThickness="0" FontSize="12" Cursor="Hand" HorizontalAlignment="Left" Click="OnDeleteGoalClicked" Visibility="Collapsed" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="取消" Background="Transparent" Foreground="#E8EAED" BorderThickness="0" Padding="14,8" FontSize="13" Cursor="Hand" Margin="0,0,10,0" Click="OnCloseGoalModalClicked" />
                            <Button Content="保存目标" Style="{StaticResource GoogleActionBtnStyle}" Padding="18,8" FontWeight="SemiBold" FontSize="13" Click="OnSaveGoalClicked" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= MODAL 3: 待办任务创建弹窗 (BACKLOG MODAL) ================= -->
        <Grid x:Name="BacklogModal" Visibility="Collapsed" Background="#99000000" Grid.RowSpan="2" Panel.ZIndex="999">
            <Border Background="#28292C" BorderBrush="#5F6368" BorderThickness="1" CornerRadius="12" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📥 添加待办任务至敏捷池" FontSize="16" FontWeight="SemiBold" Foreground="#E8EAED" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" Content="✕" Style="{StaticResource GoogleTopBtnStyle}" Width="28" Height="28" HorizontalAlignment="Right" Click="OnCloseBacklogModalClicked" ToolTip="关闭 (Esc)" />
                    </Grid>

                    <TextBlock Text="任务名称：" FontSize="12" Foreground="#9AA0A6" Margin="0,0,0,4" />
                    <TextBox x:Name="BacklogTitleInput" Background="#202124" Foreground="#E8EAED" BorderBrush="#5F6368" BorderThickness="1" Padding="10,8" FontSize="13" Margin="0,0,0,12" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="优先级：" FontSize="11" Foreground="#9AA0A6" Margin="0,0,0,4" />
                            <ComboBox x:Name="BacklogPriorityCombo" Background="#202124" Foreground="#FFFFFF" Padding="8,6" FontSize="12" SelectedIndex="1">
                                <ComboBoxItem Content="低优先级" Tag="LOW" />
                                <ComboBoxItem Content="中等" Tag="MEDIUM" />
                                <ComboBoxItem Content="高优先级" Tag="HIGH" />
                                <ComboBoxItem Content="紧急" Tag="URGENT" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="预估耗时 (分钟)：" FontSize="11" Foreground="#9AA0A6" Margin="0,0,0,4" />
                            <TextBox x:Name="BacklogMinutesInput" Text="45" Background="#202124" Foreground="#E8EAED" BorderBrush="#3C4043" BorderThickness="1" Padding="8,6" FontSize="12" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="验收标准 (DoD) - 可检验量化标准：" FontSize="12" Foreground="#C084FC" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox x:Name="BacklogDodInput" Background="#202124" Foreground="#E8EAED" BorderBrush="#7C3AED" BorderThickness="1" Padding="8" FontSize="12" Margin="0,0,0,12" />

                    <TextBlock Text="关联战略目标 (OKR)：" FontSize="12" Foreground="#9AA0A6" Margin="0,0,0,4" />
                    <ComboBox x:Name="BacklogGoalCombo" Background="#202124" Foreground="#FFFFFF" Padding="8,6" FontSize="12" Margin="0,0,0,16" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Background="Transparent" Foreground="#E8EAED" BorderThickness="0" Padding="14,8" FontSize="13" Cursor="Hand" Margin="0,0,10,0" Click="OnCloseBacklogModalClicked" />
                        <Button Content="存入敏捷池" Style="{StaticResource GoogleActionBtnStyle}" Padding="18,8" FontWeight="SemiBold" FontSize="13" Click="OnSaveBacklogClicked" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>


        <!-- ================= MODAL 5: GOOGLE CALENDAR ICAL SYNC CONFIG DIALOG ================= -->
        <Grid x:Name="GoogleCalendarSyncModal" Visibility="Collapsed" Background="#99000000" Grid.RowSpan="2" Panel.ZIndex="999">
            <Border Background="#28292C" BorderBrush="#5F6368" BorderThickness="1" CornerRadius="12" Padding="24" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📅" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="Google Calendar 日历同步配置" FontSize="16" FontWeight="SemiBold" Foreground="#E8EAED" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Style="{StaticResource GoogleTopBtnStyle}" Width="28" Height="28" HorizontalAlignment="Right" Click="OnCloseGoogleCalendarConfigClicked" ToolTip="关闭 (Esc)" />
                    </Grid>

                    <Border Background="#202124" BorderBrush="#3C4043" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="💡 如何获取 Google Calendar 订阅地址？" FontSize="12" FontWeight="SemiBold" Foreground="#8AB4F8" Margin="0,0,0,6" />
                            <TextBlock Text="1. 在浏览器打开 Google Calendar (calendar.google.com)" FontSize="11" Foreground="#9AA0A6" Margin="0,0,0,2" />
                            <TextBlock Text="2. 在左侧「我的日历」找到你的日历，点击右侧「⋮」选择「设置与共享」" FontSize="11" Foreground="#9AA0A6" Margin="0,0,0,2" />
                            <TextBlock Text="3. 页面滚动到底部「整合日历」，复制「iCal 格式的私密地址」" FontSize="11" Foreground="#9AA0A6" Margin="0,0,0,2" />
                            <TextBlock Text="4. 将以 basic.ics 结尾的链接粘贴至下方即可自动同步：" FontSize="11" Foreground="#9AA0A6" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Google Calendar 私密 iCal 订阅地址：" FontSize="12" Foreground="#9AA0A6" Margin="0,0,0,4" />
                    <TextBox x:Name="GoogleCalendarIcsInput" Background="#202124" Foreground="#E8EAED" BorderBrush="#3C4043" BorderThickness="1" Padding="10,8" FontSize="12" Margin="0,0,0,8" />

                    <TextBlock x:Name="GoogleCalendarSyncModalStatus" Text="" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap" />

                    <Grid>
                        <Button Content="解除同步 (恢复纯本地)" Background="Transparent" Foreground="#EA4335" BorderThickness="0" Cursor="Hand" FontSize="12" HorizontalAlignment="Left" Click="OnDisconnectGoogleCalendarClicked" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="取消" Background="Transparent" Foreground="#E8EAED" BorderThickness="0" Padding="16,8" FontSize="13" Cursor="Hand" Margin="0,0,10,0" Click="OnCloseGoogleCalendarConfigClicked" />
                            <Button x:Name="SaveGoogleCalSyncBtn" Content="💾 保存并立即同步" Style="{StaticResource GoogleActionBtnStyle}" Padding="18,8" FontWeight="SemiBold" FontSize="13" Cursor="Hand" Click="OnSaveGoogleCalendarSyncClicked" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= MODAL 6: 快速跳转指定日期 (GO TO DATE) ================= -->
        <Grid x:Name="GoToDateModal" Visibility="Collapsed" Background="#99000000" Grid.RowSpan="2" Panel.ZIndex="999">
            <Border Background="#28292C" BorderBrush="#5F6368" BorderThickness="1" CornerRadius="12" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📅" FontSize="16" Margin="0,0,8,0" />
                            <TextBlock Text="跳转到指定日期" FontSize="15" FontWeight="SemiBold" Foreground="#E8EAED" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Style="{StaticResource GoogleTopBtnStyle}" Width="28" Height="28" HorizontalAlignment="Right" Click="OnCloseGoToDateClicked" ToolTip="关闭 (Esc)" />
                    </Grid>

                    <TextBlock Text="选择目标年月日：" FontSize="11" Foreground="#9AA0A6" Margin="0,0,0,6" />
                    <DatePicker x:Name="GoToDatePicker" Background="#202124" Foreground="#E8EAED" BorderBrush="#5F6368" Margin="0,0,0,18" Padding="6" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Background="Transparent" Foreground="#E8EAED" BorderThickness="0" Padding="14,6" FontSize="12" Cursor="Hand" Margin="0,0,8,0" Click="OnCloseGoToDateClicked" />
                        <Button Content="立即跳转" Style="{StaticResource GoogleActionBtnStyle}" Padding="18,6" FontSize="12" FontWeight="SemiBold" Click="OnConfirmGoToDateClicked" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= MODAL 7: 系统与日历设置弹窗 (SETTINGS MODAL) ================= -->
        <Grid x:Name="SettingsModal" Visibility="Collapsed" Background="#99000000" Grid.RowSpan="2" Panel.ZIndex="999">
            <Border Background="#28292C" BorderBrush="#5F6368" BorderThickness="1" CornerRadius="12" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Row 0: Fixed Header (Title + Close Button) -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: Tab Navigation Bar -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 2: Tab Content (Fixed comfortable height 310px, never overflows screen) -->
                        <RowDefinition Height="310" />
                        <!-- Row 3: Fixed Footer (Status Text + Close Button) -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Fixed Header -->
                    <Border Grid.Row="0" BorderBrush="#3C4043" BorderThickness="0,0,0,1" Padding="20,16,16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚙️" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="日历同步与系统设置" FontSize="16" FontWeight="SemiBold" Foreground="#E8EAED" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕" Style="{StaticResource GoogleTopBtnStyle}" Width="28" Height="28" HorizontalAlignment="Right" Click="OnCloseSettingsModalClicked" ToolTip="关闭 (Esc)" />
                        </Grid>
                    </Border>

                    <!-- Row 1: Tab Navigation Bar -->
                    <Border Grid.Row="1" Background="#202124" BorderBrush="#3C4043" BorderThickness="0,0,0,1" Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="SettingsTabClientBtn" Content="🏷️ 客户端标识" Style="{StaticResource GoogleTopBtnStyle}" Background="#1A73E8" Foreground="#FFFFFF" Padding="12,5" FontSize="12" FontWeight="SemiBold" Click="OnSettingsTabClientClicked" Margin="0,0,8,0" />
                            <Button x:Name="SettingsTabSyncBtn" Content="📅 同步与文件" Style="{StaticResource GoogleTopBtnStyle}" Background="Transparent" Foreground="#9AA0A6" Padding="12,5" FontSize="12" FontWeight="Normal" Click="OnSettingsTabSyncClicked" Margin="0,0,8,0" />
                            <Button x:Name="SettingsTabAiBtn" Content="🧠 AI 模型与密钥" Style="{StaticResource GoogleTopBtnStyle}" Background="Transparent" Foreground="#9AA0A6" Padding="12,5" FontSize="12" FontWeight="Normal" Click="OnSettingsTabAiClicked" />
                        </StackPanel>
                    </Border>

                    <!-- Row 2: Tab Content Panels -->
                    <Grid Grid.Row="2" Margin="20,16">
                        <!-- Panel 1: 客户端标识 -->
                        <Grid x:Name="SettingsPanelClient" Visibility="Visible">
                            <StackPanel>
                                <TextBlock Text="🏷️ 本客户端来源标识标签" FontSize="13" FontWeight="Bold" Foreground="#E8EAED" Margin="0,0,0,6" />
                                <TextBlock Text="在此客户端创建的所有日程、任务将自动注入此来源标记，方便多端协同及来源溯源。" FontSize="11" Foreground="#9AA0A6" Margin="0,0,0,12" TextWrapping="Wrap" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ClientSourceTagInput" Text="💻 桌面端" Background="#202124" Foreground="#38BDF8" BorderBrush="#3C4043" BorderThickness="1" Padding="10,6" Height="34" FontSize="12" VerticalContentAlignment="Center" />
                                    <Button Grid.Column="2" Content="保存标签" Style="{StaticResource GoogleActionBtnStyle}" Padding="16,4" Height="34" FontSize="12" Click="OnSaveClientSourceTagClicked" />
                                </Grid>
                                <TextBlock x:Name="ClientSourceTagStatusText" Text="" FontSize="11" Foreground="#10B981" Margin="0,0,0,16" />

                                <Border Background="#202124" BorderBrush="#3C4043" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="💡 效果预览" FontSize="11" FontWeight="SemiBold" Foreground="#8AB4F8" Margin="0,0,0,6" />
                                        <TextBlock Text="在周/日视图的日程块上将附带此标签：" FontSize="11" Foreground="#9AA0A6" Margin="0,0,0,8" />
                                        <Border Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="8,4" HorizontalAlignment="Left">
                                            <TextBlock Text="💻 桌面端 · 个人日程" FontSize="11" Foreground="#93C5FD" FontWeight="Medium" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Panel 2: 同步与文件 -->
                        <Grid x:Name="SettingsPanelSync" Visibility="Collapsed">
                            <StackPanel>
                                <Border Background="#202124" BorderBrush="#3C4043" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="📅 Google 日历订阅与多端协同" FontSize="13" FontWeight="Bold" Foreground="#E8EAED" Margin="0,0,0,6" />
                                        <TextBlock Text="支持 official iCal 私密地址无感同步，外部导入日程将标注为【Google日历】。" FontSize="11" Foreground="#9AA0A6" Margin="0,0,0,10" TextWrapping="Wrap" />
                                        <Button Content="⚙️ 配置 Google 日历订阅地址" Background="#37383B" Foreground="#8AB4F8" BorderBrush="#5F6368" BorderThickness="1" Padding="12,7" FontSize="12" Cursor="Hand" Click="OnOpenGoogleCalendarConfigClicked" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#202124" BorderBrush="#3C4043" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="📁 通用日历文件导入导出 (.ics)" FontSize="13" FontWeight="Bold" Foreground="#E8EAED" Margin="0,0,0,6" />
                                        <TextBlock Text="符合 RFC 5545 国际标准，支持与 Apple 日历、Outlook、各类手机离线互通。" FontSize="11" Foreground="#9AA0A6" Margin="0,0,0,10" TextWrapping="Wrap" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="⬆ 导出 .ics 文件" Style="{StaticResource GoogleOutlineBtnStyle}" Foreground="#8AB4F8" BorderBrush="#5F6368" Padding="8,7" FontSize="12" FontWeight="Medium" Click="OnExportIcsFileClicked" ToolTip="导出全本日历至标准 .ics 文件" />
                                            <Button Grid.Column="2" Content="⬇ 导入 .ics 文件" Style="{StaticResource GoogleOutlineBtnStyle}" Foreground="#34D399" BorderBrush="#059669" Padding="8,7" FontSize="12" FontWeight="Medium" Click="OnImportIcsFileClicked" ToolTip="从外部 .ics 文件批量导入日程" />
                                        </Grid>
                                        <TextBlock x:Name="IcsTransferStatusText" Text="" FontSize="11" Foreground="#10B981" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Panel 3: AI 模型与密钥 -->
                        <Grid x:Name="SettingsPanelAi" Visibility="Collapsed">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🧠 接入模型选择" FontSize="13" FontWeight="Bold" Foreground="#E8EAED" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" x:Name="FetchModelsBtn" Content="联网拉取模型" Background="Transparent" Foreground="#8AB4F8" BorderThickness="0" FontSize="11" HorizontalAlignment="Right" Cursor="Hand" Click="OnFetchModelsClicked" />
                                    </Grid>
                                    <TextBlock x:Name="FetchModelsStatusText" Text="" FontSize="11" Foreground="#8AB4F8" Margin="0,0,0,6" TextWrapping="Wrap" />
                                    <ComboBox x:Name="ModelSelectCombo" SelectedIndex="0" Background="#37383B" Foreground="#FFFFFF" Padding="10,6" FontSize="12" Margin="0,0,0,8" SelectionChanged="OnModelSelectionChanged">
                                        <ComboBoxItem Content="gemini-2.5-flash (推荐首选)" Tag="gemini-2.5-flash" />
                                        <ComboBoxItem Content="gemini-2.5-pro (深度推理)" Tag="gemini-2.5-pro" />
                                        <ComboBoxItem Content="gemini-2.0-flash (最新极速)" Tag="gemini-2.0-flash" />
                                        <ComboBoxItem Content="[自定义模型名称...]" Tag="custom" />
                                    </ComboBox>
                                    <StackPanel x:Name="CustomModelPanel" Visibility="Collapsed" Margin="0,0,0,8">
                                        <TextBox x:Name="CustomModelInput" Background="#37383B" Foreground="#FFFFFF" BorderBrush="#3C4043" BorderThickness="1" Padding="8" FontSize="12" />
                                    </StackPanel>

                                    <TextBlock Text="Google AI Studio API Key：" FontSize="11" Foreground="#9AA0A6" Margin="0,0,0,4" />
                                    <TextBox x:Name="ApiKeyInput" Background="#37383B" Foreground="#E8EAED" BorderBrush="#3C4043" BorderThickness="1" Padding="8" FontSize="12" Margin="0,0,0,8" />

                                    <TextBlock Text="代理 Base URL (可选)：" FontSize="11" Foreground="#9AA0A6" Margin="0,0,0,4" />
                                    <TextBox x:Name="BaseUrlInput" Text="https://generativelanguage.googleapis.com" Background="#37383B" Foreground="#E8EAED" BorderBrush="#3C4043" BorderThickness="1" Padding="8" FontSize="12" Margin="0,0,0,10" />

                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="SaveSettingsBtn" Content="💾 保存配置" Background="#1A73E8" Foreground="#FFFFFF" BorderThickness="0" Padding="14,6" FontSize="12" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0" Click="OnSaveSettingsClicked" />
                                        <Button x:Name="TestApiBtn" Content="⚡ 测试握手" Background="#37383B" Foreground="#E8EAED" BorderThickness="0" Padding="12,6" FontSize="12" Cursor="Hand" Click="OnTestApiClicked" />
                                    </StackPanel>
                                    <TextBlock x:Name="SettingsStatusText" Text="" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- Row 3: Fixed Footer -->
                    <Border Grid.Row="3" Background="#202124" BorderBrush="#3C4043" BorderThickness="0,1,0,0" Padding="20,12">
                        <Grid>
                            <TextBlock Text="设置自动保存至本地配置" FontSize="11" Foreground="#71717A" VerticalAlignment="Center" />
                            <Button Content="关闭" Style="{StaticResource GoogleActionBtnStyle}" HorizontalAlignment="Right" Padding="20,6" FontSize="12" FontWeight="SemiBold" Click="OnCloseSettingsModalClicked" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
