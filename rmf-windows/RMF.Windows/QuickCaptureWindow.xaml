<Window x:Class="RMF.Windows.QuickCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RMF 全局极速闪念捕获"
        Height="150" Width="660"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Border Background="#18191C" BorderBrush="#3B82F6" BorderThickness="1.5" CornerRadius="16" Padding="16,14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.6"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: 输入行 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="⚡" FontSize="20" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <TextBox x:Name="QuickInputBox" Grid.Column="1"
                             Background="Transparent" Foreground="#F8FAFC" BorderThickness="0"
                             FontSize="16" FontWeight="Medium" FontFamily="Segoe UI, Microsoft YaHei UI"
                             CaretBrush="#38BDF8" VerticalAlignment="Center"
                             TextChanged="OnQuickInputTextChanged" KeyDown="OnQuickInputKeyDown"/>

                    <TextBlock x:Name="PlaceholderText" Grid.Column="1"
                               Text="全局闪念捕获: 例「明早 9:00 电路实验 p:高 d:45m #专业课」"
                               FontSize="14" Foreground="#64748B" IsHitTestVisible="False" VerticalAlignment="Center" Margin="4,0,0,0"/>

                    <Border Grid.Column="2" Background="#26334D" CornerRadius="6" Padding="6,3" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="↵ 回车入库" FontSize="11" Foreground="#94A3B8"/>
                    </Border>

                    <!-- Close Button (vector Path, unclipped, accessible) -->
                    <Button Grid.Column="3" x:Name="CloseQuickCaptureBtn"
                            Width="28" Height="28" Padding="0" Cursor="Hand" Background="Transparent" BorderThickness="0"
                            VerticalAlignment="Center" ToolTip="关闭闪念窗口 (Esc)" Click="OnCloseClicked">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Name="Bd" Background="{TemplateBinding Background}" CornerRadius="14" Width="28" Height="28">
                                    <Path Data="M 8.5,8.5 L 19.5,19.5 M 19.5,8.5 L 8.5,19.5"
                                          Stroke="#94A3B8"
                                          StrokeThickness="1.8"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#334155" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#1E293B" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Row 1: 实时智能语义解析预览条 -->
                <Grid Grid.Row="1" Margin="32,10,0,0">
                    <StackPanel x:Name="ParsedPillsPanel" Orientation="Horizontal">
                        <Border x:Name="TimePill" Background="#1E293B" CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                            <TextBlock x:Name="TimePillText" Text="📅 今日 09:00 - 10:00" FontSize="11" Foreground="#38BDF8"/>
                        </Border>
                        <Border x:Name="PriorityPill" Background="#3B2616" CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                            <TextBlock x:Name="PriorityPillText" Text="⚡ 中等优先级" FontSize="11" Foreground="#F59E0B"/>
                        </Border>
                        <Border x:Name="DurationPill" Background="#162E2A" CornerRadius="6" Padding="8,3" Margin="0,0,6,0">
                            <TextBlock x:Name="DurationPillText" Text="⏱️ 60 分钟" FontSize="11" Foreground="#34D399"/>
                        </Border>
                        <Border x:Name="TagPill" Background="#2E1B3D" CornerRadius="6" Padding="8,3" Margin="0,0,6,0" Visibility="Collapsed">
                            <TextBlock x:Name="TagPillText" Text="#标签" FontSize="11" Foreground="#C084FC"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
